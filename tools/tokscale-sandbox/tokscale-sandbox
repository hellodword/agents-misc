#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'EOF'
Usage: tokscale-sandbox [wrapper-options] [--] [tokscale-args...]

Run tokscale offline inside an unprivileged gVisor (runsc) container with
read-only mounts scoped strictly to agent session directories and databases.

Wrapper options:
  --agent <list>       Comma-separated agents to mount:
                       agy (or antigravity-cli), codex, claude, gemini,
                       opencode, all (default: all detected on host)
  --image <tag>        Container image tag (default: tokscale-sandbox)
  --build              Build the sandbox image before running
  --tmpfs-size <size>  Size of /tmp tmpfs staging area (default: 1g)
  --memory <size>      Container memory limit (default: 2g)
  -h, --help           Show this help message and exit

Unrecognized flags and positional arguments are forwarded to tokscale.

Examples:
  tokscale-sandbox --build
  tokscale-sandbox --agent agy --since 2026-11-01 --until 2026-11-24
  tokscale-sandbox --agent codex,claude hourly --since 2026-11-24 --json
  tokscale-sandbox models --group-by session,model --since 2026-11-20
EOF
}

image="tokscale-sandbox"
do_build=0
tmpfs_size="1g"
memory_limit="2g"
requested_agents=()
tokscale_args=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --build)
      do_build=1
      shift
      ;;
    --agent)
      [[ $# -ge 2 ]] || { printf 'tokscale-sandbox: --agent requires a value\n' >&2; exit 2; }
      IFS=',' read -r -a parts <<< "$2"
      requested_agents+=("${parts[@]}")
      shift 2
      ;;
    --agent=*)
      IFS=',' read -r -a parts <<< "${1#*=}"
      requested_agents+=("${parts[@]}")
      shift
      ;;
    --image)
      [[ $# -ge 2 ]] || { printf 'tokscale-sandbox: --image requires a value\n' >&2; exit 2; }
      image="$2"
      shift 2
      ;;
    --image=*)
      image="${1#*=}"
      shift
      ;;
    --tmpfs-size)
      [[ $# -ge 2 ]] || { printf 'tokscale-sandbox: --tmpfs-size requires a value\n' >&2; exit 2; }
      tmpfs_size="$2"
      shift 2
      ;;
    --tmpfs-size=*)
      tmpfs_size="${1#*=}"
      shift
      ;;
    --memory)
      [[ $# -ge 2 ]] || { printf 'tokscale-sandbox: --memory requires a value\n' >&2; exit 2; }
      memory_limit="$2"
      shift 2
      ;;
    --memory=*)
      memory_limit="${1#*=}"
      shift
      ;;
    --)
      shift
      tokscale_args+=("$@")
      break
      ;;
    *)
      tokscale_args+=("$1")
      shift
      ;;
  esac
done

all_agents=(antigravity-cli codex claude gemini opencode)
selected_agents=()

add_unique_agent() {
  local target="$1"
  local existing
  for existing in "${selected_agents[@]}"; do
    [[ "$existing" == "$target" ]] && return 0
  done
  selected_agents+=("$target")
}

if [[ ${#requested_agents[@]} -eq 0 ]]; then
  selected_agents=("${all_agents[@]}")
else
  for raw in "${requested_agents[@]}"; do
    case "$raw" in
      all)
        for a in "${all_agents[@]}"; do
          add_unique_agent "$a"
        done
        ;;
      agy|antigravity|antigravity-cli)
        add_unique_agent "antigravity-cli"
        ;;
      codex|claude|gemini|opencode)
        add_unique_agent "$raw"
        ;;
      "")
        ;;
      *)
        printf 'tokscale-sandbox: unsupported agent "%s" (expected agy, codex, claude, gemini, opencode, or all)\n' "$raw" >&2
        exit 2
        ;;
    esac
  done
fi

if [[ ${#selected_agents[@]} -eq 0 ]]; then
  printf 'tokscale-sandbox: no agents selected\n' >&2
  exit 2
fi

if ! command -v docker >/dev/null 2>&1; then
  printf 'tokscale-sandbox: docker executable not found in PATH\n' >&2
  exit 1
fi

runtimes="$(docker info --format '{{range $k, $v := .Runtimes}}{{$k}}{{"\n"}}{{end}}' 2>/dev/null || true)"
if ! printf '%s\n' "$runtimes" | grep -Fxq 'runsc'; then
  printf 'tokscale-sandbox: required Docker runtime "runsc" (gVisor) is not registered\n' >&2
  exit 1
fi

if [[ "$do_build" -eq 1 ]]; then
  docker build -t "$image" "$script_dir"
elif ! docker image inspect "$image" >/dev/null 2>&1; then
  printf 'tokscale-sandbox: image "%s" not found; run with --build or execute: docker build -t %s %s\n' \
    "$image" "$image" "$script_dir" >&2
  exit 1
fi

mount_args=()
active_clients=()

for agent in "${selected_agents[@]}"; do
  mounted=0
  case "$agent" in
    antigravity-cli)
      if [[ -d "$HOME/.gemini/antigravity-cli/conversations" ]]; then
        mount_args+=(-v "$HOME/.gemini/antigravity-cli/conversations:/mnt/antigravity-cli/conversations:ro")
        mounted=1
      fi
      ;;
    codex)
      if [[ -d "$HOME/.codex/sessions" ]]; then
        mount_args+=(-v "$HOME/.codex/sessions:/mnt/codex/sessions:ro")
        mounted=1
      fi
      if [[ -d "$HOME/.codex/archived_sessions" ]]; then
        mount_args+=(-v "$HOME/.codex/archived_sessions:/mnt/codex/archived_sessions:ro")
        mounted=1
      fi
      ;;
    claude)
      if [[ -d "$HOME/.claude/projects" ]]; then
        mount_args+=(-v "$HOME/.claude/projects:/mnt/claude/projects:ro")
        mounted=1
      fi
      if [[ -d "$HOME/.claude/transcripts" ]]; then
        mount_args+=(-v "$HOME/.claude/transcripts:/mnt/claude/transcripts:ro")
        mounted=1
      fi
      ;;
    gemini)
      if [[ -d "$HOME/.gemini/tmp" ]]; then
        mount_args+=(-v "$HOME/.gemini/tmp:/mnt/gemini/tmp:ro")
        mounted=1
      fi
      ;;
    opencode)
      for db_name in \
        opencode.db opencode.db-wal opencode.db-shm \
        opencode-stable.db opencode-stable.db-wal opencode-stable.db-shm; do
        db_path="$HOME/.local/share/opencode/$db_name"
        if [[ -f "$db_path" ]]; then
          mount_args+=(-v "$db_path:/mnt/opencode/db/$db_name:ro")
          mounted=1
        fi
      done
      if [[ -d "$HOME/.local/share/opencode/storage/message" ]]; then
        mount_args+=(-v "$HOME/.local/share/opencode/storage/message:/mnt/opencode/storage/message:ro")
        mounted=1
      fi
      ;;
  esac

  if [[ "$mounted" -eq 1 ]]; then
    active_clients+=("$agent")
  fi
done

if [[ ${#active_clients[@]} -eq 0 ]]; then
  printf 'tokscale-sandbox: no session data found on host for selected agents (%s)\n' "${selected_agents[*]}" >&2
  exit 1
fi

printf -v clients_csv '%s,' "${active_clients[@]}"
clients_csv="${clients_csv%,}"

docker_args=(
  run --rm
  --runtime=runsc
  --network=none
  --read-only
  --cap-drop=ALL
  --security-opt=no-new-privileges
  --pids-limit=128
  --memory="$memory_limit"
  --user "$(id -u):$(id -g)"
  -e "TERM=${TERM:-xterm-256color}"
  -e "TOKSCALE_CLIENTS=$clients_csv"
  --tmpfs "/tmp:rw,noexec,nosuid,nodev,size=$tmpfs_size"
)

if [[ -t 0 && -t 1 ]]; then
  docker_args+=(-it)
else
  docker_args+=(-i)
fi

exec docker "${docker_args[@]}" "${mount_args[@]}" "$image" "${tokscale_args[@]}"
