ruff := "ruff==0.15.20"

shell:
    nix-shell -p python3 uv

test:
    nix-shell -p python3 uv --run 'uv tool run {{ruff}} check server.py test_server.py && uv run --no-project --isolated --python python3 --with-requirements server.py python -B -m unittest -v'

fmt:
    nix-shell -p python3 uv --run 'uv tool run {{ruff}} format server.py test_server.py'
