set working-directory := "../.."
set positional-arguments

# Run on the host as the controller account; foreground, shared YAML by default.
serve *args:
    #!/usr/bin/env bash
    set -euo pipefail
    vm_test_package="$(nix build --no-link --print-out-paths --no-write-lock-file .#vm-test-mcp)"
    exec "$vm_test_package/bin/vm-test-mcp" --config tools/vm-test-mcp/config.yaml "$@"

# Run on the host as an ordinary Nix account; may use the controller account.
nix-worker *args:
    #!/usr/bin/env bash
    set -euo pipefail
    vm_test_package="$(nix build --no-link --print-out-paths --no-write-lock-file .#vm-test-mcp)"
    exec "$vm_test_package/bin/vm-test-nix-worker" --config tools/vm-test-mcp/config.yaml "$@"

# Run the delegated executor in the foreground; sudo authorizes this build and config.
nix-executor *args:
    #!/usr/bin/env bash
    set -euo pipefail
    vm_test_package="$(nix build --no-link --print-out-paths --no-write-lock-file .#vm-test-mcp)"
    exec sudo -- systemd-run \
      --unit=vm-test-nix-executor.service \
      --service-type=exec --pty --wait --collect --expand-environment=no \
      --property=Delegate=yes --property=DelegateSubgroup=supervisor \
      --property=KillMode=mixed --property=TimeoutStopSec=6min \
      --property=Restart=no --property=UMask=0077 \
      -- "$vm_test_package/bin/vm-test-nix-executor" \
      --config "$PWD/tools/vm-test-mcp/config.yaml" "$@"

# Run in the container: submit the three-node KVM smoke test and wait for cleanup.
nixos-test *args:
    #!/usr/bin/env bash
    set -euo pipefail
    vm_test_package="$(nix build --no-link --print-out-paths --no-write-lock-file .#vm-test-mcp)"
    exec "$vm_test_package/bin/vm-test-submit" --config tools/vm-test-mcp/config.yaml "$@"

test:
    nix develop .#vm-test-mcp --command bash tools/vm-test-mcp/scripts/check.sh

fmt:
    nix develop .#vm-test-mcp --command gofmt -w tools/vm-test-mcp/cmd tools/vm-test-mcp/internal

build:
    nix build .#vm-test-mcp --out-link result-vm-test-mcp

# Build the services, guest supervisors and router ISO into one output directory.
build-all:
    nix build .#vm-test-all --out-link result-vm-test-all --print-out-paths

router:
    nix build .#vm-test-router

test-helper:
    nix build --no-link .#checks.x86_64-linux.vm-test-native
