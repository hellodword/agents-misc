#!/usr/bin/env python3
import argparse
import datetime
import json
import os
import re
import sqlite3
import sys
import time

DEFAULT_DB_PATH = os.path.join(
    os.path.expanduser(
        os.environ.get("AGY_METER_DIR", "~/.gemini/antigravity-cli/meter")
    ),
    "metrics.db",
)


LOCAL_TZ = datetime.datetime.now(datetime.timezone.utc).astimezone().tzinfo


def parse_time(ap, val, is_until=False):
    if not val:
        return None
    m = re.fullmatch(r"(\d+)([smhd])", val.strip())
    if m:
        unit = {"s": 1, "m": 60, "h": 3600, "d": 86400}[m.group(2)]
        return time.time() - int(m.group(1)) * unit
    for fmt in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%d %H:%M", "%Y-%m-%d"):
        try:
            dt = datetime.datetime.strptime(val, fmt).replace(tzinfo=LOCAL_TZ)
            if fmt == "%Y-%m-%d" and is_until:
                dt = dt.replace(hour=23, minute=59, second=59)
            return dt.timestamp()
        except ValueError:
            continue
    ap.error(f"unsupported time format: {val}")
    return None


def pct(vals, q):
    v = sorted(x for x in vals if x is not None)
    return v[min(len(v) - 1, round((len(v) - 1) * q))] if v else None


def fmt_num(v, digits=1):
    return f"{v:.{digits}f}" if v is not None else "--"


def fmt_ms(v):
    if v is None:
        return "--"
    return f"{v:.0f}ms" if v < 1000.0 else f"{v / 1000.0:.2f}s"


def main():
    ap = argparse.ArgumentParser(
        description="Query Antigravity CLI TTFT and TPS telemetry"
    )
    ap.add_argument(
        "view", nargs="?", default="models", choices=["models", "sessions", "tail"]
    )
    ap.add_argument("--last", help="Relative window, e.g. 1h, 24h, 7d")
    ap.add_argument("--since", help="YYYY-MM-DD [HH:MM[:SS]]")
    ap.add_argument("--until", help="YYYY-MM-DD [HH:MM[:SS]]")
    ap.add_argument("--cid", help="Filter by conversation_id prefix")
    ap.add_argument("-n", type=int, default=20, help="Rows for tail view")
    ap.add_argument(
        "--db", default=DEFAULT_DB_PATH, help="Path to SQLite metrics database"
    )
    ap.add_argument("--json", action="store_true", help="Export JSON")
    args = ap.parse_args()

    t_min = parse_time(ap, args.last) if args.last else parse_time(ap, args.since)
    t_max = parse_time(ap, args.until, is_until=True)

    db_path = os.path.expanduser(args.db)
    if not os.path.exists(db_path):
        sys.stderr.write(f"agy-perf: metrics database not found at {db_path}\n")
        sys.exit(1)

    clauses, params = [], []
    if t_min is not None:
        clauses.append("ts >= ?")
        params.append(t_min)
    if t_max is not None:
        clauses.append("ts <= ?")
        params.append(t_max)
    if args.cid:
        clauses.append("conversation_id LIKE ?")
        params.append(f"{args.cid}%")

    where_sql = ("WHERE " + " AND ".join(clauses)) if clauses else ""
    try:
        conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
        conn.row_factory = sqlite3.Row
        rows = [
            dict(r)
            for r in conn.execute(
                f"SELECT * FROM invocations {where_sql} ORDER BY ts ASC", params
            )
        ]
    except sqlite3.Error as exc:
        sys.stderr.write(f"agy-perf: database query failed: {exc}\n")
        sys.exit(1)

    if not rows:
        if args.json:
            print("[]")
        else:
            print("No matching records.")
        return

    if args.view == "tail":
        sub = rows[-args.n :]
        if args.json:
            print(json.dumps(sub, indent=2))
            return
        print(
            f"{'TIME':<19} {'CID':<9} {'MODEL':<23} {'OUT':>5} {'TTFT':>8} "
            f"{'TPS_gen':>8} {'TPS_eff':>8} {'ITL_p50':>8} {'ITL_p95':>8} {'CHKS':>5}"
        )
        print("-" * 110)
        for r in sub:
            ts_s = datetime.datetime.fromtimestamp(r["ts"], tz=LOCAL_TZ).strftime(
                "%Y-%m-%d %H:%M:%S"
            )
            gen_s = fmt_num(r["tps_gen"]) if r["tps_gen"] is not None else "batch"
            print(
                f"{ts_s:<19} {r['conversation_id'][:8]:<9} {r['model'][:23]:<23} "
                f"{r['output_tokens']:>5} {fmt_ms(r['ttft_ms']):>8} "
                f"{gen_s:>8} {fmt_num(r['tps_eff']):>8} "
                f"{fmt_ms(r['itl_p50_ms']):>8} {fmt_ms(r['itl_p95_ms']):>8} "
                f"{(r.get('sse_chunks') or 0):>5}"
            )
        return

    key_fn = (
        (lambda r: r["model"])
        if args.view == "models"
        else (lambda r: r["conversation_id"])
    )
    groups = {}
    for r in rows:
        groups.setdefault(key_fn(r), []).append(r)

    summary = []
    for k, grp in groups.items():
        tot_out = sum(x["output_tokens"] for x in grp)
        tot_llm_s = sum((x["llm_ms"] or 0.0) for x in grp) / 1000.0
        tps_eff_w = (tot_out / tot_llm_s) if tot_llm_s > 0 else None

        s_grp = [
            x
            for x in grp
            if x.get("tps_gen") is not None and (x.get("decode_ms") or 0.0) > 0
        ]
        s_out = sum(x["output_tokens"] for x in s_grp)
        s_dec_s = sum(x["decode_ms"] for x in s_grp) / 1000.0
        tps_gen_w = (s_out / s_dec_s) if s_dec_s > 0 else None

        summary.append(
            {
                "key": k,
                "calls": len(grp),
                "stream_calls": len(s_grp),
                "out_tokens": tot_out,
                "ttft_p50_ms": pct([x["ttft_ms"] for x in grp], 0.50),
                "ttft_p95_ms": pct([x["ttft_ms"] for x in grp], 0.95),
                "tps_gen_weighted": tps_gen_w,
                "tps_eff_weighted": tps_eff_w,
                "itl_p50_ms": pct([x["itl_p50_ms"] for x in grp], 0.50),
                "itl_p95_ms": pct([x["itl_p95_ms"] for x in grp], 0.95),
                "last_ts": max(x["ts"] for x in grp),
            }
        )
    summary.sort(key=lambda x: x["last_ts"], reverse=True)

    if args.json:
        print(json.dumps(summary, indent=2))
        return

    hdr = "MODEL" if args.view == "models" else "CONVERSATION_ID"
    w = 24 if args.view == "models" else 36
    print(
        f"{hdr:<{w}} {'CALLS':>5} {'OUT_TOK':>8} {'TTFT_p50':>8} {'TTFT_p95':>8} "
        f"{'TPS_gen':>8} {'TPS_eff':>8} {'ITL_p50':>8} {'ITL_p95':>8}"
    )
    print("-" * (w + 69))
    for s in summary:
        print(
            f"{s['key'][:w]:<{w}} {s['calls']:>5} {s['out_tokens']:>8} "
            f"{fmt_ms(s['ttft_p50_ms']):>8} {fmt_ms(s['ttft_p95_ms']):>8} "
            f"{fmt_num(s['tps_gen_weighted']):>8} {fmt_num(s['tps_eff_weighted']):>8} "
            f"{fmt_ms(s['itl_p50_ms']):>8} {fmt_ms(s['itl_p95_ms']):>8}"
        )


if __name__ == "__main__":
    main()
