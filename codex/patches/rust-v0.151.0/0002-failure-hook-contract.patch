+    use crate::mcp::HookMcpCall;
+    use crate::mcp::HookMcpExecutor;
+
+    struct TestMcpExecutor {
+        outputs: HashMap<String, String>,
+        delay: Duration,
+        current: AtomicUsize,
+        maximum: AtomicUsize,
+        calls: Mutex<Vec<String>>,
+    }
+
+    impl HookMcpExecutor for TestMcpExecutor {
+        fn execute(&self, call: HookMcpCall) -> BoxFuture<'_, anyhow::Result<String>> {
+            async move {
+                let current = self.current.fetch_add(1, Ordering::SeqCst) + 1;
+                self.maximum.fetch_max(current, Ordering::SeqCst);
+                self.calls
+                    .lock()
+                    .expect("lock calls")
+                    .push(call.tool.clone());
+                tokio::time::sleep(self.delay).await;
+                self.current.fetch_sub(1, Ordering::SeqCst);
+                Ok(self.outputs.get(&call.tool).cloned().unwrap_or_default())
+            }
+            .boxed()
+        }
+    }
+
+    struct PendingMcpExecutor;
+
+    impl HookMcpExecutor for PendingMcpExecutor {
+        fn execute(&self, _call: HookMcpCall) -> BoxFuture<'_, anyhow::Result<String>> {
+            std::future::pending().boxed()
+        }
+    }
+
+    struct MixedMcpExecutor {
+        outputs: HashMap<String, String>,
+        pending: HashSet<String>,
+    }
+
+    impl HookMcpExecutor for MixedMcpExecutor {
+        fn execute(&self, call: HookMcpCall) -> BoxFuture<'_, anyhow::Result<String>> {
+            async move {
+                if self.pending.contains(&call.tool) {
+                    return std::future::pending().await;
+                }
+                Ok(self.outputs.get(&call.tool).cloned().unwrap_or_default())
+            }
+            .boxed()
+        }
+    }
+
+    fn cwd() -> AbsolutePathBuf {
+        AbsolutePathBuf::current_dir().expect("current dir")
+    }
+
+    fn engine_with_executor(executor: Arc<dyn HookMcpExecutor>) -> ClaudeHooksEngine {
+        let (result_sender, _result_receiver) = async_channel::unbounded();
+        ClaudeHooksEngine::new(
+            /*enabled*/ true,
+            /*bypass_hook_trust*/ false,
+            /*config_layer_stack*/ None,
+            Vec::new(),
+            Vec::new(),
+            CommandHookRuntime::new(
+                CommandShell {
+                    program: String::new(),
+                    args: Vec::new(),
+                },
+                Arc::new(Vec::new()),
+                ThreadId::new(),
+                result_sender,
+            ),
+            executor,
+        )
+    }
+
+    fn handler(
+        event_name: HookEventName,
+        tool: impl Into<String>,
+        order: i64,
+    ) -> ConfiguredHandler {
+        ConfiguredHandler {
+            event_name,
+            matcher: None,
+            timeout_sec: 60,
+            status_message: None,
+            additional_context_limit: Default::default(),
+            source_path: cwd().join(format!("hook-{order}.json")).into(),
+            source: HookSource::User,
+            display_order: order,
+            kind: ConfiguredHandlerKind::McpTool {
+                server: "test".to_string(),
+                tool: tool.into(),
+                input: Map::new(),
+            },
+        }
+    }
+
+    fn request_error(attempt: u64) -> RequestErrorRequest {
+        RequestErrorRequest {
+            session_id: ThreadId::new(),
+            turn_id: format!("turn-{attempt}"),
+            transcript_path: None,
+            cwd: cwd(),
+            model: "gpt-test".to_string(),
+            provider: "openai".to_string(),
+            operation: ModelRequestOperation::Sampling,
+            endpoint_path: "/responses".to_string(),
+            attempt,
+            next_action: ModelRequestNextAction::Retry,
+            error: ModelRequestError {
+                category: ModelRequestErrorCategory::Transport,
+                message: "disconnected".to_string(),
+            },
+        }
+    }
+
+    fn abnormal_stop(goal_mode: bool, category: ModelRequestErrorCategory) -> AbnormalStopRequest {
+        AbnormalStopRequest {
+            session_id: ThreadId::new(),
+            turn_id: "turn-stop".to_string(),
+            transcript_path: None,
+            cwd: cwd(),
+            model: "gpt-test".to_string(),
+            provider: "openai".to_string(),
+            goal_mode,
+            approval_policy: "never".to_string(),
+            sandbox_mode: "danger-full-access".to_string(),
+            operation: ModelRequestOperation::Sampling,
+            endpoint_path: "/responses".to_string(),
+            attempt: 2,
+            next_action: ModelRequestNextAction::Stop,
+            error: ModelRequestError {
+                category,
+                message: "stopped".to_string(),
+            },
+        }
+    }
+
+    #[tokio::test]
+    async fn request_error_runs_at_most_four_handlers_concurrently() {
+        let executor = Arc::new(TestMcpExecutor {
+            outputs: HashMap::new(),
+            delay: Duration::from_millis(25),
+            current: AtomicUsize::new(0),
+            maximum: AtomicUsize::new(0),
+            calls: Mutex::new(Vec::new()),
+        });
+        let mut engine = engine_with_executor(executor.clone());
+        engine.handlers = (0..9)
+            .map(|order| handler(HookEventName::RequestError, format!("hook-{order}"), order))
+            .collect();
+
+        let outcome = run_request_error(&engine, request_error(0)).await;
+
+        assert_eq!(outcome.hook_events.len(), 9);
+        assert_eq!(executor.maximum.load(Ordering::SeqCst), 4);
+    }
+
+    #[tokio::test]
+    async fn abnormal_stop_any_true_wins_and_invalid_output_has_no_opinion() {
+        let executor = Arc::new(TestMcpExecutor {
+            outputs: HashMap::from([
+                ("false".to_string(), r#"{"suppress":false}"#.to_string()),
+                ("invalid".to_string(), r#"{"suppress":"yes"}"#.to_string()),
+                ("true".to_string(), r#"{"suppress":true}"#.to_string()),
+            ]),
+            delay: Duration::ZERO,
+            current: AtomicUsize::new(0),
+            maximum: AtomicUsize::new(0),
+            calls: Mutex::new(Vec::new()),
+        });
+        let mut engine = engine_with_executor(executor);
+        engine.handlers = vec![
+            handler(HookEventName::AbnormalStop, "false", 0),
+            handler(HookEventName::AbnormalStop, "invalid", 1),
+            handler(HookEventName::AbnormalStop, "true", 2),
+        ];
+
+        let outcome = run_abnormal_stop(
+            &engine,
+            abnormal_stop(false, ModelRequestErrorCategory::Server),
+        )
+        .await;
+
+        assert_eq!(outcome.suppress_turn_error_lifecycle, Some(true));
+        assert_eq!(outcome.hook_events.len(), 3);
+        assert!(
+            outcome
+                .hook_events
+                .iter()
+                .any(|event| event.run.status == HookRunStatus::Failed)
+        );
+    }
+
+    #[tokio::test]
+    async fn abnormal_stop_uses_goal_and_policy_default_without_opinions() {
+        let engine = engine_with_executor(Arc::new(TestMcpExecutor {
+            outputs: HashMap::new(),
+            delay: Duration::ZERO,
+            current: AtomicUsize::new(0),
+            maximum: AtomicUsize::new(0),
+            calls: Mutex::new(Vec::new()),
+        }));
+
+        assert_eq!(
+            run_abnormal_stop(
+                &engine,
+                abnormal_stop(true, ModelRequestErrorCategory::Transport)
+            )
+            .await
+            .suppress_turn_error_lifecycle,
+            Some(true)
+        );
+        assert_eq!(
+            run_abnormal_stop(
+                &engine,
+                abnormal_stop(true, ModelRequestErrorCategory::Policy)
+            )
+            .await
+            .suppress_turn_error_lifecycle,
+            Some(false)
+        );
+        assert_eq!(
+            run_abnormal_stop(
+                &engine,
+                abnormal_stop(false, ModelRequestErrorCategory::Transport)
+            )
+            .await
+            .suppress_turn_error_lifecycle,
+            Some(false)
+        );
+    }
+
+    #[tokio::test]
+    async fn abnormal_stop_group_timeout_preserves_completed_opinions_in_config_order() {
+        assert_eq!(ABNORMAL_STOP_GROUP_TIMEOUT, Duration::from_secs(30));
+        let mut engine = engine_with_executor(Arc::new(MixedMcpExecutor {
+            outputs: HashMap::from([
+                ("false".to_string(), r#"{"suppress":false}"#.to_string()),
+                ("no-opinion".to_string(), String::new()),
+                ("true".to_string(), r#"{"suppress":true}"#.to_string()),
+            ]),
+            pending: HashSet::from(["pending".to_string()]),
+        }));
+        engine.handlers = vec![
+            handler(HookEventName::AbnormalStop, "false", 0),
+            handler(HookEventName::AbnormalStop, "pending", 1),
+            handler(HookEventName::AbnormalStop, "no-opinion", 2),
+            handler(HookEventName::AbnormalStop, "true", 3),
+        ];
+
+        let outcome = run_notification(
+            &engine,
+            HookEventName::AbnormalStop,
+            "{}".to_string(),
+            cwd(),
+            Some("turn-timeout".to_string()),
+            usize::MAX,
+            Some(Duration::from_millis(10)),
+            parse_abnormal_stop_completed,
+        )
+        .await;
+
+        assert_eq!(outcome.suppress_turn_error_lifecycle, Some(true));
+        assert_eq!(outcome.hook_events.len(), 4);
+        assert_eq!(
+            outcome
+                .hook_events
+                .iter()
+                .map(|event| (event.run.display_order, event.run.status))
+                .collect::<Vec<_>>(),
+            vec![
+                (0, HookRunStatus::Completed),
+                (1, HookRunStatus::Failed),
+                (2, HookRunStatus::Completed),
+                (3, HookRunStatus::Completed),
+            ]
+        );
+        assert!(
+            outcome.hook_events[1].run.entries[0]
+                .text
+                .contains("timed out")
+        );
+    }
+
+    #[tokio::test]
+    async fn abnormal_stop_group_timeout_keeps_false_over_goal_default() {
+        let mut engine = engine_with_executor(Arc::new(MixedMcpExecutor {
+            outputs: HashMap::from([("false".to_string(), r#"{"suppress":false}"#.to_string())]),
+            pending: HashSet::from(["pending".to_string()]),
+        }));
+        engine.handlers = vec![
+            handler(HookEventName::AbnormalStop, "false", 0),
+            handler(HookEventName::AbnormalStop, "pending", 1),
+        ];
+
+        let mut outcome = run_notification(
+            &engine,
+            HookEventName::AbnormalStop,
+            "{}".to_string(),
+            cwd(),
+            Some("turn-timeout".to_string()),
+            usize::MAX,
+            Some(Duration::from_millis(10)),
+            parse_abnormal_stop_completed,
+        )
+        .await;
+        if outcome.suppress_turn_error_lifecycle.is_none() {
+            outcome.suppress_turn_error_lifecycle = Some(true);
+        }
+
+        assert_eq!(outcome.suppress_turn_error_lifecycle, Some(false));
+        assert_eq!(outcome.hook_events[0].run.status, HookRunStatus::Completed);
+        assert_eq!(outcome.hook_events[1].run.status, HookRunStatus::Failed);
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn abnormal_stop_group_timeout_without_opinion_uses_goal_policy_default() {
+        let mut engine = engine_with_executor(Arc::new(PendingMcpExecutor));
+        engine.handlers = vec![handler(HookEventName::AbnormalStop, "pending", 0)];
+
+        let outcome = run_abnormal_stop(
+            &engine,
+            abnormal_stop(true, ModelRequestErrorCategory::Transport),
+        )
+        .await;
+
+        assert_eq!(outcome.suppress_turn_error_lifecycle, Some(true));
+        assert_eq!(outcome.hook_events.len(), 1);
+        assert_eq!(outcome.hook_events[0].run.status, HookRunStatus::Failed);
+    }
+}
