+pub(crate) const REQUEST_ERROR_QUEUE_CAPACITY: usize = 64;
+const REQUEST_ERROR_HANDLER_CONCURRENCY: usize = 4;
+const ABNORMAL_STOP_GROUP_TIMEOUT: Duration = Duration::from_secs(30);
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, JsonSchema)]
+#[serde(rename_all = "camelCase")]
+pub enum ModelRequestOperation {
+    Sampling,
+    LocalCompact,
+    RemoteCompact,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, JsonSchema)]
+#[serde(rename_all = "camelCase")]
+pub enum ModelRequestNextAction {
+    Retry,
+    Fallback,
+    Stop,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, JsonSchema)]
+#[serde(rename_all = "camelCase")]
+pub enum ModelRequestErrorCategory {
+    Transport,
+    Timeout,
+    RateLimit,
+    UsageLimit,
+    ContextWindow,
+    Policy,
+    Sandbox,
+    InvalidRequest,
+    Server,
+    Internal,
+    Other,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, JsonSchema)]
+#[serde(rename_all = "camelCase")]
+pub struct ModelRequestError {
+    pub category: ModelRequestErrorCategory,
+    pub message: String,
+}
+
+#[derive(Debug, Clone)]
+pub struct RequestErrorRequest {
+    pub session_id: ThreadId,
+    pub turn_id: String,
+    pub transcript_path: Option<PathBuf>,
+    pub cwd: AbsolutePathBuf,
+    pub model: String,
+    pub provider: String,
+    pub operation: ModelRequestOperation,
+    pub endpoint_path: String,
+    pub attempt: u64,
+    pub next_action: ModelRequestNextAction,
+    pub error: ModelRequestError,
+}
+
+#[derive(Debug, Clone)]
+pub struct AbnormalStopRequest {
+    pub session_id: ThreadId,
+    pub turn_id: String,
+    pub transcript_path: Option<PathBuf>,
+    pub cwd: AbsolutePathBuf,
+    pub model: String,
+    pub provider: String,
+    pub goal_mode: bool,
+    pub approval_policy: String,
+    pub sandbox_mode: String,
+    pub operation: ModelRequestOperation,
+    pub endpoint_path: String,
+    pub attempt: u64,
+    pub next_action: ModelRequestNextAction,
+    pub error: ModelRequestError,
+}
+
+#[derive(Debug, Default)]
+pub struct NotificationHookOutcome {
+    pub hook_events: Vec<HookCompletedEvent>,
+    pub suppress_turn_error_lifecycle: Option<bool>,
+}
+
+#[derive(Debug, Default)]
+struct NotificationHandlerData {
+    suppress_turn_error_lifecycle: Option<bool>,
+}
+
+pub(crate) fn preview_request_error(
+    handlers: &[ConfiguredHandler],
+    _request: &RequestErrorRequest,
+) -> Vec<HookRunSummary> {
+    preview(handlers, HookEventName::RequestError)
+}
+
+pub(crate) async fn run_request_error(
+    engine: &ClaudeHooksEngine,
+    request: RequestErrorRequest,
+) -> NotificationHookOutcome {
+    let input_json = match serde_json::to_string(&RequestErrorCommandInput {
+        session_id: request.session_id.to_string(),
+        turn_id: request.turn_id.clone(),
+        transcript_path: NullableString::from_path(request.transcript_path),
+        cwd: request.cwd.display().to_string(),
+        hook_event_name: "RequestError".to_string(),
+        model: request.model,
+        provider: request.provider,
+        operation: request.operation,
+        endpoint_path: request.endpoint_path,
+        attempt: request.attempt,
+        next_action: request.next_action,
+        error: request.error,
+    }) {
+        Ok(input_json) => input_json,
+        Err(error) => {
+            let matched = select(&engine.handlers, HookEventName::RequestError);
+            return NotificationHookOutcome {
+                hook_events: common::serialization_failure_hook_events(
+                    matched,
+                    Some(request.turn_id),
+                    format!("failed to serialize request error hook input: {error}"),
+                ),
+                suppress_turn_error_lifecycle: None,
+            };
+        }
+    };
+    run_notification(
+        engine,
+        HookEventName::RequestError,
+        input_json,
+        request.cwd,
+        Some(request.turn_id),
+        REQUEST_ERROR_HANDLER_CONCURRENCY,
+        None,
+        parse_request_error_completed,
+    )
+    .await
+}
+
+pub(crate) fn preview_abnormal_stop(
+    handlers: &[ConfiguredHandler],
+    _request: &AbnormalStopRequest,
+) -> Vec<HookRunSummary> {
+    preview(handlers, HookEventName::AbnormalStop)
+}
+
+pub(crate) async fn run_abnormal_stop(
+    engine: &ClaudeHooksEngine,
+    request: AbnormalStopRequest,
+) -> NotificationHookOutcome {
+    let default_suppress_turn_error_lifecycle =
+        request.goal_mode && request.error.category != ModelRequestErrorCategory::Policy;
+    let input_json = match serde_json::to_string(&AbnormalStopCommandInput {
+        session_id: request.session_id.to_string(),
+        turn_id: request.turn_id.clone(),
+        transcript_path: NullableString::from_path(request.transcript_path),
+        cwd: request.cwd.display().to_string(),
+        hook_event_name: "AbnormalStop".to_string(),
+        model: request.model,
+        provider: request.provider,
+        goal_mode: request.goal_mode,
+        approval_policy: request.approval_policy,
+        sandbox_mode: request.sandbox_mode,
+        reason: "requestError".to_string(),
+        operation: request.operation,
+        endpoint_path: request.endpoint_path,
+        attempt: request.attempt,
+        next_action: request.next_action,
+        error: request.error,
+    }) {
+        Ok(input_json) => input_json,
+        Err(error) => {
+            let matched = select(&engine.handlers, HookEventName::AbnormalStop);
+            return NotificationHookOutcome {
+                hook_events: common::serialization_failure_hook_events(
+                    matched,
+                    Some(request.turn_id),
+                    format!("failed to serialize abnormal stop hook input: {error}"),
+                ),
+                suppress_turn_error_lifecycle: Some(default_suppress_turn_error_lifecycle),
+            };
+        }
+    };
+    let mut outcome = run_notification(
+        engine,
+        HookEventName::AbnormalStop,
+        input_json,
+        request.cwd,
+        Some(request.turn_id),
+        usize::MAX,
+        Some(ABNORMAL_STOP_GROUP_TIMEOUT),
+        parse_abnormal_stop_completed,
+    )
+    .await;
+    if outcome.suppress_turn_error_lifecycle.is_none() {
+        outcome.suppress_turn_error_lifecycle = Some(default_suppress_turn_error_lifecycle);
+    }
+    outcome
+}
+
+fn preview(handlers: &[ConfiguredHandler], event_name: HookEventName) -> Vec<HookRunSummary> {
+    select(handlers, event_name)
+        .into_iter()
+        .map(|handler| dispatcher::running_summary(&handler))
+        .collect()
+}
+
+fn select(handlers: &[ConfiguredHandler], event_name: HookEventName) -> Vec<ConfiguredHandler> {
+    dispatcher::select_handlers(handlers, event_name, /*matcher_input*/ None)
+}
+
+async fn run_notification(
+    engine: &ClaudeHooksEngine,
+    event_name: HookEventName,
+    input_json: String,
+    cwd: AbsolutePathBuf,
+    turn_id: Option<String>,
+    max_concurrency: usize,
+    group_timeout: Option<Duration>,
+    parse: fn(
+        &ConfiguredHandler,
+        HandlerRunResult,
+        Option<String>,
+    ) -> dispatcher::ParsedHandler<NotificationHandlerData>,
+) -> NotificationHookOutcome {
+    let matched = select(&engine.handlers, event_name);
+    if matched.is_empty() {
+        return NotificationHookOutcome::default();
+    }
+
+    let execute = dispatcher::execute_handlers_bounded(
+        engine,
+        matched.clone(),
+        input_json,
+        cwd.as_path(),
+        turn_id.clone(),
+        max_concurrency,
+        group_timeout,
+        parse,
+    );
+    let results = execute.await;
+
+    let timeout_message = group_timeout.map(|duration| {
+        format!(
+            "{event_name:?} hook group timed out after {} seconds",
+            duration.as_secs_f64()
+        )
+    });
+    let completed = results
+        .iter()
+        .filter_map(|result| match result {
+            dispatcher::BoundedHandlerResult::Completed(completed) => Some(completed),
+            dispatcher::BoundedHandlerResult::GroupTimedOut(_) => None,
+        })
+        .collect::<Vec<_>>();
+
+    NotificationHookOutcome {
+        suppress_turn_error_lifecycle: if completed
+            .iter()
+            .any(|result| result.data.suppress_turn_error_lifecycle == Some(true))
+        {
+            Some(true)
+        } else if completed
+            .iter()
+            .any(|result| result.data.suppress_turn_error_lifecycle == Some(false))
+        {
+            Some(false)
+        } else {
+            None
+        },
+        hook_events: results
+            .into_iter()
+            .map(|result| match result {
+                dispatcher::BoundedHandlerResult::Completed(completed) => completed.completed,
+                dispatcher::BoundedHandlerResult::GroupTimedOut(handler) => failed_hook_event(
+                    handler,
+                    turn_id.clone(),
+                    timeout_message
+                        .clone()
+                        .unwrap_or_else(|| "hook group timed out".to_string()),
+                ),
+            })
+            .collect(),
+    }
+}
+
+pub(crate) fn request_error_dispatch_failure(
+    handlers: &[ConfiguredHandler],
+    turn_id: String,
+    message: impl Into<String>,
+) -> NotificationHookOutcome {
+    dispatch_failure(
+        select(handlers, HookEventName::RequestError),
+        Some(turn_id),
+        message.into(),
+    )
+}
+
+fn dispatch_failure(
+    handlers: Vec<ConfiguredHandler>,
+    turn_id: Option<String>,
+    message: String,
+) -> NotificationHookOutcome {
+    let completed_at = chrono::Utc::now().timestamp();
+    NotificationHookOutcome {
+        hook_events: handlers
+            .into_iter()
+            .map(|handler| {
+                failed_hook_event_at(handler, turn_id.clone(), message.clone(), completed_at)
+            })
+            .collect(),
+        suppress_turn_error_lifecycle: None,
+    }
+}
+
+fn failed_hook_event(
+    handler: ConfiguredHandler,
+    turn_id: Option<String>,
+    message: String,
+) -> HookCompletedEvent {
+    failed_hook_event_at(handler, turn_id, message, chrono::Utc::now().timestamp())
+}
+
+fn failed_hook_event_at(
+    handler: ConfiguredHandler,
+    turn_id: Option<String>,
+    message: String,
+    completed_at: i64,
+) -> HookCompletedEvent {
+    let mut run = dispatcher::running_summary(&handler);
+    run.status = HookRunStatus::Failed;
+    run.completed_at = Some(completed_at);
+    run.duration_ms = Some(0);
+    run.entries.push(HookOutputEntry {
+        kind: HookOutputEntryKind::Error,
+        text: message,
+    });
+    HookCompletedEvent { turn_id, run }
+}
+
+fn parse_request_error_completed(
+    handler: &ConfiguredHandler,
+    run_result: HandlerRunResult,
+    turn_id: Option<String>,
+) -> dispatcher::ParsedHandler<NotificationHandlerData> {
+    parse_notification_completed(
+        handler,
+        run_result,
+        turn_id,
+        "RequestError",
+        output_parser::parse_request_error,
+    )
+}
+
+fn parse_abnormal_stop_completed(
+    handler: &ConfiguredHandler,
+    run_result: HandlerRunResult,
+    turn_id: Option<String>,
+) -> dispatcher::ParsedHandler<NotificationHandlerData> {
+    parse_notification_completed(
+        handler,
+        run_result,
+        turn_id,
+        "AbnormalStop",
+        output_parser::parse_abnormal_stop,
+    )
+}
+
+fn parse_notification_completed(
+    handler: &ConfiguredHandler,
+    run_result: HandlerRunResult,
+    turn_id: Option<String>,
+    event_label: &'static str,
+    parse_output: fn(&str) -> Option<output_parser::StatelessHookOutput>,
+) -> dispatcher::ParsedHandler<NotificationHandlerData> {
+    let mut entries = Vec::new();
+    let mut status = HookRunStatus::Completed;
+    let mut data = NotificationHandlerData::default();
+
+    match run_result.error.as_deref() {
+        Some(error) => {
+            status = HookRunStatus::Failed;
+            entries.push(HookOutputEntry {
+                kind: HookOutputEntryKind::Error,
+                text: error.to_string(),
+            });
+        }
+        None => match run_result.exit_code {
+            Some(0) => {
+                let trimmed_stdout = run_result.stdout.trim();
+                if trimmed_stdout.is_empty() {
+                } else if let Some(parsed) = parse_output(&run_result.stdout) {
+                    if let Some(system_message) = parsed.universal.system_message {
+                        entries.push(HookOutputEntry {
+                            kind: HookOutputEntryKind::Warning,
+                            text: system_message,
+                        });
+                    }
+                    let _ = parsed.universal.suppress_output;
+                    let _ = parsed.universal.continue_processing;
+                    let _ = parsed.universal.stop_reason;
+                    data.suppress_turn_error_lifecycle = parsed.suppress_turn_error_lifecycle;
+                    if let Some(invalid_reason) = parsed.invalid_reason {
+                        status = HookRunStatus::Failed;
+                        entries.push(HookOutputEntry {
+                            kind: HookOutputEntryKind::Error,
+                            text: invalid_reason,
+                        });
+                    }
+                } else if output_parser::looks_like_json(&run_result.stdout) {
+                    status = HookRunStatus::Failed;
+                    entries.push(HookOutputEntry {
+                        kind: HookOutputEntryKind::Error,
+                        text: format!("hook returned invalid {event_label} hook JSON output"),
+                    });
+                }
+            }
+            Some(code) => {
+                status = HookRunStatus::Failed;
+                entries.push(HookOutputEntry {
+                    kind: HookOutputEntryKind::Error,
+                    text: common::trimmed_non_empty(&run_result.stderr)
+                        .unwrap_or_else(|| format!("hook exited with code {code}")),
+                });
+            }
+            None => {
+                status = HookRunStatus::Failed;
+                entries.push(HookOutputEntry {
+                    kind: HookOutputEntryKind::Error,
+                    text: "hook process terminated without an exit code".to_string(),
+                });
+            }
+        },
+    }
+
+    dispatcher::ParsedHandler {
+        completed: HookCompletedEvent {
+            turn_id,
+            run: dispatcher::completed_summary(handler, &run_result, status, entries),
+        },
+        data,
+        completion_order: 0,
+    }
+}
