+                    .as_array()
+                    .expect("schema required fields")
+                    .contains(&Value::String("turnId".to_string()))
+            );
+        }
+    }
+
+    #[test]
+    fn model_request_failure_schemas_expose_only_stable_camel_case_fields() {
+        let request_error: Value = serde_json::from_slice(
+            &schema_json::<RequestErrorCommandInput>()
+                .expect("serialize request error input schema"),
+        )
+        .expect("parse request error input schema");
+        let abnormal_stop: Value = serde_json::from_slice(
+            &schema_json::<AbnormalStopCommandInput>()
+                .expect("serialize abnormal stop input schema"),
+        )
+        .expect("parse abnormal stop input schema");
+
+        let request_properties = request_error["properties"]
+            .as_object()
+            .expect("request error properties");
+        for required in [
+            "sessionId",
+            "turnId",
+            "transcriptPath",
+            "cwd",
+            "hookEventName",
+            "model",
+            "provider",
+            "operation",
+            "endpointPath",
+            "attempt",
+            "nextAction",
+            "error",
+        ] {
+            assert!(
+                request_properties.contains_key(required),
+                "missing {required}"
+            );
+        }
+        for removed in [
+            "requestType",
+            "requestSubtype",
+            "retryAttempt",
+            "maxRetries",
+            "willRetry",
+            "nextRetryAttempt",
+            "errorRetryable",
+            "errorKind",
+            "errorMessage",
+            "codexErrorInfo",
+            "turn_id",
+        ] {
+            assert!(
+                !request_properties.contains_key(removed),
+                "retained {removed}"
+            );
+        }
+        assert!(request_properties.keys().all(|field| !field.contains('_')));
+
+        let abnormal_properties = abnormal_stop["properties"]
+            .as_object()
+            .expect("abnormal stop properties");
+        assert!(abnormal_properties.keys().all(|field| !field.contains('_')));
+        for removed in [
+            "requestType",
+            "requestSubtype",
+            "retryAttempt",
+            "maxRetries",
+            "errorKind",
+            "errorMessage",
+            "codexErrorInfo",
+            "turn_id",
+        ] {
+            assert!(
+                !abnormal_properties.contains_key(removed),
+                "retained {removed}"
+            );
+        }
+    }
+
+    #[test]
+    fn model_request_failure_payloads_serialize_with_stable_values() {
+        let error = ModelRequestError {
+            category: ModelRequestErrorCategory::RateLimit,
+            message: "slow down".to_string(),
+        };
+        let request_error = RequestErrorCommandInput {
+            session_id: "session-1".to_string(),
+            turn_id: "turn-1".to_string(),
+            transcript_path: NullableString::from_path(None),
+            cwd: "/tmp".to_string(),
+            hook_event_name: "RequestError".to_string(),
+            model: "gpt-test".to_string(),
+            provider: "openai".to_string(),
+            operation: ModelRequestOperation::RemoteCompact,
+            endpoint_path: "/responses/compact".to_string(),
+            attempt: 3,
+            next_action: ModelRequestNextAction::Fallback,
+            error: error.clone(),
+        };
+        assert_eq!(
+            serde_json::to_value(request_error).expect("serialize request error"),
+            json!({
+                "sessionId": "session-1",
+                "turnId": "turn-1",
+                "transcriptPath": null,
+                "cwd": "/tmp",
+                "hookEventName": "RequestError",
+                "model": "gpt-test",
+                "provider": "openai",
+                "operation": "remoteCompact",
+                "endpointPath": "/responses/compact",
+                "attempt": 3,
+                "nextAction": "fallback",
+                "error": { "category": "rateLimit", "message": "slow down" },
+            })
+        );
+
+        let abnormal_stop = AbnormalStopCommandInput {
+            session_id: "session-1".to_string(),
+            turn_id: "turn-1".to_string(),
+            transcript_path: NullableString::from_path(None),
+            cwd: "/tmp".to_string(),
+            hook_event_name: "AbnormalStop".to_string(),
+            model: "gpt-test".to_string(),
+            provider: "openai".to_string(),
+            goal_mode: true,
+            approval_policy: "never".to_string(),
+            sandbox_mode: "danger-full-access".to_string(),
+            reason: "requestError".to_string(),
+            operation: ModelRequestOperation::RemoteCompact,
+            endpoint_path: "/responses/compact".to_string(),
+            attempt: 4,
+            next_action: ModelRequestNextAction::Stop,
+            error,
+        };
+        let abnormal_stop = serde_json::to_value(abnormal_stop).expect("serialize abnormal stop");
+        assert_eq!(abnormal_stop["reason"], "requestError");
+        assert_eq!(abnormal_stop["nextAction"], "stop");
+        assert_eq!(abnormal_stop["error"]["category"], "rateLimit");
+        assert!(
+            abnormal_stop
+                .as_object()
+                .expect("object")
+                .keys()
+                .all(|key| !key.contains('_'))
+        );
     }
 
