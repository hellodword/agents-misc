+#[derive(Debug, Deserialize)]
+struct TerminalWaitControlArgs {
+    action: TerminalWaitAction,
+}
+
+pub struct TerminalWaitControlHandler;
+
+impl ToolExecutor<ToolInvocation> for TerminalWaitControlHandler {
+    fn tool_name(&self) -> ToolName {
+        ToolName::plain("terminal_wait_control")
+    }
+
+    fn spec(&self) -> ToolSpec {
+        create_terminal_wait_control_tool()
+    }
+
+    fn supports_parallel_tool_calls(&self) -> bool {
+        false
+    }
+
+    fn handle<'a>(&'a self, invocation: ToolInvocation) -> codex_tools::ToolExecutorFuture<'a>
+    where
+        ToolInvocation: 'a,
+    {
+        Box::pin(self.handle_call(invocation))
+    }
+}
+
+impl TerminalWaitControlHandler {
+    async fn handle_call(
+        &self,
+        invocation: ToolInvocation,
+    ) -> Result<Box<dyn crate::tools::context::ToolOutput>, FunctionCallError> {
+        let ToolInvocation {
+            session,
+            turn,
+            step_context,
+            cancellation_token,
+            call_id,
+            payload,
+            source,
+            ..
+        } = invocation;
+
+        let ToolPayload::Function { arguments } = payload else {
+            return Err(FunctionCallError::RespondToModel(
+                "terminal_wait_control handler received unsupported payload".to_string(),
+            ));
+        };
+        let args: TerminalWaitControlArgs = parse_arguments(&arguments)?;
+        let (code_mode_cell_id, code_mode_tool_call_id) = match source {
+            ToolCallSource::CodeMode {
+                cell_id,
+                runtime_tool_call_id,
+            } => (Some(cell_id), Some(runtime_tool_call_id)),
+            ToolCallSource::Direct | ToolCallSource::DirectPlaintextMessage => (None, None),
+        };
+        let context =
+            UnifiedExecContext::new(session.clone(), step_context, cancellation_token, call_id)
+                .with_code_mode_source(code_mode_cell_id, code_mode_tool_call_id);
+        let manager = &session.services.unified_exec_manager;
+        let response = manager
+            .terminal_wait_control(
+                &context,
+                TerminalWaitControlRequest {
+                    action: args.action,
+                    truncation_policy: turn.model_info().truncation_policy.into(),
+                    interaction_event: Some(WriteStdinInteractionEvent {
+                        session: &session,
+                        turn: &turn,
+                    }),
+                },
+            )
+            .await
+            .map_err(|err| {
+                FunctionCallError::RespondToModel(format!("terminal_wait_control failed: {err}"))
+            })?;
+
+        Ok(boxed_tool_output(response))
+    }
+}
+
+impl CoreToolRuntime for TerminalWaitControlHandler {
+    fn matches_kind(&self, payload: &ToolPayload) -> bool {
+        matches!(payload, ToolPayload::Function { .. })
+    }
+
+    fn pre_tool_use_payload(&self, _invocation: &ToolInvocation) -> Option<PreToolUsePayload> {
+        None
+    }
+
+    fn post_tool_use_payload(
+        &self,
+        invocation: &ToolInvocation,
+        result: &dyn crate::tools::context::ToolOutput,
+    ) -> Option<PostToolUsePayload> {
+        post_unified_exec_tool_use_payload(invocation, result)
+    }
+}
