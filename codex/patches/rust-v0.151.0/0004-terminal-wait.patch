+fn initial_exec_deadline(
+    start: Instant,
+    request_yield_time_ms: u64,
+    rule: Option<&TerminalWaitCommandRule>,
+) -> Instant {
+    match rule {
+        Some(rule) => checked_deadline(start, Duration::from_millis(rule.poll_interval_ms)),
+        None => checked_deadline(
+            start,
+            Duration::from_millis(clamp_yield_time(request_yield_time_ms)),
+        ),
+    }
+}
+
+fn terminal_wait_deadline(start: Instant, poll_interval_ms: u64) -> Instant {
+    checked_deadline(start, Duration::from_millis(poll_interval_ms))
+}
+
+fn checked_deadline(start: Instant, duration: Duration) -> Instant {
+    // Valid terminal-wait intervals are capped at one hour. Failing closed at
+    // the current instant also keeps other callers safe if an untrusted or
+    // synthetic duration cannot be represented by the platform clock.
+    start.checked_add(duration).unwrap_or(start)
+}
+
+fn default_write_stdin_deadline(
+    start: Instant,
+    request_yield_time_ms: u64,
+    input_is_empty: bool,
+    max_write_stdin_yield_time_ms: u64,
+) -> Instant {
+    let time_ms = request_yield_time_ms.max(MIN_YIELD_TIME_MS);
+    let yield_time_ms = if input_is_empty {
+        time_ms.clamp(MIN_EMPTY_YIELD_TIME_MS, max_write_stdin_yield_time_ms)
+    } else {
+        time_ms.min(MAX_YIELD_TIME_MS)
+    };
+    checked_deadline(start, Duration::from_millis(yield_time_ms))
+}
