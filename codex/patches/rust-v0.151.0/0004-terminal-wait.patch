+#[cfg(test)]
+mod tests {
+    use crate::config_toml::ConfigToml;
+
+    #[test]
+    fn terminal_wait_deserializes_command() {
+        let config: ConfigToml = toml::from_str(
+            r#"
+            [terminal_wait]
+
+            [[terminal_wait.commands]]
+            name = "cargo"
+            pattern = "cargo test"
+            cwd_pattern = "/repo"
+            enabled = false
+            poll_interval_ms = 60000
+            max_output_tokens = 2000
+            "#,
+        )
+        .expect("terminal_wait should parse");
+
+        let terminal_wait = config.terminal_wait.expect("terminal_wait should be set");
+        let command = &terminal_wait.commands[0];
+        assert_eq!(command.name, "cargo");
+        assert_eq!(command.pattern, "cargo test");
+        assert_eq!(command.cwd_pattern.as_deref(), Some("/repo"));
+        assert!(!command.enabled);
+        assert_eq!(command.poll_interval_ms, 60000);
+        assert_eq!(command.max_output_tokens, Some(2000));
+        assert!(!terminal_wait.has_enabled_commands());
+    }
+
+    #[test]
+    fn terminal_wait_defaults_command_to_enabled() {
+        let config: ConfigToml = toml::from_str(
+            r#"
+            [[terminal_wait.commands]]
+            name = "cargo"
+            pattern = "cargo test"
+            poll_interval_ms = 1000
+            "#,
+        )
+        .expect("terminal_wait should parse");
+
+        let terminal_wait = config.terminal_wait.expect("terminal_wait should be set");
+        assert!(terminal_wait.commands[0].enabled);
+        assert!(terminal_wait.has_enabled_commands());
+    }
+
+    #[test]
+    fn terminal_wait_rejects_invalid_regex() {
+        let err = toml::from_str::<ConfigToml>(
+            r#"
+            [[terminal_wait.commands]]
+            name = "cargo"
+            pattern = "["
+            poll_interval_ms = 1000
+            "#,
+        )
+        .expect_err("invalid regex should fail");
+
+        assert!(
+            err.to_string()
+                .contains("pattern is not a valid regex-lite pattern")
+        );
+    }
+
+    #[test]
+    fn terminal_wait_rejects_missing_or_out_of_range_poll_interval() {
+        for (toml, expected) in [
+            (
+                r#"
+                [[terminal_wait.commands]]
+                name = "cargo"
+                pattern = "cargo"
+                "#,
+                "missing field `poll_interval_ms`",
+            ),
+            (
+                r#"
+                [[terminal_wait.commands]]
+                name = "cargo"
+                pattern = "cargo"
+                poll_interval_ms = 0
+                "#,
+                "poll_interval_ms must be between 1 and 3600000",
+            ),
+            (
+                r#"
+                [[terminal_wait.commands]]
+                name = "cargo"
+                pattern = "cargo"
+                poll_interval_ms = 3600001
+                "#,
+                "poll_interval_ms must be between 1 and 3600000",
+            ),
+        ] {
+            let err = toml::from_str::<ConfigToml>(toml).expect_err("config should fail");
+            assert!(
+                err.to_string().contains(expected),
+                "expected {expected:?} in {err}"
+            );
+        }
+    }
+
+    #[test]
+    fn terminal_wait_rejects_removed_fields() {
+        for removed_field in [
+            r#"mode = "long_poll""#,
+            "wait_timeout_ms = 1000",
+            "allow_tty = true",
+        ] {
+            let toml = format!(
+                r#"
+                [[terminal_wait.commands]]
+                name = "cargo"
+                pattern = "cargo"
+                poll_interval_ms = 1000
+                {removed_field}
+                "#
+            );
+            let err = toml::from_str::<ConfigToml>(&toml).expect_err("config should fail");
+            assert!(
+                err.to_string().contains("unknown field"),
+                "expected unknown field error in {err}"
+            );
+        }
+    }
+
+    #[test]
+    fn terminal_wait_rejects_zero_output_limit() {
+        let err = toml::from_str::<ConfigToml>(
+            r#"
+            [[terminal_wait.commands]]
+            name = "cargo"
+            pattern = "cargo"
+            poll_interval_ms = 1000
+            max_output_tokens = 0
+            "#,
+        )
+        .expect_err("config should fail");
+
+        assert!(
+            err.to_string()
+                .contains("max_output_tokens must be greater than 0")
+        );
+    }
+
+    #[test]
+    fn terminal_wait_accepts_poll_interval_boundaries() {
+        for poll_interval_ms in [1, 3_600_000] {
+            let config: ConfigToml = toml::from_str(&format!(
+                r#"
+                [[terminal_wait.commands]]
+                name = "rule-{poll_interval_ms}"
+                pattern = "cargo"
+                poll_interval_ms = {poll_interval_ms}
+                "#
+            ))
+            .expect("boundary should parse");
+            assert_eq!(
+                config.terminal_wait.unwrap().commands[0].poll_interval_ms,
+                poll_interval_ms
+            );
+        }
+    }
+
+    #[test]
+    fn terminal_wait_rejects_missing_empty_and_duplicate_names_and_empty_patterns() {
+        for (toml, expected) in [
+            (
+                r#"
+                [[terminal_wait.commands]]
+                pattern = "cargo"
+                poll_interval_ms = 1
+                "#,
+                "missing field `name`",
+            ),
+            (
+                r#"
+                [[terminal_wait.commands]]
+                name = "   "
+                pattern = "cargo"
+                poll_interval_ms = 1
+                "#,
+                "terminal_wait command name must not be empty",
+            ),
+            (
+                r#"
+                [[terminal_wait.commands]]
+                name = "cargo"
+                pattern = "   "
+                poll_interval_ms = 1
+                "#,
+                "terminal_wait command pattern must not be empty",
+            ),
+            (
+                r#"
+                [[terminal_wait.commands]]
+                name = "cargo"
+                pattern = "cargo"
+                poll_interval_ms = 1
+
+                [[terminal_wait.commands]]
+                name = "cargo"
+                pattern = "next"
+                poll_interval_ms = 2
+                "#,
+                "terminal_wait command name \"cargo\" is duplicated",
+            ),
+        ] {
+            let err = toml::from_str::<ConfigToml>(toml).expect_err("config should fail");
+            assert!(
+                err.to_string().contains(expected),
+                "expected {expected:?} in {err}"
+            );
+        }
+    }
+}
