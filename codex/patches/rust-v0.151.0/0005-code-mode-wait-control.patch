+                resumed_lease_id: 0,
+                pending_decisions: HashSet::new(),
+                notify: Arc::new(Notify::new()),
+            });
+        state.active_lease_ids.insert(lease_id);
+        state.latest_lease_id = lease_id;
+        drop(states);
+        TerminalWaitLease {
+            leases: Arc::clone(self),
+            cell_id: cell_id.to_string(),
+            lease_id,
+        }
+    }
+
+    fn begin_decision(
+        self: &Arc<Self>,
+        cell_id: &str,
+        runtime_tool_call_id: &str,
+    ) -> TerminalWaitDecision {
+        let mut states = self
+            .states
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let state = states
+            .entry(cell_id.to_string())
+            .or_insert_with(|| TerminalWaitLeaseState {
+                active_lease_ids: HashSet::new(),
+                latest_lease_id: 0,
+                resumed_lease_id: 0,
+                pending_decisions: HashSet::new(),
+                notify: Arc::new(Notify::new()),
+            });
+        state
+            .pending_decisions
+            .insert(runtime_tool_call_id.to_string());
+        drop(states);
+        TerminalWaitDecision {
+            leases: Arc::clone(self),
+            cell_id: cell_id.to_string(),
+            runtime_tool_call_id: runtime_tool_call_id.to_string(),
+        }
+    }
+
+    fn resolve_decision(&self, cell_id: &str, runtime_tool_call_id: &str) {
+        let notify = {
+            let mut states = self
+                .states
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            let Some(state) = states.get_mut(cell_id) else {
+                return;
+            };
+            if !state.pending_decisions.remove(runtime_tool_call_id) {
+                return;
+            }
+            Arc::clone(&state.notify)
+        };
+        notify.notify_waiters();
+    }
+
+    fn snapshot(&self, cell_id: &str) -> TerminalWaitSnapshot {
+        let states = self
+            .states
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        TerminalWaitSnapshot {
+            lease_id: states
+                .get(cell_id)
+                .map_or(0, |state| state.resumed_lease_id),
+        }
+    }
+
+    fn classify_yield_reason(
+        &self,
+        cell_id: &str,
+        snapshot: TerminalWaitSnapshot,
+        reason: codex_code_mode::YieldReason,
+    ) -> codex_code_mode::YieldReason {
+        if reason == codex_code_mode::YieldReason::Explicit {
+            return reason;
+        }
+        let states = self
+            .states
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let has_unresumed_lease = states.get(cell_id).is_some_and(|state| {
+            state.latest_lease_id > snapshot.lease_id
+                && state.resumed_lease_id < state.latest_lease_id
+        });
+        if has_unresumed_lease {
+            codex_code_mode::YieldReason::TerminalWaitDecision
+        } else {
+            codex_code_mode::YieldReason::Timer
+        }
+    }
+
+    async fn resume_once(
+        &self,
+        cell_id: &str,
+        snapshot: TerminalWaitSnapshot,
+    ) -> Option<TerminalWaitSnapshot> {
+        loop {
+            let notify = {
+                let mut states = self
+                    .states
+                    .lock()
+                    .unwrap_or_else(std::sync::PoisonError::into_inner);
+                let Some(state) = states.get_mut(cell_id) else {
+                    return None;
+                };
+                if state.latest_lease_id <= snapshot.lease_id
+                    || state.resumed_lease_id >= state.latest_lease_id
+                {
+                    return None;
+                }
+                if state.active_lease_ids.is_empty() {
+                    state.resumed_lease_id = state.latest_lease_id;
+                    return Some(TerminalWaitSnapshot {
+                        lease_id: state.resumed_lease_id,
+                    });
+                }
+                Arc::clone(&state.notify)
+            };
+            let notified = notify.notified();
+            if self
+                .states
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .get(cell_id)
+                .is_none_or(|state| state.active_lease_ids.is_empty())
+            {
+                continue;
+            }
+            notified.await;
+        }
+    }
+
+    async fn wait_until_decided(&self, cell_id: &str) {
+        loop {
+            let notify = {
+                let states = self
+                    .states
+                    .lock()
+                    .unwrap_or_else(std::sync::PoisonError::into_inner);
+                let Some(state) = states.get(cell_id) else {
+                    return;
+                };
+                if state.pending_decisions.is_empty() {
+                    return;
+                }
+                Arc::clone(&state.notify)
+            };
+            let notified = notify.notified();
+            if self
+                .states
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .get(cell_id)
+                .is_none_or(|state| state.pending_decisions.is_empty())
+            {
+                return;
+            }
+            notified.await;
+        }
+    }
+
+    fn clear(&self, cell_id: &str) {
+        let removed = self
+            .states
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .remove(cell_id);
+        if let Some(state) = removed {
+            state.notify.notify_waiters();
+        }
+    }
+}
+
+impl Drop for TerminalWaitLease {
+    fn drop(&mut self) {
+        let notify = {
+            let mut states = self
+                .leases
+                .states
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            let Some(state) = states.get_mut(&self.cell_id) else {
+                return;
+            };
+            if !state.active_lease_ids.remove(&self.lease_id) {
+                return;
+            }
+            Arc::clone(&state.notify)
+        };
+        notify.notify_waiters();
+    }
+}
+
+impl Drop for TerminalWaitDecision {
+    fn drop(&mut self) {
+        self.leases
+            .resolve_decision(&self.cell_id, &self.runtime_tool_call_id);
+    }
+}
+
+pub(super) async fn absorb_terminal_wait_yields(
+    exec: &ExecContext,
+    mut response: RuntimeResponse,
+    yield_time_ms: u64,
+    mut snapshot: TerminalWaitSnapshot,
+) -> Result<RuntimeResponse, String> {
+    let mut buffered_items = Vec::new();
+    loop {
+        match response {
+            RuntimeResponse::Yielded {
+                cell_id,
+                mut content_items,
+                reason,
+            } => {
+                let service = &exec.session.services.code_mode_service;
+                if reason != codex_code_mode::YieldReason::Explicit {
+                    service.wait_for_terminal_wait_decisions(&cell_id).await;
+                }
+                let reason = service.classify_yield_reason(&cell_id, snapshot, reason);
+                if reason != codex_code_mode::YieldReason::TerminalWaitDecision {
+                    content_items.splice(0..0, buffered_items);
+                    return Ok(RuntimeResponse::Yielded {
+                        cell_id,
+                        content_items,
+                        reason,
+                    });
+                }
+                buffered_items.append(&mut content_items);
+                let Some(resumed_snapshot) = service
+                    .resume_terminal_wait_decision_once(&cell_id, snapshot)
+                    .await
+                else {
+                    return Ok(RuntimeResponse::Yielded {
+                        cell_id,
+                        content_items: buffered_items,
+                        reason: codex_code_mode::YieldReason::Timer,
+                    });
+                };
+                snapshot = resumed_snapshot;
+                response = service
+                    .wait(codex_code_mode::WaitRequest {
+                        cell_id,
+                        yield_time_ms,
+                    })
+                    .await?
+                    .into();
+            }
+            mut response => {
+                response_content_items_mut(&mut response).splice(0..0, buffered_items);
+                return Ok(response);
+            }
+        }
+    }
+}
+
+fn response_content_items_mut(
+    response: &mut RuntimeResponse,
+) -> &mut Vec<codex_code_mode::FunctionCallOutputContentItem> {
+    match response {
+        RuntimeResponse::Yielded { content_items, .. }
+        | RuntimeResponse::Terminated { content_items, .. }
+        | RuntimeResponse::Result { content_items, .. } => content_items,
+    }
+}
