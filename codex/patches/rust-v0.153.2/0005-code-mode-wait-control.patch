+            .states
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let has_unresumed_lease = states.get(cell_id).is_some_and(|state| {
+            state.latest_lease_id > snapshot.lease_id
+                && state.resumed_lease_id < state.latest_lease_id
+        });
