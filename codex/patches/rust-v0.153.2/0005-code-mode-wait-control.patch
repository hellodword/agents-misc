+
+impl TerminalWaitLeases {
+    fn acquire(self: &Arc<Self>, cell_id: &str) -> TerminalWaitLease {
+        let lease_id = self
+            .next_lease_id
+            .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |value| {
+                value.checked_add(1)
+            })
+            .map(|previous| {
+                previous
+                    .checked_add(1)
+                    .expect("terminal-wait lease id update must match fetch_update")
+            })
+            .expect("terminal-wait lease id space exhausted");
+        let mut states = self
+            .states
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let state = states
+            .entry(cell_id.to_string())
+            .or_insert_with(|| TerminalWaitLeaseState {
+                active_lease_ids: HashSet::new(),
+                latest_lease_id: 0,
+                resumed_lease_id: 0,
+                pending_decisions: HashSet::new(),
+                notify: Arc::new(Notify::new()),
+            });
+        state.active_lease_ids.insert(lease_id);
+        state.latest_lease_id = lease_id;
+        drop(states);
+        TerminalWaitLease {
+            leases: Arc::clone(self),
+            cell_id: cell_id.to_string(),
+            lease_id,
+        }
+    }
+
+    fn begin_decision(
+        self: &Arc<Self>,
+        cell_id: &str,
+        runtime_tool_call_id: &str,
+    ) -> TerminalWaitDecision {
+        let mut states = self
+            .states
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let state = states
+            .entry(cell_id.to_string())
+            .or_insert_with(|| TerminalWaitLeaseState {
+                active_lease_ids: HashSet::new(),
+                latest_lease_id: 0,
+                resumed_lease_id: 0,
+                pending_decisions: HashSet::new(),
+                notify: Arc::new(Notify::new()),
+            });
+        state
+            .pending_decisions
+            .insert(runtime_tool_call_id.to_string());
+        drop(states);
+        TerminalWaitDecision {
+            leases: Arc::clone(self),
+            cell_id: cell_id.to_string(),
+            runtime_tool_call_id: runtime_tool_call_id.to_string(),
+        }
+    }
+
+    fn resolve_decision(&self, cell_id: &str, runtime_tool_call_id: &str) {
+        let notify = {
+            let mut states = self
+                .states
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            let Some(state) = states.get_mut(cell_id) else {
+                return;
+            };
+            if !state.pending_decisions.remove(runtime_tool_call_id) {
+                return;
+            }
+            Arc::clone(&state.notify)
+        };
+        notify.notify_waiters();
+    }
+
+    fn snapshot(&self, cell_id: &str) -> TerminalWaitSnapshot {
+        let states = self
+            .states
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
