+}
+
+#[derive(Clone)]
+struct RequestErrorDispatcher {
+    sender: Sender<RequestErrorJob>,
+    receiver: Receiver<RequestErrorJob>,
+    worker_started: Arc<AtomicBool>,
+}
+
+impl RequestErrorDispatcher {
+    fn new() -> Self {
+        let (sender, receiver) = async_channel::bounded(REQUEST_ERROR_QUEUE_CAPACITY);
+        Self {
+            sender,
+            receiver,
+            worker_started: Arc::new(AtomicBool::new(false)),
+        }
+    }
+
+    fn enqueue(
+        &self,
+        engine: ClaudeHooksEngine,
+        request: RequestErrorRequest,
+    ) -> RequestErrorDispatch {
+        let turn_id = request.turn_id.clone();
+        let (outcome_sender, outcome_receiver) = oneshot::channel();
+        let job = RequestErrorJob {
+            request,
+            outcome_sender,
+        };
+        match self.sender.try_send(job) {
+            Ok(()) => {
+                self.ensure_worker(engine);
+                RequestErrorDispatch::Queued(outcome_receiver)
+            }
+            Err(TrySendError::Full(_)) => RequestErrorDispatch::Rejected(
+                crate::events::model_request::request_error_dispatch_failure(
+                    &engine.handlers,
+                    turn_id,
+                    format!(
+                        "RequestError hook queue is full (capacity {REQUEST_ERROR_QUEUE_CAPACITY})"
+                    ),
+                ),
+            ),
+            Err(TrySendError::Closed(_)) => RequestErrorDispatch::Rejected(
+                crate::events::model_request::request_error_dispatch_failure(
+                    &engine.handlers,
+                    turn_id,
+                    "RequestError hook queue is closed",
+                ),
+            ),
+        }
+    }
+
+    fn ensure_worker(&self, engine: ClaudeHooksEngine) {
+        if self
+            .worker_started
+            .compare_exchange(false, true, Ordering::AcqRel, Ordering::Acquire)
+            .is_err()
+        {
+            return;
+        }
+        let receiver = self.receiver.clone();
+        tokio::spawn(async move {
+            while let Ok(job) = receiver.recv().await {
+                let outcome = engine.run_request_error(job.request).await;
+                let _ = job.outcome_sender.send(outcome);
+            }
+        });
+    }
+}
+
+pub enum RequestErrorDispatch {
+    Queued(oneshot::Receiver<NotificationHookOutcome>),
+    Rejected(NotificationHookOutcome),
+}
 
