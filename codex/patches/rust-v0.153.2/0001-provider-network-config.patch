+    let defaults = merge_configured_model_providers(
+        built_in_model_providers(/*openai_base_url*/ None),
+        HashMap::new(),
+    )
+    .expect("default provider config should be valid");
+    let default_openai = defaults.get(OPENAI_PROVIDER_ID).expect("built-in OpenAI");
+    assert_eq!(default_openai.base_url, None);
+    assert_eq!(default_openai.compact_request_timeout_ms, None);
+    assert_eq!(
+        default_openai
+            .to_api_provider(Some(AuthMode::ApiKey))
+            .expect("default API-key provider")
+            .url_for_path("responses"),
+        "https://api.openai.com/v1/responses"
+    );
+    assert_eq!(
+        default_openai
+            .to_api_provider(Some(AuthMode::Chatgpt))
+            .expect("default ChatGPT provider")
+            .url_for_path("responses/compact"),
+        format!("{CHATGPT_CODEX_BASE_URL}/responses/compact")
+    );
+
+    let top_level = "https://top-level.example/v1";
+    let top_level_providers = merge_configured_model_providers(
+        built_in_model_providers(Some(top_level.to_string())),
+        HashMap::new(),
+    )
+    .expect("top-level endpoint should be valid");
+    assert_eq!(
+        top_level_providers[OPENAI_PROVIDER_ID].base_url.as_deref(),
+        Some(top_level)
+    );
+
+    let configured = HashMap::from([(
+        OPENAI_PROVIDER_ID.to_string(),
+        ModelProviderInfo {
+            base_url: Some("https://provider-layer.example/api".to_string()),
+            ..ModelProviderInfo::default()
+        },
+    )]);
+    let provider_override = merge_configured_model_providers(
+        built_in_model_providers(Some(top_level.to_string())),
+        configured,
+    )
+    .expect("provider endpoint should override top-level endpoint");
+    assert_eq!(
+        provider_override[OPENAI_PROVIDER_ID].base_url.as_deref(),
+        Some("https://provider-layer.example/api")
+    );
+}
