+#[test]
+fn test_openai_network_overrides_reject_invalid_timeout_and_urls() {
+    let merge_override = |provider: ModelProviderInfo| {
+        merge_configured_model_providers(
+            built_in_model_providers(/*openai_base_url*/ None),
+            HashMap::from([(OPENAI_PROVIDER_ID.to_string(), provider)]),
+        )
+    };
+
+    assert_eq!(
+        merge_override(ModelProviderInfo {
+            compact_request_timeout_ms: Some(0),
+            ..ModelProviderInfo::default()
+        }),
+        Err("OpenAI provider compact_request_timeout_ms must be at least 1".to_string())
+    );
+
+    for invalid in [
+        "",
+        "not a url",
+        "/relative/v1",
+        "file:///tmp/openai",
+        "https://example.com/v1?token=unsafe",
+    ] {
+        assert!(
+            merge_override(ModelProviderInfo {
+                base_url: Some(invalid.to_string()),
+                ..ModelProviderInfo::default()
+            })
+            .is_err(),
+            "expected invalid OpenAI base_url to fail: {invalid:?}"
+        );
+    }
+
+    assert!(
+        merge_configured_model_providers(
+            built_in_model_providers(Some("not a url".to_string())),
+            HashMap::new(),
+        )
+        .is_err(),
+        "top-level openai_base_url should use the same validation"
+    );
+
+    assert_eq!(
+        merge_override(ModelProviderInfo {
+            name: "Replacement OpenAI".to_string(),
+            ..ModelProviderInfo::default()
+        }),
+        Err(OPENAI_PROVIDER_OVERRIDE_ERROR.to_string())
+    );
+}
