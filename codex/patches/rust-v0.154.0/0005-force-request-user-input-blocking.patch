+
+async fn assert_request_user_input_policy_at_session_boundary(
+    force_blocking: Option<bool>,
+    source_is_blocking: bool,
+    expected_is_blocking: bool,
+) {
+    let (session, turn_context, events) = make_session_and_context_with_auth_and_config_and_rx(
+        CodexAuth::from_api_key("Test API Key"),
+        Vec::new(),
+        move |config| {
+            config.codex_patch.force_request_user_input_blocking = force_blocking;
+        },
+    )
+    .await;
+    *session.active_turn.lock().await = Some(ActiveTurn::default());
+
+    let request = tokio::spawn({
+        let session = Arc::clone(&session);
+        let turn_context = Arc::clone(&turn_context);
+        async move {
+            session
+                .request_user_input(
+                    turn_context.as_ref(),
+                    "policy-boundary".to_string(),
+                    RequestUserInputArgs {
+                        questions: Vec::new(),
+                        is_blocking: source_is_blocking,
+                        auto_resolution_ms: None,
+                    },
+                )
+                .await
+        }
+    });
+
+    let event = events.recv().await.expect("request user input event");
+    let EventMsg::RequestUserInput(event) = event.msg else {
+        panic!("expected request user input event");
+    };
+    assert_eq!(event.is_blocking, expected_is_blocking);
+
+    session
+        .notify_user_input_response(
+            &turn_context.sub_id,
+            RequestUserInputResponse {
+                answers: HashMap::new(),
+            },
+        )
+        .await;
+    assert!(request.await.expect("request user input task").is_some());
+}
+
+#[tokio::test]
+async fn codex_patch_force_request_user_input_blocking_is_opt_in_at_session_boundary() {
+    assert_request_user_input_policy_at_session_boundary(
+        /*force_blocking*/ None, /*source_is_blocking*/ false,
+        /*expected_is_blocking*/ false,
+    )
+    .await;
+    assert_request_user_input_policy_at_session_boundary(
+        Some(false),
+        /*source_is_blocking*/ false,
+        /*expected_is_blocking*/ false,
+    )
+    .await;
+    assert_request_user_input_policy_at_session_boundary(
+        Some(true),
+        /*source_is_blocking*/ false,
+        /*expected_is_blocking*/ true,
+    )
+    .await;
+    assert_request_user_input_policy_at_session_boundary(
+        Some(true),
+        /*source_is_blocking*/ true,
+        /*expected_is_blocking*/ true,
+    )
+    .await;
+}
