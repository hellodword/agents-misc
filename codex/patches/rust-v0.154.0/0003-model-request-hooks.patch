+    /// Await owned background work while retaining the shared async-hook limit.
+    pub(crate) async fn run_async_task<T>(&self, task: impl Future<Output = T>) -> Option<T> {
+        let concurrency_limit = Arc::clone(&self.lock_state().concurrency_limit);
+        let _permit = concurrency_limit.acquire_owned().await.ok()?;
+        Some(task.await)
+    }
+
+    /// Track session-owned work that manages its own concurrency.
+    ///
+    /// Unlike individual async hooks, an owner task must not hold one of the
+    /// async-hook permits for its whole lifetime. It still lives in the same
+    /// `JoinSet`, so session shutdown can join or abort it with the rest of the
+    /// hook runtime.
+    pub(crate) fn schedule_owned_task(
+        &self,
+        task: impl Future<Output = ()> + Send + 'static,
+    ) -> bool {
+        if tokio::runtime::Handle::try_current().is_err() {
+            return false;
+        }
+        let mut state = self.lock_state();
+        if state.concurrency_limit.is_closed() {
+            return false;
+        }
+
+        while state.tasks.try_join_next().is_some() {}
+        state.tasks.spawn(task);
+        true
+    }
+
