+        recovery_hooks_are_bounded_and_fifo(false).await;
+    }
+
+    #[tokio::test]
+    async fn codex_patch_recovery_async_hooks_are_bounded_and_fifo() {
+        recovery_hooks_are_bounded_and_fifo(true).await;
+    }
+
+    async fn recovery_hooks_are_bounded_and_fifo(async_hook: bool) {
+        let temp = tempdir().expect("temporary directory");
+        let output = temp.path().join("attempts.txt");
+        let script = temp.path().join("hook.py");
+        let release = temp.path().join("release");
+        let output_literal =
+            serde_json::to_string(&output.display().to_string()).expect("serialize output path");
+        std::fs::write(
+            &script,
+            format!(
+                "import json, sys, time\nfrom pathlib import Path\npayload = json.load(sys.stdin)\nwith open({output_literal}, 'a', encoding='utf-8') as out:\n    out.write(str(payload['attempt']) + '\\n')\nif payload['attempt'] == 1:\n    while not Path('release').exists():\n        time.sleep(0.01)\n"
+            ),
+        )
+        .expect("write hook script");
+        let cwd = AbsolutePathBuf::try_from(temp.path().to_path_buf())
+            .expect("absolute temporary directory");
+        let handler = ConfiguredHandler {
+            builtin: false,
+            event_name: HookEventName::ModelRequestRecovery,
+            matcher: Some("never-match".to_string()),
+            timeout_sec: 20,
+            status_message: None,
+            additional_context_limit: Default::default(),
+            source_path: HandlerSourcePath::Local(cwd.join("hooks.json")),
+            source: HookSource::User,
+            display_order: 0,
+            kind: ConfiguredHandlerKind::Command {
+                command: format!("python3 {}", script.display()),
+                r#async: async_hook,
+                env: HashMap::new(),
+            },
+        };
+        let (runtime, receiver) = runtime();
+        let engine = engine(runtime.clone(), vec![handler]);
+        let dispatcher = ModelRequestRecoveryDispatcher::new(&runtime);
+
+        let first = queued_start(dispatcher.enqueue(engine.clone(), request(&cwd, 1)));
+        let second = queued_start(dispatcher.enqueue(engine.clone(), request(&cwd, 2)));
+        second.start();
+        tokio::task::yield_now().await;
+        assert!(
+            !output.exists(),
+            "a later ready job must not pass the FIFO head"
+        );
+
+        first.start();
+        timeout(Duration::from_secs(10), async {
+            while !output.exists() {
+                tokio::time::sleep(Duration::from_millis(10)).await;
+            }
+        })
+        .await
+        .expect("first hook starts");
+        // Let the dispatcher run between submissions. An async handler must
+        // keep its notification's slot until the process actually completes.
+        let mut accepted = 2;
+        for attempt in 3..=256 {
+            if let ModelRequestRecoveryDispatch::Queued { start } =
+                dispatcher.enqueue(engine.clone(), request(&cwd, attempt))
+            {
+                start.start();
+                accepted += 1;
+            }
+            tokio::task::yield_now().await;
+        }
+        assert_eq!(accepted, MODEL_REQUEST_RECOVERY_QUEUE_CAPACITY);
+        assert_eq!(
+            std::fs::read_to_string(&output).expect("hook output"),
+            "1\n"
+        );
+        std::fs::write(release, "continue").expect("release first hook");
+        for _ in 0..accepted {
+            timeout(Duration::from_secs(10), receiver.recv())
+                .await
+                .expect("hook completion timeout")
+                .expect("hook completion channel");
+        }
+        assert_eq!(
+            std::fs::read_to_string(&output).expect("read hook output"),
+            (1..=accepted)
+                .map(|attempt| format!("{attempt}\n"))
+                .collect::<String>()
+        );
+
+        dispatcher.shutdown().await;
+        assert!(matches!(
+            dispatcher.enqueue(engine, request(&cwd, 257)),
+            ModelRequestRecoveryDispatch::Rejected { .. }
+        ));
+        runtime.shutdown().await;
+    }
+}
