+struct PendingModelRequestRecovery {
+    engine: ClaudeHooksEngine,
+    request: ModelRequestRecoveryRequest,
+    ready: oneshot::Receiver<()>,
+    // Count queued and executing notifications together, including async hooks.
+    _permit: OwnedSemaphorePermit,
