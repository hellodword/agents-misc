+
+struct ModelRequestRecoveryInner {
+    sender: mpsc::Sender<PendingModelRequestRecovery>,
+    receiver: Mutex<Option<mpsc::Receiver<PendingModelRequestRecovery>>>,
+    slots: Arc<Semaphore>,
+    shutdown: watch::Sender<bool>,
+    finished: watch::Sender<bool>,
+}
+
+#[derive(Clone)]
+struct ModelRequestRecoveryDispatcher {
+    inner: Arc<ModelRequestRecoveryInner>,
+    runtime: CommandHookRuntime,
+}
+
+impl ModelRequestRecoveryDispatcher {
+    fn new(runtime: &CommandHookRuntime) -> Self {
+        let (sender, receiver) = mpsc::channel(MODEL_REQUEST_RECOVERY_QUEUE_CAPACITY);
+        let (shutdown, _) = watch::channel(false);
+        let (finished, _) = watch::channel(false);
+        Self {
+            inner: Arc::new(ModelRequestRecoveryInner {
+                sender,
+                receiver: Mutex::new(Some(receiver)),
+                slots: Arc::new(Semaphore::new(MODEL_REQUEST_RECOVERY_QUEUE_CAPACITY)),
+                shutdown,
+                finished,
+            }),
+            runtime: runtime.clone(),
+        }
+    }
+
+    fn ensure_actor(&self) -> bool {
+        let mut receiver = self
+            .inner
+            .receiver
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if *self.inner.shutdown.borrow() {
+            return false;
+        }
+        if let Some(receiver) = receiver.take() {
+            let inner = Arc::clone(&self.inner);
+            if !self.runtime.schedule_owned_task(async move {
+                Self::run_actor(inner, receiver).await;
+            }) {
+                self.inner.finished.send_replace(true);
+                self.inner.slots.close();
+                return false;
+            }
+        }
+        !self.inner.sender.is_closed()
+    }
+
+    fn enqueue(
+        &self,
+        engine: ClaudeHooksEngine,
+        request: ModelRequestRecoveryRequest,
+    ) -> ModelRequestRecoveryDispatch {
+        if !self.ensure_actor() {
+            return ModelRequestRecoveryDispatch::Rejected {
+                reason: "model request recovery hook queue is closed".to_string(),
+            };
+        }
+        let Ok(permit) = Arc::clone(&self.inner.slots).try_acquire_owned() else {
+            tracing::debug!(
+                "model request recovery hook notification dropped: queue full or closed"
+            );
+            return ModelRequestRecoveryDispatch::Rejected {
+                reason: "model request recovery hook queue is full or closed".to_string(),
+            };
+        };
+        let (start, ready) = oneshot::channel();
+        if self
+            .inner
+            .sender
+            .try_send(PendingModelRequestRecovery {
+                engine,
+                request,
+                ready,
+                _permit: permit,
+            })
+            .is_err()
+        {
+            return ModelRequestRecoveryDispatch::Rejected {
+                reason: "model request recovery hook queue is closed".to_string(),
+            };
+        }
+        ModelRequestRecoveryDispatch::Queued {
+            start: ModelRequestRecoveryStart(start),
+        }
+    }
+
+    async fn run_actor(
+        inner: Arc<ModelRequestRecoveryInner>,
+        mut receiver: mpsc::Receiver<PendingModelRequestRecovery>,
+    ) {
+        let mut shutdown = inner.shutdown.subscribe();
+        let run = async {
+            while let Some(job) = receiver.recv().await {
+                if job.ready.await.is_err() {
+                    continue;
+                }
+                match AssertUnwindSafe(job.engine.run_model_request_recovery(job.request))
+                    .catch_unwind()
+                    .await
+                {
+                    Ok(outcome) => {
+                        for completed in outcome.hook_events {
+                            job.engine.command_runtime.publish_completed(completed);
+                        }
+                    }
+                    Err(_) => tracing::warn!("model request recovery hook dispatcher panicked"),
+                }
+            }
+        };
+        tokio::select! {
+            biased;
+            _ = shutdown.wait_for(|closing| *closing) => {}
+            _ = run => {}
+        }
+        // Drop queued jobs and their permits before reporting shutdown complete.
+        drop(receiver);
+        inner.slots.close();
+        inner.finished.send_replace(true);
+    }
+
+    async fn shutdown(&self) {
+        self.inner.shutdown.send_replace(true);
+        self.inner.slots.close();
+        if self
+            .inner
+            .receiver
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .take()
+            .is_some()
+        {
+            self.inner.finished.send_replace(true);
+        }
+        let mut finished = self.inner.finished.subscribe();
+        let _ = finished.wait_for(|finished| *finished).await;
+    }
+}
+
+// Dropping an unstarted token cancels its notification; sending releases the
+// FIFO head only after Core has published the corresponding HookStarted event.
+pub struct ModelRequestRecoveryStart(oneshot::Sender<()>);
+
+impl ModelRequestRecoveryStart {
+    pub fn start(self) {
+        let _ = self.0.send(());
+    }
+}
+
+pub enum ModelRequestRecoveryDispatch {
+    Queued { start: ModelRequestRecoveryStart },
+    Rejected { reason: String },
+}
 
