+    #[tokio::test]
+    async fn codex_patch_recovery_queue_bounds_pending_notifications_without_coalescing() {
+        let cwd = AbsolutePathBuf::current_dir().expect("current directory");
+        let (runtime, _receiver) = runtime();
+        let engine = engine(runtime.clone(), Vec::new());
+        let dispatcher = ModelRequestRecoveryDispatcher::new(&runtime);
+        let mut starts = Vec::new();
+
+        for attempt in 1..=MODEL_REQUEST_RECOVERY_QUEUE_CAPACITY as u64 {
+            starts.push(queued_start(
