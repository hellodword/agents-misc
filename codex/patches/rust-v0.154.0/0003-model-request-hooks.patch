+fn model_request_error_category(error: &CodexErr) -> codex_hooks::ModelRequestErrorCategory {
+    use codex_hooks::ModelRequestErrorCategory as Category;
+
+    match error.details() {
+        CodexErrorDetails::Stream(_)
+        | CodexErrorDetails::ResponseStreamFailed(_)
+        | CodexErrorDetails::ConnectionFailed(_)
+        | CodexErrorDetails::Io(_) => Category::Transport,
+        CodexErrorDetails::Timeout | CodexErrorDetails::RequestTimeout => Category::Timeout,
+        CodexErrorDetails::UnexpectedStatus(response) => match response.status.as_u16() {
+            408 => Category::Timeout,
+            429 => Category::RateLimit,
+            500..=599 => Category::Server,
+            _ => Category::InvalidRequest,
+        },
+        CodexErrorDetails::RetryLimit(error) => match error.status.as_u16() {
+            408 => Category::Timeout,
+            429 => Category::RateLimit,
+            500..=599 => Category::Server,
+            _ => Category::Other,
+        },
+        CodexErrorDetails::RateLimitExceeded(_) => Category::RateLimit,
+        CodexErrorDetails::SessionBudgetExceeded
+        | CodexErrorDetails::UsageLimitReached(_)
+        | CodexErrorDetails::QuotaExceeded
+        | CodexErrorDetails::UsageNotIncluded => Category::UsageLimit,
+        CodexErrorDetails::ContextWindowExceeded => Category::ContextWindow,
+        CodexErrorDetails::CyberPolicy { .. }
+        | CodexErrorDetails::MisalignmentPolicyViolation { .. } => Category::Policy,
+        CodexErrorDetails::Sandbox(_) | CodexErrorDetails::LandlockSandboxExecutableNotProvided => {
+            Category::Other
+        }
+        #[cfg(target_os = "linux")]
+        CodexErrorDetails::LandlockRuleset(_) | CodexErrorDetails::LandlockPathFd(_) => {
+            Category::Other
+        }
+        CodexErrorDetails::InvalidRequest(_)
+        | CodexErrorDetails::InvalidImageRequest()
+        | CodexErrorDetails::UnsupportedOperation(_)
+        | CodexErrorDetails::RefreshTokenFailed(_)
+        | CodexErrorDetails::ToolCollision(_) => Category::InvalidRequest,
+        CodexErrorDetails::ServerOverloaded => Category::ServerOverloaded,
+        CodexErrorDetails::InternalServerError => Category::Server,
+        CodexErrorDetails::SessionConfiguredNotFirstEvent
+        | CodexErrorDetails::InternalAgentDied
+        | CodexErrorDetails::Fatal(_)
+        | CodexErrorDetails::Json(_)
+        | CodexErrorDetails::TokioJoin(_)
+        | CodexErrorDetails::EnvVar(_) => Category::Internal,
+        CodexErrorDetails::TurnAborted
+        | CodexErrorDetails::ThreadNotFound(_)
+        | CodexErrorDetails::AgentLimitReached { .. }
+        | CodexErrorDetails::Spawn
+        | CodexErrorDetails::Interrupted => Category::Other,
+    }
+}
+
+fn model_request_error_payload(error: &CodexErr) -> codex_hooks::ModelRequestError {
+    let overload = error.server_overload_info();
+    codex_hooks::ModelRequestError {
+        category: model_request_error_category(error),
+        code: overload.and_then(|info| info.code.clone()),
+        http_status: overload
+            .and_then(|info| info.http_status)
+            .or_else(|| error.http_status_code_value()),
+        message: overload
+            .map(|info| info.message.clone())
+            .unwrap_or_else(|| error.to_string()),
+    }
+}
