+pub(crate) async fn run_model_request_recovery_hooks(
+    sess: &Arc<Session>,
+    turn_context: &Arc<TurnContext>,
+    failure: ModelRequestFailure,
+    next_action: codex_hooks::ModelRequestNextAction,
+) {
+    let request = codex_hooks::ModelRequestRecoveryRequest {
+        session_id: sess.session_id().into(),
+        turn_id: turn_context.sub_id.clone(),
+        transcript_path: sess.hook_transcript_path().await,
+        #[allow(deprecated)]
+        cwd: turn_context.cwd.clone(),
+        model: turn_context.model_info().slug.clone(),
+        provider: turn_context.config.model_provider_id.clone(),
+        operation: failure.operation,
+        attempt: failure.attempt,
+        next_action,
+        error: failure.error,
+    };
+    let hooks = sess.hooks();
+    let preview_runs = hooks.preview_model_request_recovery(&request);
+    if preview_runs.is_empty() {
+        return;
+    }
+
+    match hooks.enqueue_model_request_recovery(request) {
+        codex_hooks::ModelRequestRecoveryDispatch::Queued { start } => {
+            emit_hook_started_events(sess, turn_context, preview_runs).await;
+            start.start();
+        }
+        codex_hooks::ModelRequestRecoveryDispatch::Rejected { reason } => {
+            tracing::debug!(%reason, "model request recovery hook notification was dropped");
+        }
+    }
+}
+
+pub(crate) async fn run_terminal_model_request_failure_hooks(
+    sess: &Arc<Session>,
+    turn_context: &Arc<TurnContext>,
+    failure: ModelRequestFailure,
+) {
+    let request = codex_hooks::ModelRequestFailedRequest {
+        session_id: sess.session_id().into(),
+        turn_id: turn_context.sub_id.clone(),
+        transcript_path: sess.hook_transcript_path().await,
+        #[allow(deprecated)]
+        cwd: turn_context.cwd.clone(),
+        model: turn_context.model_info().slug.clone(),
+        provider: turn_context.config.model_provider_id.clone(),
+        operation: failure.operation,
+        attempt: failure.attempt,
+        error: failure.error,
+    };
+    let hooks = sess.hooks();
+    let preview_runs = hooks.preview_model_request_failed(&request);
+    if !preview_runs.is_empty() {
+        emit_hook_started_events(sess, turn_context, preview_runs).await;
+    }
+
+    let mut outcome = hooks.run_model_request_failed(request).await;
+    if !outcome.hook_events.is_empty() {
+        emit_hook_completed_events(sess, turn_context, std::mem::take(&mut outcome.hook_events))
+            .await;
+    }
+}
