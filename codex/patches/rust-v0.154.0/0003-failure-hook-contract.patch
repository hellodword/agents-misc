+            &[
+                r#"{"systemMessage":"first"}"#,
+                r#"{"systemMessage":"second"}"#,
+            ],
+        )
+        .await;
+        assert_eq!(outcome.hook_events.len(), 2);
+        assert_eq!(outcome.hook_events[0].run.entries[0].text, "first");
+        assert_eq!(outcome.hook_events[1].run.entries[0].text, "second");
+    }
+
+    #[tokio::test]
+    async fn engine_abnormal_stop_async_suppress_is_observational_only() {
+        let (executor, _started) = executor(HashMap::new(), false);
+        let (mut engine, completed) = engine_with_executor_and_results(executor);
+        let mut async_handler = handler(HookEventName::AbnormalStop, "unused", 0);
+        async_handler.kind = ConfiguredHandlerKind::Command {
+            command: r#"printf '%s' '{"systemMessage":"async warning","suppress":true}'"#
+                .to_string(),
+            env: HashMap::new(),
+            r#async: true,
+        };
+        engine.handlers = vec![async_handler];
+
+        let outcome = run_abnormal_stop(
+            &engine,
+            abnormal_stop(false, ModelRequestErrorCategory::Policy),
+        )
+        .await;
+        assert!(!outcome.suppress);
+        assert!(outcome.hook_events.is_empty());
+        let completed = tokio::time::timeout(Duration::from_secs(5), completed.recv())
+            .await
+            .expect("async AbnormalStop completion timed out")
+            .expect("async AbnormalStop result channel closed");
+        assert_eq!(completed.run.status, HookRunStatus::Completed);
+        assert_eq!(completed.run.entries[0].text, "async warning");
+        engine.command_runtime.shutdown().await;
+    }
+
+    #[tokio::test]
+    async fn engine_abnormal_stop_runs_at_most_four_sync_handlers_concurrently() {
+        let (executor, started) = executor(HashMap::new(), true);
+        let mut engine = engine_with_executor(executor.clone());
+        engine.handlers = (0..9)
+            .map(|order| handler(HookEventName::AbnormalStop, format!("hook-{order}"), order))
+            .collect();
+        let run = tokio::spawn(async move {
+            run_abnormal_stop(
+                &engine,
+                abnormal_stop(true, ModelRequestErrorCategory::Server),
+            )
+            .await
+        });
+        for _ in 0..REQUEST_ERROR_HANDLER_CONCURRENCY {
+            tokio::time::timeout(Duration::from_secs(5), started.recv())
+                .await
+                .expect("four AbnormalStop handlers did not start")
+                .expect("handler-start channel closed");
+        }
+        assert!(started.try_recv().is_err());
+        assert_eq!(executor.maximum.load(Ordering::SeqCst), 4);
+        executor.release.add_permits(9);
+        let outcome = tokio::time::timeout(Duration::from_secs(5), run)
+            .await
+            .expect("AbnormalStop handler group timed out")
+            .expect("AbnormalStop task panicked");
+        assert_eq!(outcome.hook_events.len(), 9);
+    }
+}
