+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::session::tests::make_session_and_context_with_auth_and_config_and_rx;
+    use crate::state::ActiveTurn;
+    use codex_config::config_toml::RequestUserInputPolicy;
+    use codex_login::CodexAuth;
+    use codex_protocol::protocol::EventMsg;
+    use std::sync::Arc;
+
+    fn missing_dependency() -> HashMap<String, McpServerConfig> {
+        let dependency = SkillToolDependency {
+            r#type: "mcp".to_string(),
+            value: "calendar".to_string(),
+            description: None,
+            transport: Some("streamable_http".to_string()),
+            command: None,
+            url: Some("https://calendar.example/mcp".to_string()),
+            oauth_callback_port: None,
+        };
+        HashMap::from([(
+            dependency.value.clone(),
+            mcp_dependency_to_server_config(&dependency).expect("valid test dependency"),
+        )])
+    }
+
+    #[tokio::test]
+    async fn request_user_input_policy_preserve_source_keeps_skill_dependency_blocking() {
+        let (session, turn_context, events) = make_session_and_context_with_auth_and_config_and_rx(
+            CodexAuth::from_api_key("Test API Key"),
+            Vec::new(),
+            |config| {
+                config.request_user_input_policy = RequestUserInputPolicy::PreserveSource;
+            },
+        )
+        .await;
+        *session.active_turn.lock().await = Some(ActiveTurn::default());
+
+        let request = tokio::spawn({
+            let session = Arc::clone(&session);
+            let turn_context = Arc::clone(&turn_context);
+            async move {
+                should_install_mcp_dependencies(
+                    &session,
+                    &turn_context,
+                    &missing_dependency(),
+                    &CancellationToken::new(),
+                )
+                .await
+            }
+        });
+
+        let event = events.recv().await.expect("skill dependency prompt event");
+        let EventMsg::RequestUserInput(event) = event.msg else {
+            panic!("expected request-user-input skill dependency prompt");
+        };
+        assert!(event.is_blocking);
+        session
+            .notify_user_input_response(
+                &turn_context.sub_id,
+                RequestUserInputResponse {
+                    answers: HashMap::new(),
+                },
+            )
+            .await;
+        assert!(!request.await.expect("skill dependency prompt task"));
+    }
+}
