+
+const SERVER_OVERLOADED_CODE: &str = "server_is_overloaded";
+const SLOW_DOWN_CODE: &str = "slow_down";
+const DEFAULT_OVERLOAD_MESSAGE: &str =
+    "Selected model is at capacity. Please try a different model.";
+
+/// Parse a capacity response using machine-readable fields only.  This is
+/// shared by HTTP, SSE, and WebSocket adapters so a generic 503 never becomes
+/// an overload merely because its English message looks similar.
+pub(crate) fn parse_server_overload(
+    status: Option<StatusCode>,
+    headers: Option<&HeaderMap>,
+    payload: &Value,
+) -> Option<ServerOverloadInfo> {
+    parse_server_overload_at(status, headers, payload, Utc::now())
+}
+
+pub(crate) fn parse_server_overload_at(
+    status: Option<StatusCode>,
+    headers: Option<&HeaderMap>,
+    payload: &Value,
+    now: DateTime<Utc>,
+) -> Option<ServerOverloadInfo> {
+    if status.is_some_and(|status| status != StatusCode::SERVICE_UNAVAILABLE) {
+        return None;
+    }
+    let error = payload.get("error").unwrap_or(payload);
+    let code = error.get("code").and_then(Value::as_str)?;
+    if !matches!(code, SERVER_OVERLOADED_CODE | SLOW_DOWN_CODE) {
+        return None;
+    }
+
+    let message = error
+        .get("message")
+        .and_then(Value::as_str)
+        .filter(|message| !message.trim().is_empty())
+        .unwrap_or(DEFAULT_OVERLOAD_MESSAGE)
+        .to_string();
+    let retry_after_ms = headers
+        .and_then(|headers| retry_after_header_ms_at(headers, &now))
+        .or_else(|| retry_after_value_ms_at(error, &now))
+        .or_else(|| retry_after_value_ms_at(payload, &now));
+
+    Some(ServerOverloadInfo {
+        code: Some(code.to_string()),
+        message,
+        retry_after_ms,
+    })
+}
+
+fn retry_after_header_ms_at(headers: &HeaderMap, now: &DateTime<Utc>) -> Option<u64> {
+    headers
+        .get("retry-after")
+        .and_then(|value| value.to_str().ok())
+        .and_then(|value| parse_retry_after_at(value, now))
+}
+
+fn retry_after_value_ms_at(value: &Value, now: &DateTime<Utc>) -> Option<u64> {
+    let headers = value
+        .get("headers")
+        .and_then(Value::as_object)
+        .and_then(|headers| {
+            headers.iter().find_map(|(name, value)| {
+                if !name.eq_ignore_ascii_case("retry-after") {
+                    return None;
+                }
+                value
+                    .as_str()
+                    .map(str::to_string)
+                    .or_else(|| Some(value.to_string()))
+            })
+        });
+    headers
+        .as_deref()
+        .and_then(|value| parse_retry_after_at(value, now))
+        .or_else(|| {
+            value
+                .get("retry_after_ms")
+                .or_else(|| value.get("retryAfterMs"))
+                .and_then(value_as_millis)
+        })
+        .or_else(|| {
+            value
+                .get("retry_after")
+                .or_else(|| value.get("retryAfter"))
+                .and_then(|value| value_as_seconds(value, now))
+        })
+}
+
+fn value_as_millis(value: &Value) -> Option<u64> {
+    value
+        .as_u64()
+        .or_else(|| value.as_str()?.parse::<u64>().ok())
+}
+
+fn value_as_seconds(value: &Value, now: &DateTime<Utc>) -> Option<u64> {
+    if let Some(value) = value.as_u64() {
+        return value.checked_mul(1000);
+    }
+    if let Some(value) = value.as_f64() {
+        return seconds_as_millis(value);
+    }
+    parse_retry_after_at(value.as_str()?, now)
+}
+
+fn parse_retry_after_at(value: &str, now: &DateTime<Utc>) -> Option<u64> {
+    if let Some(value) = value.strip_suffix("ms") {
+        return value.trim().parse::<u64>().ok();
+    }
+    value
+        .trim()
+        .parse::<f64>()
+        .ok()
+        .and_then(seconds_as_millis)
+        .or_else(|| parse_imf_fixdate_at(value, now))
+}
+
+fn seconds_as_millis(value: f64) -> Option<u64> {
+    if !value.is_finite() || value < 0.0 {
+        return None;
+    }
+    let rounded_ms = (value * 1000.0).round();
+    if !rounded_ms.is_finite() || rounded_ms >= u64::MAX as f64 {
+        return Some(u64::MAX);
+    }
+    Some(rounded_ms as u64)
+}
+
+const IMF_FIXDATE_FORMAT: &str = "%a, %d %b %Y %H:%M:%S GMT";
+
+fn parse_imf_fixdate_at(value: &str, now: &DateTime<Utc>) -> Option<u64> {
+    let retry_at = NaiveDateTime::parse_from_str(value, IMF_FIXDATE_FORMAT)
+        .ok()?
+        .and_utc();
+    if retry_at.format(IMF_FIXDATE_FORMAT).to_string() != value {
+        return None;
+    }
+
+    let delay_ms = i128::from(retry_at.timestamp_millis()) - i128::from(now.timestamp_millis());
+    if delay_ms <= 0 {
+        return Some(0);
+    }
+    u64::try_from(delay_ms).ok()
+}
