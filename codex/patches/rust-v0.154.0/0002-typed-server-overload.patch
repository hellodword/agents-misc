+    #[test]
+    fn server_overload_parses_seconds_fractional_seconds_and_milliseconds() {
+        for (advice, expected_ms) in [("2", 2_000), ("2.5", 2_500), ("1250ms", 1_250)] {
+            let mut headers = HeaderMap::new();
+            headers.insert("retry-after", advice.parse().expect("valid header"));
+            let payload = json!({"error": {"code": SERVER_OVERLOADED_CODE}});
