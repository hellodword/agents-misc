+    /// The provider's machine-readable overload code, when supplied.
+    pub code: Option<String>,
+    /// HTTP status when the transport supplied one.
+    pub http_status: Option<u16>,
+    /// The provider's diagnostic message (never inferred from text).
+    pub message: String,
+    /// Server advice from `Retry-After` or the response body, in milliseconds.
+    pub retry_after_ms: Option<u64>,
+}
+
+impl ServerOverloadInfo {
+    pub fn retry_delay(&self) -> Option<Duration> {
+        self.retry_after_ms.map(Duration::from_millis)
+    }
