+            json!({"error": {"code": "Slow_Down"}}),
+            json!({"error": {"message": "server is overloaded"}}),
+        ] {
+            assert!(overload_at(Some(StatusCode::SERVICE_UNAVAILABLE), None, &payload).is_none());
+        }
+    }
+
+    #[test]
+    fn server_overload_requires_503_when_status_is_present() {
+        let payload = json!({"error": {"code": SERVER_OVERLOADED_CODE}});
+        assert!(overload_at(None, None, &payload).is_some());
+        assert!(overload_at(Some(StatusCode::SERVICE_UNAVAILABLE), None, &payload).is_some());
+        for status in [
+            StatusCode::INTERNAL_SERVER_ERROR,
+            StatusCode::TOO_MANY_REQUESTS,
+        ] {
+            assert!(overload_at(Some(status), None, &payload).is_none());
+        }
+    }
