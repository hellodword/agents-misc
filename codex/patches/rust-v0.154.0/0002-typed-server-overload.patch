+    #[test]
+    fn server_overload_accepts_only_exact_codes_at_top_level_or_nested() {
+        for code in [SERVER_OVERLOADED_CODE, SLOW_DOWN_CODE] {
+            for payload in [json!({"code": code}), json!({"error": {"code": code}})] {
+                let info = overload_at(None, None, &payload).expect("exact code should match");
+                assert_eq!(info.code.as_deref(), Some(code));
+            }
+        }
+
+        for payload in [
