+#[test]
+fn map_api_error_preserves_typed_server_overload_code_and_retry_after_header() {
+    let mut headers = HeaderMap::new();
+    headers.insert("retry-after", http::HeaderValue::from_static("2.5"));
+    let body = serde_json::json!({
+        "error": {
+            "code": "server_is_overloaded",
+            "message": "capacity is temporarily limited",
+            "retry_after_ms": 99
+        }
+    })
+    .to_string();
+    let err = map_api_error(ApiError::Transport(TransportError::Http {
+        status: http::StatusCode::SERVICE_UNAVAILABLE,
+        url: Some("http://example.com/v1/responses".to_string()),
+        headers: Some(headers),
+        body: Some(body),
+    }));
+
+    let info = err
+        .server_overload_info()
+        .expect("typed overload metadata should be retained");
+    assert_eq!(info.code.as_deref(), Some("server_is_overloaded"));
+    assert_eq!(info.message, "capacity is temporarily limited");
+    assert_eq!(info.retry_after_ms, Some(2_500));
+    assert_eq!(
+        err.retry_delay(),
+        Some(std::time::Duration::from_millis(2_500))
+    );
+    assert!(!err.is_retryable());
+}
