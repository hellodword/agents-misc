+                "code": SLOW_DOWN_CODE,
+                "message": "capacity detail",
+                "retry_after_ms": 2_000
+            },
+            "retry_after_ms": 3_000
+        });
+        let mut headers = HeaderMap::new();
+        headers.insert("retry-after", "1.25".parse().expect("valid header"));
+
+        let info = overload_at(None, Some(&headers), &payload).expect("typed overload");
+        assert_eq!(info.code.as_deref(), Some(SLOW_DOWN_CODE));
+        assert_eq!(info.message, "capacity detail");
+        assert_eq!(info.retry_after_ms, Some(1_250));
+
+        let info = overload_at(None, None, &payload).expect("typed overload");
+        assert_eq!(info.retry_after_ms, Some(2_000));
+
+        let top_level = json!({
+            "code": SLOW_DOWN_CODE,
+            "message": "top-level detail",
+            "retry_after_ms": 3_000
+        });
+        let info = overload_at(None, None, &top_level).expect("typed overload");
+        assert_eq!(info.retry_after_ms, Some(3_000));
+    }
