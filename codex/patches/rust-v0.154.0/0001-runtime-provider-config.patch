+#[test]
+fn test_merge_configured_model_providers_applies_openai_and_bedrock_overrides_together() {
+    let auth = provider_auth_for_test();
+    let configured_model_providers = std::collections::HashMap::from([
+        (
+            OPENAI_PROVIDER_ID.to_string(),
+            ModelProviderInfo {
+                base_url: Some("https://provider.example/v1".to_string()),
+                request_max_retries: Some(7),
+                compact_request_timeout_ms: NonZeroU64::new(1),
+                server_overload_policy: ServerOverloadPolicy::Bounded,
+                ..ModelProviderInfo::default()
+            },
+        ),
+        (
+            AMAZON_BEDROCK_PROVIDER_ID.to_string(),
+            ModelProviderInfo {
+                base_url: Some("https://proxy.example.com/v1".to_string()),
+                auth: Some(auth.clone()),
+                aws: Some(ModelProviderAwsAuthInfo {
+                    profile: Some("codex-bedrock".to_string()),
+                    region: Some("us-west-2".to_string()),
+                    auth_refresh: None,
+                }),
+                http_headers: Some(maplit::hashmap! {
+                    "x-example-header".to_string() => "value".into(),
+                }),
+                ..ModelProviderInfo::default()
+            },
+        ),
+    ]);
+
+    let merged = merge_configured_model_providers(
+        built_in_model_providers(/*openai_base_url*/ None),
+        configured_model_providers,
+    )
+    .expect("OpenAI and Amazon Bedrock overrides should coexist");
+
+    let openai = merged
+        .get(OPENAI_PROVIDER_ID)
+        .expect("OpenAI provider should be built in");
+    assert_eq!(openai.request_max_retries, Some(7));
+    assert_eq!(
+        openai.base_url.as_deref(),
+        Some("https://provider.example/v1")
+    );
+    assert_eq!(openai.compact_request_timeout_ms, NonZeroU64::new(1));
+    assert_eq!(openai.server_overload_policy, ServerOverloadPolicy::Bounded);
+    let api_provider = openai
+        .to_api_provider(Some(AuthMode::ApiKey))
+        .expect("OpenAI provider should produce API endpoints");
+    assert_eq!(
+        api_provider.url_for_path("responses"),
+        "https://provider.example/v1/responses"
+    );
+    assert_eq!(
+        api_provider.url_for_path("responses/compact"),
+        "https://provider.example/v1/responses/compact"
+    );
+
+    let bedrock = merged
+        .get(AMAZON_BEDROCK_PROVIDER_ID)
+        .expect("Amazon Bedrock provider should be built in");
+    assert_eq!(
+        bedrock.base_url.as_deref(),
+        Some("https://proxy.example.com/v1")
+    );
+    assert_eq!(bedrock.auth, Some(auth));
+    assert_eq!(
+        bedrock.aws,
+        Some(ModelProviderAwsAuthInfo {
+            profile: Some("codex-bedrock".to_string()),
+            region: Some("us-west-2".to_string()),
+            auth_refresh: None,
+        })
+    );
+    assert_eq!(
+        bedrock
+            .http_headers
+            .as_ref()
+            .and_then(|headers| headers.get("x-example-header"))
+            .map(|value| value.as_str()),
+        Some("value")
+    );
+}
