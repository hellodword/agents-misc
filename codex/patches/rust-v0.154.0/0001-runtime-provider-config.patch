+use crate::ModelProviderInfo;
+use http::Uri;
+
+pub(crate) const OPENAI_PROVIDER_OVERRIDE_ERROR: &str = "model_providers.openai only supports changing `base_url`, `stream_idle_timeout_ms`, \
+`stream_max_retries`, `request_max_retries`, `websocket_connect_timeout_ms`, and \
+`compact_request_timeout_ms`, and `server_overload_policy`; other non-default provider fields are not supported";
+
+pub(crate) fn validate_openai_network_config(provider: &ModelProviderInfo) -> Result<(), String> {
+    if let Some(base_url) = provider.base_url.as_deref() {
+        let uri = base_url.parse::<Uri>().map_err(|error| {
+            format!("OpenAI provider base_url `{base_url}` is not a valid URL: {error}")
+        })?;
+        if !matches!(uri.scheme_str(), Some("http" | "https")) || uri.authority().is_none() {
+            return Err(format!(
+                "OpenAI provider base_url `{base_url}` must be an absolute http or https URL"
+            ));
+        }
+        if uri.query().is_some() {
+            return Err(format!(
+                "OpenAI provider base_url `{base_url}` must not contain a query string"
+            ));
+        }
+    }
+    Ok(())
+}
+
+pub(crate) fn apply_openai_network_overrides(
+    built_in_provider: &mut ModelProviderInfo,
+    provider_override: &mut ModelProviderInfo,
+) -> Result<(), String> {
+    let base_url = provider_override.base_url.take();
+    let request_max_retries = provider_override.request_max_retries.take();
+    let stream_max_retries = provider_override.stream_max_retries.take();
+    let stream_idle_timeout_ms = provider_override.stream_idle_timeout_ms.take();
+    let websocket_connect_timeout_ms = provider_override.websocket_connect_timeout_ms.take();
+    let compact_request_timeout_ms = provider_override.compact_request_timeout_ms.take();
+    let server_overload_policy = std::mem::take(&mut provider_override.server_overload_policy);
+
+    if *provider_override != ModelProviderInfo::default() {
+        return Err(OPENAI_PROVIDER_OVERRIDE_ERROR.to_string());
+    }
+
+    let candidate = ModelProviderInfo {
+        base_url: base_url.clone(),
+        compact_request_timeout_ms,
+        ..ModelProviderInfo::default()
+    };
+    validate_openai_network_config(&candidate)?;
+
+    if base_url.is_some() {
+        built_in_provider.base_url = base_url;
+    }
+    if request_max_retries.is_some() {
+        built_in_provider.request_max_retries = request_max_retries;
+    }
+    if stream_max_retries.is_some() {
+        built_in_provider.stream_max_retries = stream_max_retries;
+    }
+    if stream_idle_timeout_ms.is_some() {
+        built_in_provider.stream_idle_timeout_ms = stream_idle_timeout_ms;
+    }
+    if websocket_connect_timeout_ms.is_some() {
+        built_in_provider.websocket_connect_timeout_ms = websocket_connect_timeout_ms;
+    }
+    if candidate.compact_request_timeout_ms.is_some() {
+        built_in_provider.compact_request_timeout_ms = candidate.compact_request_timeout_ms;
+    }
+    built_in_provider.server_overload_policy = server_overload_policy;
+
+    Ok(())
+}
