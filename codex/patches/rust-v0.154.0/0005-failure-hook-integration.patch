+        receive_call(&calls).await;
+
+        let mut first_request = request("queued", 1);
+        first_request.coalesced_count = u64::MAX - 1;
+        first_request.error.message = "old payload".to_string();
+        let (first, first_start) = enqueue_new(&dispatcher, &engine, first_request);
+        first_start.start();
+
+        let mut latest_request = request("queued", 9);
+        latest_request.coalesced_count = 10;
+        latest_request.error.message = "latest payload".to_string();
+        let mut reconfigured_engine = engine.clone();
+        reconfigured_engine.handlers[0].source_path =
+            cwd().join("replacement-request-error.json").into();
+        let merged = match dispatcher.enqueue(reconfigured_engine, latest_request) {
+            RequestErrorDispatch::Coalesced(receiver) => receiver,
+            RequestErrorDispatch::Queued { .. } => panic!("queued same-key job was not merged"),
+            RequestErrorDispatch::Rejected { reason, .. } => {
+                panic!("queued same-key job was rejected: {reason}")
+            }
+        };
+
+        executor.release(1);
+        let call = receive_call(&calls).await;
+        assert_eq!(call.get("attempt").and_then(Value::as_u64), Some(9));
+        assert_eq!(
+            call.get("message").and_then(Value::as_str),
+            Some("latest payload")
+        );
+        assert_eq!(
+            call.get("coalescedCount").and_then(Value::as_u64),
+            Some(u64::MAX)
+        );
+        executor.release(1);
+
+        receive_outcome(running).await;
+        receive_outcome(first).await;
+        receive_outcome(merged).await;
+        let completions = futures::future::join_all((0..2).map(|_| async {
+            tokio::time::timeout(Duration::from_secs(5), completed.recv())
+                .await
+                .expect("logical job completion timed out")
+                .expect("completion channel closed")
+        }))
+        .await;
+        assert!(
+            completions
+                .iter()
+                .all(|event| event.run.source_path.ends_with("request-error.json")),
+            "coalescing must retain the logical job's handler snapshot: {completions:?}"
+        );
+        assert_eq!(completed.try_recv(), Err(TryRecvError::Empty));
+        finish(&dispatcher, &engine).await;
+    }
+
+    #[tokio::test]
+    async fn running_same_key_creates_a_new_logical_job() {
+        let (engine, dispatcher, executor, calls, completed) = harness(false);
+        let (first, first_start) = enqueue_new(&dispatcher, &engine, request("same", 1));
+        first_start.start();
+        receive_call(&calls).await;
+
+        let (second, second_start) = enqueue_new(&dispatcher, &engine, request("same", 2));
+        second_start.start();
+        executor.release(1);
+        let second_call = receive_call(&calls).await;
+        assert_eq!(second_call.get("attempt").and_then(Value::as_u64), Some(2));
+        executor.release(1);
+        receive_outcome(first).await;
+        receive_outcome(second).await;
+        for _ in 0..2 {
+            completed.recv().await.expect("logical job completion");
+        }
+        finish(&dispatcher, &engine).await;
+    }
+
+    #[tokio::test]
+    async fn every_coalescing_key_field_distinguishes_queued_jobs() {
+        let (engine, dispatcher, executor, calls, _completed) = harness(false);
+        let (running, running_start) = enqueue_new(&dispatcher, &engine, request("running", 0));
+        running_start.start();
+        receive_call(&calls).await;
+
+        let base = request("key", 1);
+        let mut requests = vec![base.clone()];
+        let mut changed = base.clone();
+        changed.turn_id = "other-turn".to_string();
+        requests.push(changed);
+        let mut changed = base.clone();
+        changed.operation = ModelRequestOperation::LocalCompact;
+        requests.push(changed);
+        let mut changed = base.clone();
+        changed.endpoint_path = "/compact".to_string();
+        requests.push(changed);
+        let mut changed = base.clone();
+        changed.error.category = ModelRequestErrorCategory::Timeout;
+        requests.push(changed);
+        let mut changed = base.clone();
+        changed.error.code = Some("different".to_string());
+        requests.push(changed);
+        let mut changed = base;
+        changed.next_action = ModelRequestNextAction::Fallback;
+        requests.push(changed);
+
+        let mut receivers = vec![running];
+        for request in requests {
+            let (receiver, start) = enqueue_new(&dispatcher, &engine, request);
+            start.start();
+            receivers.push(receiver);
+        }
+        executor.release(receivers.len());
+        for _ in 0..7 {
+            receive_call(&calls).await;
+        }
+        for receiver in receivers {
+            receive_outcome(receiver).await;
+        }
+        finish(&dispatcher, &engine).await;
+    }
+
+    #[tokio::test]
+    async fn queue_capacity_is_exactly_sixty_four_unstarted_jobs() {
+        let (engine, dispatcher, executor, calls, _completed) = harness(false);
+        let (running, running_start) = enqueue_new(&dispatcher, &engine, request("running", 0));
+        running_start.start();
+        receive_call(&calls).await;
+
+        let mut receivers = vec![running];
+        for index in 0..REQUEST_ERROR_QUEUE_CAPACITY {
+            let (receiver, start) = enqueue_new(
+                &dispatcher,
+                &engine,
+                request(format!("queued-{index}"), index as u64 + 1),
+            );
+            start.start();
+            receivers.push(receiver);
+        }
+        match dispatcher.enqueue(engine.clone(), request("overflow", 1000)) {
+            RequestErrorDispatch::Rejected { outcome, reason } => {
+                assert_eq!(outcome.hook_dispatch_rejected, 1);
+                assert!(outcome.hook_events.is_empty());
+                assert!(reason.contains("capacity 64"));
+            }
+            RequestErrorDispatch::Queued { .. } | RequestErrorDispatch::Coalesced(_) => {
+                panic!("65th unstarted logical job was accepted")
+            }
+        }
+
+        executor.release(receivers.len());
+        for receiver in receivers {
+            receive_outcome(receiver).await;
+        }
+        finish(&dispatcher, &engine).await;
+    }
+
+    #[tokio::test]
+    async fn closed_queue_rejects_without_creating_lifecycle_events() {
+        let (engine, dispatcher, _executor, _calls, _completed) = harness(false);
+        dispatcher.begin_shutdown();
+        dispatcher.wait_finished().await;
+        match dispatcher.enqueue(engine.clone(), request("closed", 1)) {
+            RequestErrorDispatch::Rejected { outcome, reason } => {
+                assert_eq!(outcome.hook_dispatch_rejected, 1);
+                assert!(outcome.hook_events.is_empty());
+                assert!(reason.contains("closed"));
+            }
+            RequestErrorDispatch::Queued { .. } | RequestErrorDispatch::Coalesced(_) => {
+                panic!("closed queue accepted a job")
+            }
+        }
+        engine.command_runtime.shutdown().await;
+    }
+
+    #[tokio::test]
+    async fn worker_panic_becomes_failed_completion_and_actor_finishes() {
+        let (engine, dispatcher, _executor, _calls, completed) = harness(true);
+        let (receiver, start) = enqueue_new(&dispatcher, &engine, request("panic", 1));
+        start.start();
+        let outcome = receive_outcome(receiver).await;
+        assert_eq!(outcome.hook_events.len(), 1);
+        assert_eq!(outcome.hook_events[0].run.status, HookRunStatus::Failed);
+        assert!(
+            outcome.hook_events[0].run.entries[0]
+                .text
+                .contains("panicked")
+        );
+        assert_eq!(
+            completed.recv().await.expect("panic completion").run.status,
+            HookRunStatus::Failed
+        );
+        finish(&dispatcher, &engine).await;
+    }
+
+    #[tokio::test]
+    async fn command_handler_timeout_completes_receiver_as_failed() {
+        let (executor, _calls) = {
+            let (calls, receiver) = async_channel::unbounded();
+            (
+                Arc::new(ControlledMcpExecutor {
+                    calls,
+                    release: Semaphore::new(0),
+                    panic: false,
+                }),
+                receiver,
+            )
+        };
+        let (mut engine, _completed) = engine(executor);
+        engine.handlers[0].timeout_sec = 0;
+        engine.handlers[0].kind = ConfiguredHandlerKind::Command {
+            command: "sleep 60".to_string(),
+            env: std::collections::HashMap::new(),
+            r#async: false,
+        };
+        let dispatcher = RequestErrorDispatcher::new(&engine.command_runtime);
+        let (receiver, start) = enqueue_new(&dispatcher, &engine, request("timeout", 1));
+        start.start();
+        let outcome = receive_outcome(receiver).await;
+        assert_eq!(outcome.hook_events[0].run.status, HookRunStatus::Failed);
+        assert!(
+            outcome.hook_events[0].run.entries[0]
+                .text
+                .contains("timed out")
+        );
+        finish(&dispatcher, &engine).await;
+    }
+
+    #[tokio::test]
+    async fn graceful_shutdown_drains_running_and_queued_jobs() {
+        let (engine, dispatcher, executor, calls, _completed) = harness(false);
+        let (running, running_start) = enqueue_new(&dispatcher, &engine, request("running", 1));
+        running_start.start();
+        receive_call(&calls).await;
+        let (queued, queued_start) = enqueue_new(&dispatcher, &engine, request("queued", 2));
+        queued_start.start();
+
+        dispatcher.begin_shutdown();
+        let waiting_dispatcher = dispatcher.clone();
+        let shutdown = tokio::spawn(async move { waiting_dispatcher.wait_finished().await });
+        assert!(
+            !shutdown.is_finished(),
+            "graceful shutdown skipped the running job"
+        );
+        executor.release(2);
+        receive_outcome(running).await;
+        receive_outcome(queued).await;
+        tokio::time::timeout(Duration::from_secs(5), shutdown)
+            .await
+            .expect("graceful shutdown timed out")
+            .expect("graceful shutdown task panicked");
+        engine.command_runtime.shutdown().await;
+    }
+
+    #[tokio::test]
+    async fn forced_shutdown_fails_running_and_queued_jobs_and_completes_receivers() {
+        let (engine, dispatcher, _executor, calls, completed) = harness(false);
+        let (running, running_start) = enqueue_new(&dispatcher, &engine, request("running", 1));
+        running_start.start();
+        receive_call(&calls).await;
+        let (queued, queued_start) = enqueue_new(&dispatcher, &engine, request("queued", 2));
+        queued_start.start();
+
+        tokio::time::timeout(Duration::from_secs(5), engine.command_runtime.shutdown())
+            .await
+            .expect("forced runtime shutdown timed out");
+        for receiver in [running, queued] {
+            let outcome = receive_outcome(receiver).await;
+            assert_eq!(outcome.hook_events[0].run.status, HookRunStatus::Failed);
+            assert!(
+                outcome.hook_events[0].run.entries[0]
+                    .text
+                    .contains("forced runtime shutdown")
+            );
+        }
+        for _ in 0..2 {
+            assert_eq!(
+                completed
+                    .recv()
+                    .await
+                    .expect("forced cancellation completion")
+                    .run
+                    .status,
+                HookRunStatus::Failed
+            );
+        }
+        tokio::time::timeout(Duration::from_secs(5), dispatcher.wait_finished())
+            .await
+            .expect("cancelled actor did not mark itself finished");
+    }
+}
