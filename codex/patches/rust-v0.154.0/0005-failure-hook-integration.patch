+pub(crate) async fn run_request_error_hooks(
+    sess: &Arc<Session>,
+    turn_context: &Arc<TurnContext>,
+    failure: ModelRequestFailure,
+) {
+    let request = codex_hooks::RequestErrorRequest {
+        session_id: sess.session_id().into(),
+        turn_id: turn_context.sub_id.clone(),
+        transcript_path: sess.hook_transcript_path().await,
+        #[allow(deprecated)]
+        cwd: turn_context.cwd.clone(),
+        model: turn_context.model_info().slug.clone(),
+        provider: turn_context.config.model_provider_id.clone(),
+        operation: failure.context.operation,
+        endpoint_path: failure.context.endpoint_path.to_string(),
+        attempt: failure.attempt,
+        retry_budget: failure.retry_budget,
+        next_action: failure.next_action,
+        coalesced_count: failure.coalesced_count,
+        error: failure.error,
+    };
+    let hooks = sess.hooks();
+    let preview_runs = hooks.preview_request_error(&request);
+    if preview_runs.is_empty() {
+        return;
+    }
+
+    match hooks.enqueue_request_error(request) {
+        codex_hooks::RequestErrorDispatch::Queued {
+            receiver: _outcome_receiver,
+            start,
+        } => {
+            emit_hook_started_events(sess, turn_context, preview_runs).await;
+            start.start();
+        }
+        codex_hooks::RequestErrorDispatch::Coalesced(_outcome_receiver) => {}
+        codex_hooks::RequestErrorDispatch::Rejected { outcome, reason } => {
+            if outcome.hook_dispatch_rejected > 0 {
+                sess.send_event(
+                    turn_context,
+                    EventMsg::Warning(WarningEvent {
+                        message: format!(
+                            "RequestError hook dispatch rejected (count={}): {reason}.",
+                            outcome.hook_dispatch_rejected
+                        ),
+                    }),
+                )
+                .await;
+            }
+        }
+    }
+}
