+#[tokio::test]
+async fn active_goal_abnormal_stop_suppression_persists_and_starts_continuation() -> Result<()> {
+    skip_if_host_windows!(Ok(()));
+    skip_if_remote!(Ok(()), "command hook uses host-local script and log paths");
+
+    let (release_continuation, continuation_gate) = oneshot::channel();
+    let (server, _response_completions) = start_streaming_sse_server(vec![
+        ungated_goal_response(responses::sse_completed("materialize-thread")),
+        ungated_goal_response(responses::sse_failed(
+            "failed-goal-turn",
+            "server_error",
+            "terminal goal turn failure",
+        )),
+        vec![StreamingSseChunk {
+            gate: Some(continuation_gate),
+            body: responses::sse_completed("continued-goal-turn"),
+        }],
+    ])
+    .await;
+    let codex_home = TempDir::new()?;
+    let hook_script_path = codex_home.path().join("abnormal_stop_hook.py");
+    let hook_log_path = codex_home.path().join("abnormal_stop_hook.jsonl");
+    std::fs::write(
+        &hook_script_path,
+        format!(
+            r#"import json
+from pathlib import Path
+import sys
+
+payload = json.load(sys.stdin)
+with Path(r"{hook_log_path}").open("a", encoding="utf-8") as handle:
+    handle.write(json.dumps(payload) + "\n")
+print("{{}}")
+"#,
+            hook_log_path = hook_log_path.display(),
+        ),
+    )?;
+    MockResponsesConfig::new(server.uri())
+        .enable_feature(Feature::Goals)
+        .enable_feature(Feature::CodexHooks)
+        .with_extra_config(&format!(
+            r#"[hooks]
+
+[[hooks.AbnormalStop]]
+
+[[hooks.AbnormalStop.hooks]]
+type = "command"
+command = 'python3 "{}"'
+"#,
+            hook_script_path.display(),
+        ))
+        .write(codex_home.path())?;
+    let mut mcp = TestAppServer::builder()
+        .with_codex_home(codex_home.path())
+        .without_managed_config()
+        .build_initialized_with_timeout(DEFAULT_READ_TIMEOUT.saturating_mul(2))
+        .await?;
+
+    let start_id = mcp
+        .send_thread_start_request_with_auto_env(ThreadStartParams {
+            model: Some("mock-model".to_string()),
+            config: Some(std::collections::HashMap::from([(
+                "bypass_hook_trust".to_string(),
+                json!(true),
+            )])),
+            ..Default::default()
+        })
+        .await?;
+    let ThreadStartResponse { thread, .. } =
+        timeout(DEFAULT_READ_TIMEOUT, mcp.read_response(start_id)).await??;
+    let turn_id = mcp
+        .send_turn_start_request(TurnStartParams {
+            thread_id: thread.id.clone(),
+            input: vec![UserInput::Text {
+                text: "materialize this thread".to_string(),
+                text_elements: Vec::new(),
+            }],
+            ..Default::default()
+        })
+        .await?;
+    let _: TurnStartResponse = timeout(DEFAULT_READ_TIMEOUT, mcp.read_response(turn_id)).await??;
+    timeout(
+        DEFAULT_READ_TIMEOUT,
+        mcp.read_stream_until_notification_message("turn/completed"),
+    )
+    .await??;
+
+    let goal_id = mcp
+        .send_raw_request(
+            "thread/goal/set",
+            Some(json!({
+                "threadId": thread.id,
+                "objective": "continue after a terminal model failure",
+                "status": "active",
+            })),
+        )
+        .await?;
+    let goal: ThreadGoalSetResponse =
+        timeout(DEFAULT_READ_TIMEOUT, mcp.read_response(goal_id)).await??;
+    assert_eq!(goal.goal.status, ThreadGoalStatus::Active);
+    timeout(DEFAULT_READ_TIMEOUT, server.wait_for_request_count(3)).await?;
+
+    let get_id = mcp
+        .send_raw_request("thread/goal/get", Some(json!({ "threadId": thread.id })))
+        .await?;
+    let persisted: ThreadGoalGetResponse =
+        timeout(DEFAULT_READ_TIMEOUT, mcp.read_response(get_id)).await??;
+    assert_eq!(
+        persisted
+            .goal
+            .as_ref()
+            .map(|persisted_goal| persisted_goal.status),
+        Some(ThreadGoalStatus::Active),
+        "suppressed turn-error lifecycle must leave the durable goal active"
+    );
+
+    let requests = server.requests().await;
+    assert_eq!(requests.len(), 3);
+    let failed_goal_request = serde_json::from_slice::<serde_json::Value>(&requests[1])?;
+    let continuation_request = serde_json::from_slice::<serde_json::Value>(&requests[2])?;
+    for request in [&failed_goal_request, &continuation_request] {
+        let request_body = request.to_string();
+        assert!(
+            request_body.contains("Continue working toward the active thread goal")
+                && request_body.contains("continue after a terminal model failure"),
+            "both requests must contain the persisted goal continuation input: {request_body}"
+        );
+    }
+    assert_ne!(
+        failed_goal_request["client_metadata"]["turn_id"],
+        continuation_request["client_metadata"]["turn_id"],
+        "suppression must produce a subsequent goal turn, not retry the same turn"
+    );
+
+    let hook_inputs = std::fs::read_to_string(&hook_log_path)?
+        .lines()
+        .map(serde_json::from_str::<serde_json::Value>)
+        .collect::<Result<Vec<_>, _>>()?;
+    assert_eq!(hook_inputs.len(), 1);
+    assert_eq!(hook_inputs[0]["hookEventName"], "AbnormalStop");
+    assert_eq!(hook_inputs[0]["goalMode"], true);
+    assert_ne!(hook_inputs[0]["error"]["category"], "policy");
+    assert!(
+        hook_inputs[0].get("nextAction").is_none(),
+        "AbnormalStop must use its strict event-specific schema"
+    );
+
+    let clear_id = mcp
+        .send_raw_request(
+            "thread/goal/clear",
+            Some(json!({
+                "threadId": thread.id,
+            })),
+        )
+        .await?;
+    let cleared: ThreadGoalClearResponse =
+        timeout(DEFAULT_READ_TIMEOUT, mcp.read_response(clear_id)).await??;
+    assert!(cleared.cleared);
+    release_continuation
+        .send(())
+        .expect("continuation response gate should remain open");
+    for _ in 0..2 {
+        timeout(
+            DEFAULT_READ_TIMEOUT,
+            mcp.read_stream_until_notification_message("turn/completed"),
+        )
+        .await??;
+    }
+    assert_eq!(server.requests().await.len(), 3);
+    server.shutdown().await;
+    Ok(())
+}
