+    next_action: crate::events::model_request::ModelRequestNextAction,
+}
+
+struct PendingRequestError {
+    engine: ClaudeHooksEngine,
+    request: RequestErrorRequest,
+    outcome_senders: Vec<oneshot::Sender<NotificationHookOutcome>>,
+    ready: bool,
+}
+
+struct RequestErrorActorState {
+    queue: VecDeque<u64>,
+    queued_by_key: HashMap<RequestErrorKey, u64>,
+    jobs: HashMap<u64, PendingRequestError>,
+    next_job_id: u64,
+    unstarted_jobs: usize,
+    accepting: bool,
+    finished: bool,
+    actor_started: bool,
+}
+
+struct RequestErrorActorInner {
+    state: Mutex<RequestErrorActorState>,
+    queue_notify: Notify,
+    finished_notify: Notify,
+}
+
+struct RequestErrorActorCancellation {
+    inner: Arc<RequestErrorActorInner>,
+    armed: bool,
+}
+
+impl RequestErrorActorCancellation {
+    fn new(inner: Arc<RequestErrorActorInner>) -> Self {
+        Self { inner, armed: true }
+    }
+
+    fn disarm(&mut self) {
+        self.armed = false;
+    }
+}
+
+impl Drop for RequestErrorActorCancellation {
+    fn drop(&mut self) {
+        if !self.armed {
+            return;
+        }
+
+        let jobs = {
+            let mut state = self
+                .inner
+                .state
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            state.accepting = false;
+            state.finished = true;
+            state.actor_started = false;
+            RequestErrorDispatcher::take_all_jobs(&mut state)
+        };
+        for job in jobs {
+            RequestErrorDispatcher::complete_job(
+                job,
+                "RequestError hook dispatch cancelled during forced runtime shutdown",
+            );
+        }
+        self.inner.queue_notify.notify_waiters();
+        self.inner.finished_notify.notify_waiters();
+    }
+}
+
+#[derive(Clone)]
+struct RequestErrorDispatcher {
+    inner: Arc<RequestErrorActorInner>,
+    runtime: CommandHookRuntime,
+}
+
+impl RequestErrorDispatcher {
+    fn new(runtime: &CommandHookRuntime) -> Self {
+        let dispatcher = Self {
+            inner: Arc::new(RequestErrorActorInner {
+                state: Mutex::new(RequestErrorActorState {
+                    queue: VecDeque::new(),
+                    queued_by_key: HashMap::new(),
+                    jobs: HashMap::new(),
+                    next_job_id: 0,
+                    unstarted_jobs: 0,
+                    accepting: true,
+                    finished: false,
+                    actor_started: false,
+                }),
+                queue_notify: Notify::new(),
+                finished_notify: Notify::new(),
+            }),
+            runtime: runtime.clone(),
+        };
+        dispatcher
+    }
+
+    fn ensure_actor(&self) -> bool {
+        let mut state = self.lock_state();
+        if !state.accepting {
+            return false;
+        }
+        if state.actor_started {
+            return true;
+        }
+
+        let inner = Arc::clone(&self.inner);
+        if self
+            .runtime
+            .schedule_owned_task(async move { Self::run_actor(inner).await })
+        {
+            state.actor_started = true;
+            true
+        } else {
+            state.accepting = false;
+            state.finished = true;
+            drop(state);
+            self.inner.finished_notify.notify_waiters();
+            false
+        }
+    }
+
+    fn enqueue(
+        &self,
+        engine: ClaudeHooksEngine,
+        request: RequestErrorRequest,
+    ) -> RequestErrorDispatch {
+        if !self.ensure_actor() {
+            return RequestErrorDispatch::Rejected {
+                outcome: crate::events::model_request::request_error_dispatch_rejection(),
+                reason: "RequestError hook queue is closed".to_string(),
+            };
+        }
+        let key = RequestErrorKey {
+            turn_id: request.turn_id.clone(),
+            operation: request.operation,
+            endpoint_path: request.endpoint_path.clone(),
+            category: request.error.category,
+            code: request.error.code.clone(),
+            next_action: request.next_action,
+        };
+        let (outcome_sender, outcome_receiver) = oneshot::channel();
+        let mut state = self.lock_state();
+        if !state.accepting {
+            return RequestErrorDispatch::Rejected {
+                outcome: crate::events::model_request::request_error_dispatch_rejection(),
+                reason: "RequestError hook queue is closed".to_string(),
+            };
+        }
+        if let Some(job_id) = state.queued_by_key.get(&key).copied()
+            && let Some(existing) = state.jobs.get_mut(&job_id)
+        {
+            let coalesced_count = existing
+                .request
+                .coalesced_count
+                .max(1)
+                .saturating_add(request.coalesced_count.max(1));
+            // The most recent payload wins; only the aggregate count survives
+            // from the older queued payload.
+            existing.request = request;
+            existing.request.coalesced_count = coalesced_count;
+            existing.outcome_senders.push(outcome_sender);
+            return RequestErrorDispatch::Coalesced(outcome_receiver);
+        }
+
+        if state.unstarted_jobs >= REQUEST_ERROR_QUEUE_CAPACITY {
+            return RequestErrorDispatch::Rejected {
+                outcome: crate::events::model_request::request_error_dispatch_rejection(),
+                reason: format!(
+                    "RequestError hook queue is full (capacity {REQUEST_ERROR_QUEUE_CAPACITY})"
+                ),
+            };
+        }
+
+        let job_id = state.next_job_id;
+        state.next_job_id = state.next_job_id.wrapping_add(1);
+        state.queue.push_back(job_id);
+        state.queued_by_key.insert(key, job_id);
+        state.jobs.insert(
+            job_id,
+            PendingRequestError {
+                engine,
+                request,
+                outcome_senders: vec![outcome_sender],
+                ready: false,
+            },
+        );
+        state.unstarted_jobs += 1;
+        drop(state);
+        self.inner.queue_notify.notify_one();
+
+        RequestErrorDispatch::Queued {
+            receiver: outcome_receiver,
+            start: RequestErrorStart {
+                inner: Arc::clone(&self.inner),
+                job_id,
+                armed: true,
+            },
+        }
+    }
+
+    fn lock_state(&self) -> std::sync::MutexGuard<'_, RequestErrorActorState> {
+        self.inner
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+    }
+
+    async fn run_actor(inner: Arc<RequestErrorActorInner>) {
+        let mut cancellation = RequestErrorActorCancellation::new(Arc::clone(&inner));
+        loop {
+            let notified = inner.queue_notify.notified();
+            let action = {
+                let mut state = inner
+                    .state
+                    .lock()
+                    .unwrap_or_else(std::sync::PoisonError::into_inner);
+                if let Some(job_id) = state.queue.front().copied() {
+                    let ready = state.jobs.get(&job_id).is_some_and(|job| job.ready);
+                    if ready {
+                        state.queue.pop_front();
+                        state.unstarted_jobs = state.unstarted_jobs.saturating_sub(1);
+                        state
+                            .queued_by_key
+                            .retain(|_, queued_id| *queued_id != job_id);
+                        match state.jobs.get(&job_id) {
+                            Some(job) => ActorAction::Run {
+                                job_id,
+                                engine: job.engine.clone(),
+                                request: job.request.clone(),
+                            },
+                            None => ActorAction::Wait,
+                        }
+                    } else {
+                        ActorAction::Wait
+                    }
+                } else if state.accepting {
+                    ActorAction::Wait
+                } else {
+                    ActorAction::Finish
+                }
+            };
+
+            match action {
+                ActorAction::Wait => notified.await,
+                ActorAction::Run {
+                    job_id,
+                    engine,
+                    request,
+                } => Self::run_job(&inner, job_id, engine, request).await,
+                ActorAction::Finish => {
+                    Self::mark_finished(&inner);
+                    cancellation.disarm();
+                    return;
+                }
+            }
+        }
+    }
+
+    async fn run_job(
+        inner: &Arc<RequestErrorActorInner>,
+        job_id: u64,
+        engine: ClaudeHooksEngine,
+        request: RequestErrorRequest,
+    ) {
+        let outcome = match AssertUnwindSafe(engine.run_request_error(request.clone()))
+            .catch_unwind()
+            .await
+        {
+            Ok(outcome) => outcome,
+            Err(_) => crate::events::model_request::request_error_dispatch_failure(
+                &engine.handlers,
+                request.turn_id,
+                "RequestError hook worker panicked",
+            ),
+        };
+        let job = {
+            let mut state = inner
+                .state
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            state.jobs.remove(&job_id)
+        };
+        if let Some(job) = job {
+            Self::deliver_job(job, outcome);
+        }
+    }
+
+    fn deliver_job(job: PendingRequestError, outcome: NotificationHookOutcome) {
+        for completed in outcome.hook_events.iter().cloned() {
+            job.engine.command_runtime.publish_completed(completed);
+        }
+        for sender in job.outcome_senders {
+            let _ = sender.send(outcome.clone());
+        }
+    }
+
+    fn complete_job(job: PendingRequestError, message: &'static str) {
+        let outcome = crate::events::model_request::request_error_dispatch_failure(
+            &job.engine.handlers,
+            job.request.turn_id.clone(),
+            message,
+        );
+        Self::deliver_job(job, outcome);
+    }
+
+    fn take_all_jobs(state: &mut RequestErrorActorState) -> Vec<PendingRequestError> {
+        state.queue.clear();
+        state.queued_by_key.clear();
+        state.unstarted_jobs = 0;
+        state.jobs.drain().map(|(_, job)| job).collect()
+    }
+
+    fn mark_finished(inner: &RequestErrorActorInner) {
+        let mut state = inner
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        state.finished = true;
+        state.actor_started = false;
+        drop(state);
+        inner.finished_notify.notify_waiters();
+    }
+
+    async fn shutdown(&self) {
+        self.begin_shutdown();
+        self.wait_finished().await;
+    }
+
+    fn begin_shutdown(&self) {
+        let finished_without_actor = {
+            let mut state = self.lock_state();
+            state.accepting = false;
+            if !state.actor_started {
+                state.finished = true;
+                true
+            } else {
+                false
+            }
+        };
+        if finished_without_actor {
+            self.inner.finished_notify.notify_waiters();
+        }
+        self.inner.queue_notify.notify_waiters();
+    }
+
+    async fn wait_finished(&self) {
+        loop {
+            let notified = self.inner.finished_notify.notified();
+            if self.lock_state().finished {
+                return;
+            }
+            notified.await;
+        }
+    }
+}
+
+enum ActorAction {
+    Wait,
+    Run {
+        job_id: u64,
+        engine: ClaudeHooksEngine,
+        request: RequestErrorRequest,
+    },
+    Finish,
+}
+
+pub struct RequestErrorStart {
+    inner: Arc<RequestErrorActorInner>,
+    job_id: u64,
+    armed: bool,
+}
+
+impl RequestErrorStart {
+    pub fn start(mut self) {
+        self.mark_ready();
+        self.armed = false;
+    }
+
+    fn mark_ready(&self) {
+        let mut state = self
+            .inner
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if let Some(job) = state.jobs.get_mut(&self.job_id) {
+            job.ready = true;
+        }
+        drop(state);
+        self.inner.queue_notify.notify_waiters();
+    }
+}
+
+impl Drop for RequestErrorStart {
+    fn drop(&mut self) {
+        if self.armed {
+            self.mark_ready();
+        }
+    }
+}
+
+pub enum RequestErrorDispatch {
+    Queued {
+        receiver: oneshot::Receiver<NotificationHookOutcome>,
+        start: RequestErrorStart,
+    },
+    Coalesced(oneshot::Receiver<NotificationHookOutcome>),
+    Rejected {
+        outcome: NotificationHookOutcome,
+        reason: String,
+    },
+}
 
