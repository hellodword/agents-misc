+#[tokio::test]
+async fn active_goal_turn_error_suppression_is_one_shot() {
+    struct TurnErrorCounter {
+        calls: Arc<std::sync::atomic::AtomicUsize>,
+    }
+
+    impl codex_extension_api::TurnLifecycleContributor for TurnErrorCounter {
+        fn on_turn_error<'a>(
+            &'a self,
+            _input: codex_extension_api::TurnErrorInput<'a>,
+        ) -> codex_extension_api::ExtensionFuture<'a, ()> {
+            Box::pin(async move {
+                self.calls.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+            })
+        }
+    }
+
+    let (mut session, turn_context) = make_session_and_context().await;
+    let calls = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+    let mut builder = codex_extension_api::ExtensionRegistryBuilder::<crate::config::Config>::new();
+    builder.turn_lifecycle_contributor(Arc::new(TurnErrorCounter {
+        calls: Arc::clone(&calls),
+    }));
+    session.services.extensions = Arc::new(builder.build());
+    turn_context
+        .extension_data
+        .insert(codex_extension_api::ActiveGoalTurn);
+    turn_context
+        .extension_data
+        .insert(codex_extension_api::SuppressTurnErrorLifecycle);
+
+    session
+        .emit_turn_error_lifecycle(&turn_context, CodexErrorInfo::Other)
+        .await;
+    assert_eq!(calls.load(std::sync::atomic::Ordering::SeqCst), 0);
+    assert!(
+        turn_context
+            .extension_data
+            .get::<codex_extension_api::SuppressTurnErrorLifecycle>()
+            .is_none(),
+        "suppression marker must be consumed atomically"
+    );
+    assert!(
+        turn_context
+            .extension_data
+            .get::<codex_extension_api::ActiveGoalTurn>()
+            .is_some(),
+        "suppressing turn-error lifecycle must not erase active-goal identity"
+    );
+
+    session
+        .emit_turn_error_lifecycle(&turn_context, CodexErrorInfo::Other)
+        .await;
+    assert_eq!(calls.load(std::sync::atomic::Ordering::SeqCst), 1);
+}
