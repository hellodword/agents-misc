+        let mut engine = engine_with_executor(executor.clone());
+        engine.handlers = (0..9)
+            .map(|order| handler(HookEventName::RequestError, format!("hook-{order}"), order))
+            .collect();
+
+        let outcome = run_request_error(&engine, request_error(0)).await;
+
+        assert_eq!(outcome.hook_events.len(), 9);
+        assert_eq!(executor.maximum.load(Ordering::SeqCst), 4);
+    }
+
+}
