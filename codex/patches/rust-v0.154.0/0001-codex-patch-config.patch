+/// Producer-level retry budget used by the local Codex patch.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum RecoveryLimit {
+    Limited(u64),
+    Unlimited,
+}
+
+impl Serialize for RecoveryLimit {
+    fn serialize<S>(&self, serializer: S) -> Result<S::Ok, S::Error>
+    where
+        S: Serializer,
+    {
+        match self {
+            Self::Limited(value) => serializer.serialize_u64(*value),
+            Self::Unlimited => serializer.serialize_str("unlimited"),
+        }
+    }
+}
+
+impl<'de> Deserialize<'de> for RecoveryLimit {
+    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>
+    where
+        D: Deserializer<'de>,
+    {
+        struct RecoveryLimitVisitor;
+
+        impl<'de> Visitor<'de> for RecoveryLimitVisitor {
+            type Value = RecoveryLimit;
+
+            fn expecting(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+                formatter.write_str("a non-negative integer or the string \"unlimited\"")
+            }
+
+            fn visit_u64<E>(self, value: u64) -> Result<Self::Value, E> {
+                Ok(RecoveryLimit::Limited(value))
+            }
+
+            fn visit_i64<E>(self, value: i64) -> Result<Self::Value, E>
+            where
+                E: SerdeError,
+            {
+                u64::try_from(value)
+                    .map(RecoveryLimit::Limited)
+                    .map_err(|_| E::invalid_value(serde::de::Unexpected::Signed(value), &self))
+            }
+
+            fn visit_str<E>(self, value: &str) -> Result<Self::Value, E>
+            where
+                E: SerdeError,
+            {
+                if value == "unlimited" {
+                    Ok(RecoveryLimit::Unlimited)
+                } else {
+                    Err(E::invalid_value(serde::de::Unexpected::Str(value), &self))
+                }
+            }
+        }
+
+        deserializer.deserialize_any(RecoveryLimitVisitor)
+    }
+}
