+    #[schemars(range(min = 1))]
+    pub responses_compact_timeout_ms: Option<NonZeroU64>,
+    /// Maximum wait per patch-managed retry; defaults to 120 seconds.
+    #[serde(default, deserialize_with = "deserialize_optional_nonzero_u64")]
+    #[schemars(range(min = 1))]
+    pub recovery_max_wait_ms: Option<NonZeroU64>,
+    #[schemars(with = "Option<RecoveryLimitSchema>")]
+    pub usage_limit_recovery_limit: Option<RecoveryLimit>,
+    #[schemars(with = "Option<RecoveryLimitSchema>")]
+    pub transient_request_recovery_limit: Option<RecoveryLimit>,
+    #[schemars(with = "Option<RecoveryLimitSchema>")]
+    pub server_overload_recovery_limit: Option<RecoveryLimit>,
+}
+
+fn deserialize_optional_nonzero_u64<'de, D>(deserializer: D) -> Result<Option<NonZeroU64>, D::Error>
+where
+    D: Deserializer<'de>,
+{
+    Option::<u64>::deserialize(deserializer)?
+        .map(|value| {
+            NonZeroU64::new(value).ok_or_else(|| {
+                D::Error::invalid_value(
+                    serde::de::Unexpected::Unsigned(value),
+                    &"a positive integer",
+                )
+            })
+        })
+        .transpose()
+}
