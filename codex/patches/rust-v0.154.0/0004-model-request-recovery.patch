+/// Apply an explicit patch recovery policy around the legacy unary compact
+/// request. With no matching limit, this performs exactly one Core attempt;
+/// lower HTTP retries remain owned by the client layer.
+async fn run_remote_compact_attempt_with_policy(
+    sess: &Arc<Session>,
+    step_context: &Arc<StepContext>,
+    turn_state: Option<Arc<OnceLock<String>>>,
+    compaction_trace: &codex_rollout_trace::CompactionTraceContext,
+    compaction_metadata: CompactionTurnMetadata,
+    analytics_details: &mut CompactionAnalyticsDetails,
+    cancellation_token: &CancellationToken,
+    recovery_state: &mut ModelRequestRecoveryState,
+) -> CodexResult<RemoteCompactAttempt> {
+    let turn_context = &step_context.turn;
+    let recovery_target = format!(
+        "{}\0{}\0remote-compact",
+        turn_context.config.model_provider_id,
+        turn_context.model_info().slug
+    );
+    loop {
+        if cancellation_token.is_cancelled() {
+            return Err(CodexErr::TurnAborted);
+        }
+        match run_remote_compact_attempt(
+            sess,
+            step_context,
+            turn_state.clone(),
+            compaction_trace,
+            compaction_metadata,
+            analytics_details,
+        )
+        .await
+        {
+            Ok(result) => return Ok(result),
+            Err(error) => {
+                if matches!(
+                    error.details(),
+                    codex_protocol::error::CodexErrorDetails::TurnAborted
+                ) {
+                    return Err(error);
+                }
+                let observation = recovery_state.observe_failure(
+                    recovery_target.clone(),
+                    &turn_context.config.codex_patch,
+                    &error,
+                );
+                let Some(recovery) = observation.configured_recovery else {
+                    return Err(error);
+                };
+                if !recovery.should_retry() {
+                    return Err(error);
+                }
+
+                let delay =
+                    configured_retry_delay(&turn_context.config.codex_patch, &error, recovery);
+                run_model_request_recovery_hooks(
+                    sess,
+                    turn_context,
+                    ModelRequestFailure::new(
+                        ModelRequestOperation::RemoteCompact,
+                        observation.attempt,
+                        &error,
+                    ),
+                    codex_hooks::ModelRequestNextAction::Retry,
+                )
+                .await;
+                sess.notify_stream_error(turn_context, "Reconnecting...", error)
+                    .await;
+                wait_for_retry(delay, cancellation_token).await?;
+            }
+        }
+    }
+}
+
+async fn run_remote_compact_fallback_hook(
+    sess: &Arc<Session>,
+    turn_context: &Arc<TurnContext>,
+    err: &CodexErr,
+    attempt: u64,
+) {
+    let failure = ModelRequestFailure::new(ModelRequestOperation::RemoteCompact, attempt, err);
+    run_model_request_recovery_hooks(
+        sess,
+        turn_context,
+        failure,
+        codex_hooks::ModelRequestNextAction::Fallback,
+    )
+    .await;
+}
+
+async fn run_remote_compact_terminal_hook(
+    sess: &Arc<Session>,
+    turn_context: &Arc<TurnContext>,
+    err: &CodexErr,
+    attempt: u64,
+) {
+    run_terminal_model_request_failure_hooks(
+        sess,
+        turn_context,
+        ModelRequestFailure::new(ModelRequestOperation::RemoteCompact, attempt, err),
+    )
+    .await;
+}
