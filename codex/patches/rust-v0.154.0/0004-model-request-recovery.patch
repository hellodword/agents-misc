+        responses.push(sse_response(body).set_delay(delay));
+    }
+    responses.push(sse_response(sse(vec![ev_completed("followup-response")])));
+    let response_log = mount_response_sequence(&server, responses).await;
+    if mode == "unary" {
+        mount_compact_response_sequence(&server, vec![wiremock::ResponseTemplate::new(200)
+            .set_body_json(json!({"output": [{"type": "compaction", "encrypted_content": "DELAYED_SUMMARY"}]}))
+            .set_delay(delay)]).await;
+    }
+    let local = mode == "local";
+    let v2 = mode == "v2";
+    let mut provider = if local {
+        local_compaction_provider(&server)
+    } else {
+        openai_model_provider(&server)
+    };
+    provider.request_max_retries = Some(0);
+    provider.stream_max_retries = Some(0);
+    let mut builder = test_codex()
+        .with_auth(CodexAuth::create_dummy_chatgpt_auth_for_testing())
+        .with_config(move |config| {
+            config.model_provider = provider;
+            config.codex_patch.responses_compact_timeout_ms =
+                configured.then(|| std::num::NonZeroU64::new(50).unwrap());
+            config.codex_patch.transient_request_recovery_limit = Some(RecoveryLimit::Limited(0));
+            if v2 {
+                let _ = config.features.enable(Feature::RemoteCompactionV2);
+            } else {
+                let _ = config.features.disable(Feature::RemoteCompactionV2);
+            }
+            set_test_compact_prompt(config);
+        });
+    let test = builder.build_with_auto_env(&server).await?;
+    test.submit_turn("seed timeout test").await?;
+    test.codex.submit(Op::Compact).await?;
+    let mut failed = false;
+    loop {
+        let event = wait_for_event(&test.codex, |event| {
+            matches!(event, EventMsg::Error(_) | EventMsg::TurnComplete(_))
+        })
+        .await;
+        match event {
+            EventMsg::Error(_) => failed = true,
+            EventMsg::TurnComplete(_) => break,
+            _ => unreachable!(),
+        }
+    }
+    assert_eq!(failed, mode == "unary" && configured);
+    test.submit_turn("after compaction").await?;
+    if failed {
+        let requests = response_log.requests();
+        let followup = requests.last().unwrap().body_json().to_string();
+        assert!(body_contains_text(&followup, "original history"));
+        assert!(
+            !followup.contains("DELAYED_SUMMARY"),
+            "a timed-out result must not replace history"
+        );
+    }
+    Ok(())
+}
