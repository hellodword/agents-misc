+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn codex_patch_websocket_fallback_gets_a_fresh_http_recovery_budget() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let server = start_mock_server().await;
+    let busy = wiremock::ResponseTemplate::new(503)
+        .insert_header("retry-after", "600")
+        .set_body_json(json!({"error": {"message": "temporarily unavailable"}}));
+    wiremock::Mock::given(wiremock::matchers::method("GET"))
+        .and(wiremock::matchers::path_regex(".*/responses$"))
+        .respond_with(busy.clone())
+        .mount(&server)
+        .await;
+    let http = mount_response_sequence(
+        &server,
+        vec![
+            busy,
+            sse_response(sse(vec![
+                ev_assistant_message("recovered", "done"),
+                ev_completed("response-done"),
+            ])),
+        ],
+    )
+    .await;
+    let base_url = format!("{}/v1", server.uri());
+    let mut builder = test_codex()
+        .with_pre_build_hook(write_model_request_failure_hooks)
+        .with_config(move |config| {
+            config.model_provider.base_url = Some(base_url);
+            config.model_provider.supports_websockets = true;
+            config.model_provider.request_max_retries = Some(0);
+            config.model_provider.stream_max_retries = Some(0);
+            config.codex_patch.transient_request_recovery_limit = Some(RecoveryLimit::Limited(1));
+            config.codex_patch.recovery_max_wait_ms = std::num::NonZeroU64::new(10);
+            trust_discovered_hooks(config);
+        });
+    let test = builder.build_with_auto_env(&server).await?;
+    test.submit_turn("recover across transports").await?;
+    let requests = server.received_requests().await.unwrap_or_default();
+    assert_eq!(
+        requests
+            .iter()
+            .filter(|request| request.method == http::Method::GET
+                && request.url.path().ends_with("/responses"))
+            .count(),
+        3,
+        "one prewarm and two visible websocket attempts"
+    );
+    assert_eq!(
+        http.requests().len(),
+        2,
+        "HTTP must receive its own retry after websocket exhaustion"
+    );
+    let hooks = wait_for_model_request_failure_inputs(&test.codex_home_path(), 3).await;
+    assert_eq!(
+        hooks.len(),
+        3,
+        "prewarm must not consume the visible budget or emit a hook"
+    );
+    for (index, action) in ["retry", "fallback", "retry"].into_iter().enumerate() {
+        assert_eq!(hooks[index]["hookEventName"], "ModelRequestRecovery");
+        assert_eq!(hooks[index]["nextAction"], action);
+        assert_eq!(hooks[index]["attempt"], index + 1);
+    }
+    Ok(())
+}
