+fn write_model_request_failure_hooks(home: &Path) {
+    let script_path = home.join("model_request_failure.py");
+    let log_path = home.join("model_request_failure_log.jsonl");
+    let script = format!(
+        r#"import json
+from pathlib import Path
+import sys
+
+payload = json.load(sys.stdin)
+with Path(r"{log_path}").open("a", encoding="utf-8") as handle:
+    handle.write(json.dumps(payload) + "\n")
+"#,
+        log_path = log_path.display(),
+    );
+    let command = python_hook_command(&script_path);
+    let hooks = json!({
+        "hooks": {
+            "ModelRequestRecovery": [{
+                "hooks": [{
+                    "type": "command",
+                    "command": command,
+                }]
+            }],
+            "ModelRequestFailed": [{
+                "hooks": [{
+                    "type": "command",
+                    "command": python_hook_command(&script_path),
+                }]
+            }]
+        }
+    });
+
+    fs::write(&script_path, script).expect("write model request failure hook script");
+    fs::write(home.join("hooks.json"), hooks.to_string()).expect("write hooks.json");
+}
+
+async fn wait_for_model_request_failure_inputs(home: &Path, count: usize) -> Vec<Value> {
+    let log_path = home.join("model_request_failure_log.jsonl");
+    let result = tokio::time::timeout(std::time::Duration::from_secs(10), async {
+        loop {
+            if log_path.exists() {
+                let inputs = read_hook_inputs(&log_path);
+                if inputs.len() >= count {
+                    return inputs;
+                }
+            }
+            tokio::time::sleep(std::time::Duration::from_millis(10)).await;
+        }
+    })
+    .await;
+    match result {
+        Ok(inputs) => inputs,
+        Err(_) => {
+            let observed = if log_path.exists() {
+                read_hook_inputs(&log_path)
+            } else {
+                Vec::new()
+            };
+            panic!(
+                "model request failure hooks should complete: expected at least {count}, observed {observed:?}"
+            );
+        }
+    }
+}
