+    fn overloaded(retry_after_ms: Option<u64>) -> CodexErr {
+        CodexErr::server_overloaded(ServerOverloadInfo {
+            code: Some("server_is_overloaded".to_string()),
+            http_status: Some(503),
+            message: "busy".to_string(),
+            retry_after_ms,
+        })
+    }
+
+    fn unexpected(status: StatusCode) -> CodexErr {
+        CodexErr::UnexpectedStatus(UnexpectedResponseError {
+            status,
+            body: String::new(),
+            user_message: None,
+            url: None,
+            cf_ray: None,
+            request_id: None,
+            identity_authorization_error: None,
+            identity_error_code: None,
+        })
+    }
+
+    #[test]
+    fn codex_patch_classification_is_narrow_and_prioritized() {
+        assert_eq!(
+            recovery_class(&overloaded(None)),
+            Some(RecoveryClass::ServerOverload)
+        );
+        assert_eq!(
+            recovery_class(&unexpected(StatusCode::SERVICE_UNAVAILABLE)),
+            Some(RecoveryClass::Transient)
+        );
+        assert_eq!(
+            recovery_class(&unexpected(StatusCode::TOO_MANY_REQUESTS)),
+            Some(RecoveryClass::Transient)
+        );
+        assert_eq!(recovery_class(&unexpected(StatusCode::BAD_REQUEST)), None);
+        assert_eq!(recovery_class(&CodexErr::InternalAgentDied), None);
+    }
+
+    #[test]
+    fn codex_patch_limits_are_per_target_and_category() {
+        let config = CodexPatchConfig {
+            transient_request_recovery_limit: Some(RecoveryLimit::Limited(1)),
+            server_overload_recovery_limit: Some(RecoveryLimit::Unlimited),
+            ..Default::default()
+        };
+        let mut state = ModelRequestRecoveryState::default();
+
+        let first = state.observe_failure("model-a/http", &config, &CodexErr::RequestTimeout);
+        let second = state.observe_failure("model-a/http", &config, &CodexErr::RequestTimeout);
+        let fallback = state.observe_failure("model-b/http", &config, &CodexErr::RequestTimeout);
+        let overload = state.observe_failure("model-a/http", &config, &overloaded(None));
+
+        assert!(
+            first
+                .configured_recovery
+                .expect("configured")
+                .should_retry()
+        );
+        assert!(
+            !second
+                .configured_recovery
+                .expect("configured")
+                .should_retry()
+        );
+        assert!(
+            fallback
+                .configured_recovery
+                .expect("configured")
+                .should_retry()
+        );
+        assert!(
+            overload
+                .configured_recovery
+                .expect("configured")
+                .should_retry()
+        );
+        assert_eq!(overload.attempt, 4);
+    }
+
+    #[test]
+    fn codex_patch_missing_and_zero_limits_are_distinct() {
+        let mut state = ModelRequestRecoveryState::default();
+        let missing_config = CodexPatchConfig::default();
+        let missing = state.observe_failure("target", &missing_config, &CodexErr::RequestTimeout);
+        assert_eq!(missing.configured_recovery, None);
+        assert!(fallback_permitted_after_exhaustion(
+            &missing_config,
+            &CodexErr::RequestTimeout
+        ));
+
+        let zero_config = CodexPatchConfig {
+            transient_request_recovery_limit: Some(RecoveryLimit::Limited(0)),
+            ..Default::default()
+        };
+        let zero = state.observe_failure("target", &zero_config, &CodexErr::RequestTimeout);
+        let zero = zero.configured_recovery.expect("configured");
+        assert!(!zero.should_retry());
+        assert!(!zero.permits_fallback());
+        assert!(!fallback_permitted_after_exhaustion(
+            &zero_config,
+            &CodexErr::RequestTimeout
+        ));
+
+        let finite_config = CodexPatchConfig {
+            transient_request_recovery_limit: Some(RecoveryLimit::Limited(1)),
+            ..Default::default()
+        };
+        assert!(fallback_permitted_after_exhaustion(
+            &finite_config,
+            &CodexErr::RequestTimeout
+        ));
+    }
+
+    #[test]
+    fn codex_patch_one_cap_bounds_provider_advice_and_local_backoff() {
+        let recovery = ConfiguredRecovery {
+            class: RecoveryClass::ServerOverload,
+            failure_count: 64,
+            limit: RecoveryLimit::Unlimited,
+        };
+        for (cap, expected_max) in [(None, 120_000), (std::num::NonZeroU64::new(10_000), 10_000)] {
+            let config = CodexPatchConfig {
+                recovery_max_wait_ms: cap,
+                ..Default::default()
+            };
+            for (advice, expected) in [
+                (Some(0), 0),
+                (Some(250), 250),
+                (Some(u64::MAX), expected_max),
+                (None, expected_max),
+            ] {
+                assert_eq!(
+                    configured_retry_delay(&config, &overloaded(advice), recovery),
