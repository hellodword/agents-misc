+//! Shared opt-in recovery policy for model requests.
+//!
+//! The pinned producer state machines remain authoritative when a matching
+//! `codex_patch` limit is absent. When a limit is present, it replaces that
+//! producer's Core-level retry budget for the matching error category.
+
+use std::collections::HashMap;
+use std::future::Future;
+use std::time::Duration;
+
+use codex_config::config_toml::CodexPatchConfig;
+use codex_config::config_toml::RecoveryLimit;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::CodexErrorDetails;
+use tokio_util::sync::CancellationToken;
+
+use crate::util::backoff;
+
+/// Long waits are split into bounded sleeps so cancellation remains prompt.
+const MAX_WAIT_CHUNK: Duration = Duration::from_secs(60);
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub(crate) enum RecoveryClass {
+    UsageLimit,
+    ServerOverload,
+    Transient,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) struct ConfiguredRecovery {
+    pub(crate) class: RecoveryClass,
+    pub(crate) failure_count: u64,
+    pub(crate) limit: RecoveryLimit,
+}
+
+impl ConfiguredRecovery {
+    pub(crate) fn should_retry(self) -> bool {
+        match self.limit {
+            RecoveryLimit::Limited(limit) => self.failure_count <= limit,
+            RecoveryLimit::Unlimited => true,
+        }
+    }
+
+    pub(crate) fn is_unlimited(self) -> bool {
+        self.limit == RecoveryLimit::Unlimited
+    }
+
+    pub(crate) fn permits_fallback(self) -> bool {
+        matches!(self.limit, RecoveryLimit::Limited(limit) if limit > 0)
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) struct FailureObservation {
+    pub(crate) attempt: u64,
+    pub(crate) configured_recovery: Option<ConfiguredRecovery>,
+}
+
+/// Counts Core-visible failures globally for Hook payloads and separately by
+/// target/category for configured recovery limits.
+#[derive(Debug, Default)]
+pub(crate) struct ModelRequestRecoveryState {
+    failure_attempt: u64,
+    recovery_counts: HashMap<(String, RecoveryClass), u64>,
+}
+
+impl ModelRequestRecoveryState {
+    pub(crate) fn failure_attempt(&self) -> u64 {
+        self.failure_attempt
+    }
+
+    pub(crate) fn observe_failure(
+        &mut self,
+        target: impl Into<String>,
+        config: &CodexPatchConfig,
+        error: &CodexErr,
+    ) -> FailureObservation {
+        self.failure_attempt = self.failure_attempt.saturating_add(1).max(1);
+        let configured_recovery = recovery_class(error).and_then(|class| {
+            let limit = configured_limit(config, class)?;
+            let count = self
+                .recovery_counts
+                .entry((target.into(), class))
+                .or_default();
+            *count = count.saturating_add(1).max(1);
+            Some(ConfiguredRecovery {
+                class,
+                failure_count: *count,
+                limit,
+            })
+        });
+        FailureObservation {
+            attempt: self.failure_attempt,
+            configured_recovery,
+        }
+    }
+}
+
+pub(crate) fn recovery_class(error: &CodexErr) -> Option<RecoveryClass> {
+    match error.details() {
+        // Keep this deliberately narrower than the Hook's `usageLimit`
+        // category: only the recoverable server response participates.
+        CodexErrorDetails::UsageLimitReached(_) => Some(RecoveryClass::UsageLimit),
+        CodexErrorDetails::ServerOverloaded => Some(RecoveryClass::ServerOverload),
+        CodexErrorDetails::Stream(_)
+        | CodexErrorDetails::ResponseStreamFailed(_)
+        | CodexErrorDetails::ConnectionFailed(_)
+        | CodexErrorDetails::Io(_)
+        | CodexErrorDetails::Timeout
+        | CodexErrorDetails::RequestTimeout
+        | CodexErrorDetails::RateLimitExceeded(_)
+        | CodexErrorDetails::InternalServerError => Some(RecoveryClass::Transient),
+        CodexErrorDetails::UnexpectedStatus(response)
+            if is_transient_status(response.status.as_u16()) =>
+        {
+            Some(RecoveryClass::Transient)
+        }
+        CodexErrorDetails::RetryLimit(response)
+            if is_transient_status(response.status.as_u16()) =>
+        {
+            Some(RecoveryClass::Transient)
+        }
+        _ => None,
+    }
+}
+
+pub(crate) fn has_configured_recovery(config: &CodexPatchConfig, error: &CodexErr) -> bool {
+    recovery_class(error)
+        .and_then(|class| configured_limit(config, class))
+        .is_some()
+}
+
+/// Preserve an existing producer fallback unless an explicit zero budget
+/// disables recovery for the matching category. Finite positive budgets reach
+/// this boundary only after their retries are exhausted; unlimited recovery
+/// does not reach it.
+pub(crate) fn fallback_permitted_after_exhaustion(
+    config: &CodexPatchConfig,
+    error: &CodexErr,
+) -> bool {
+    !matches!(
+        recovery_class(error).and_then(|class| configured_limit(config, class)),
+        Some(RecoveryLimit::Limited(0))
+    )
+}
+
+fn is_transient_status(status: u16) -> bool {
+    status == 408 || status == 429 || (500..=599).contains(&status)
+}
+
+fn configured_limit(config: &CodexPatchConfig, class: RecoveryClass) -> Option<RecoveryLimit> {
+    match class {
+        RecoveryClass::UsageLimit => config.usage_limit_recovery_limit,
+        RecoveryClass::ServerOverload => config.server_overload_recovery_limit,
+        RecoveryClass::Transient => config.transient_request_recovery_limit,
+    }
+}
+
+/// Bound both provider advice and local backoff with the same opt-in policy.
+pub(crate) fn configured_retry_delay(
+    config: &CodexPatchConfig,
+    error: &CodexErr,
+    recovery: ConfiguredRecovery,
+) -> Duration {
+    error
+        .recovery_retry_delay()
+        .unwrap_or_else(|| {
+            // The local delay reaches the cap long before this bound. Limiting
+            // the exponent also keeps an unlimited counter out of `powi`'s
+            // narrowing conversion after extremely long sessions.
+            backoff(recovery.failure_count.clamp(1, 64))
+        })
+        .min(config.recovery_max_wait())
+}
+
+/// Wait cancellably, including before the first chunk and after the final one.
+pub(crate) async fn wait_for_retry(
+    delay: Duration,
+    cancellation_token: &CancellationToken,
+) -> Result<(), CodexErr> {
+    if cancellation_token.is_cancelled() {
+        return Err(CodexErr::TurnAborted);
+    }
+
+    let mut remaining = delay;
+    while !remaining.is_zero() {
+        let chunk = remaining.min(MAX_WAIT_CHUNK);
+        wait_for_retry_with(cancellation_token, tokio::time::sleep(chunk)).await?;
+        remaining = remaining.saturating_sub(chunk);
+    }
+
+    if cancellation_token.is_cancelled() {
+        Err(CodexErr::TurnAborted)
+    } else {
+        Ok(())
+    }
+}
+
+async fn wait_for_retry_with(
+    cancellation_token: &CancellationToken,
+    sleeper: impl Future<Output = ()>,
+) -> Result<(), CodexErr> {
+    if cancellation_token.is_cancelled() {
+        return Err(CodexErr::TurnAborted);
+    }
+
+    tokio::pin!(sleeper);
+    tokio::select! {
+        biased;
+        _ = cancellation_token.cancelled() => return Err(CodexErr::TurnAborted),
+        _ = &mut sleeper => {}
+    }
+
+    if cancellation_token.is_cancelled() {
+        Err(CodexErr::TurnAborted)
+    } else {
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use codex_protocol::error::ServerOverloadInfo;
