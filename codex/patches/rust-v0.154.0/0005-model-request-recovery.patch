@@ -0,0 +1,266 @@
+//! Shared policy primitives for model-request capacity recovery.
+//!
+//! Producers retain their own bounded retry and fallback state machines. This
+//! module only classifies typed capacity failures and supplies the persistent
+//! policy's quick-retry/defer transition, delay selection, and cancellable wait.
+
+use std::future::Future;
+use std::time::Duration;
+
+use codex_hooks::ModelRequestNextAction;
+use codex_model_provider_info::ServerOverloadPolicy;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::CodexErrorDetails;
+use tokio_util::sync::CancellationToken;
+
+use crate::util::backoff;
+
+/// A provider may ask for a longer delay, but each persistent recovery wait is
+/// capped so cancellation and shutdown remain observable.
+pub const MAX_RECOVERY_DELAY: Duration = Duration::from_secs(60);
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct RecoveryDecision {
+    pub next_action: ModelRequestNextAction,
+    /// `None` means persistent recovery has left the producer's quick budget.
+    pub retry_budget: Option<u64>,
+    pub delay: Duration,
+}
+
+/// Returns true only for the typed semantic capacity category. Generic HTTP
+/// 503 values and message text never classify as capacity here.
+pub fn is_capacity_error(error: &CodexErr) -> bool {
+    matches!(error.details(), CodexErrorDetails::ServerOverloaded)
+}
+
+pub fn is_persistent_capacity_error(error: &CodexErr, policy: ServerOverloadPolicy) -> bool {
+    policy == ServerOverloadPolicy::Persistent && is_capacity_error(error)
+}
+
+/// Select the persistent policy transition for one actual failed request.
+/// Bounded capacity and non-capacity failures return `None` so the producer's
+/// pinned v0.154.0 state machine remains authoritative.
+pub fn persistent_capacity_decision(
+    error: &CodexErr,
+    policy: ServerOverloadPolicy,
+    attempt: u64,
+    retry_budget: Option<u64>,
+) -> Option<RecoveryDecision> {
+    if !is_persistent_capacity_error(error, policy) {
+        return None;
+    }
+
+    let attempt = attempt.max(1);
+    let next_action = match retry_budget {
+        Some(budget) if attempt <= budget => ModelRequestNextAction::Retry,
+        Some(_) | None => ModelRequestNextAction::Defer,
+    };
+    Some(RecoveryDecision {
+        next_action,
+        retry_budget: if next_action == ModelRequestNextAction::Defer {
+            None
+        } else {
+            retry_budget
+        },
+        delay: retry_delay(error, attempt),
+    })
+}
+
+/// Compute provider-advised or jittered exponential delay, capped at one
+/// minute. Existing `backoff` supplies the short retry delay when no advice is
+/// present.
+pub fn retry_delay(error: &CodexErr, attempt: u64) -> Duration {
+    retry_delay_with(error, || backoff(attempt.max(1)))
+}
+
+fn retry_delay_with(error: &CodexErr, fallback: impl FnOnce() -> Duration) -> Duration {
+    error
+        .server_overload_info()
+        .and_then(|info| info.retry_delay())
+        .or_else(|| error.retry_delay())
+        .unwrap_or_else(fallback)
+        .min(MAX_RECOVERY_DELAY)
+}
+
+/// Wait without making cancellation pay the full retry delay. Cancellation is
+/// checked before polling the sleeper, during the wait, and once more before a
+/// producer is allowed to issue its next request.
+pub async fn wait_for_retry(
+    delay: Duration,
+    cancellation_token: &CancellationToken,
+) -> Result<(), CodexErr> {
+    wait_for_retry_with(cancellation_token, tokio::time::sleep(delay)).await
+}
+
+async fn wait_for_retry_with(
+    cancellation_token: &CancellationToken,
+    sleeper: impl Future<Output = ()>,
+) -> Result<(), CodexErr> {
+    if cancellation_token.is_cancelled() {
+        return Err(CodexErr::TurnAborted);
+    }
+
+    tokio::pin!(sleeper);
+    tokio::select! {
+        biased;
+        _ = cancellation_token.cancelled() => return Err(CodexErr::TurnAborted),
+        _ = &mut sleeper => {}
+    }
+
+    if cancellation_token.is_cancelled() {
+        Err(CodexErr::TurnAborted)
+    } else {
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use codex_protocol::error::ServerOverloadInfo;
+    use std::sync::Arc;
+    use std::sync::atomic::AtomicUsize;
+    use std::sync::atomic::Ordering;
+
+    fn overloaded(retry_after_ms: Option<u64>) -> CodexErr {
+        CodexErr::server_overloaded(ServerOverloadInfo {
+            code: Some("server_is_overloaded".to_string()),
+            message: "busy".to_string(),
+            retry_after_ms,
+        })
+    }
+
+    #[test]
+    fn max_retries_two_retries_failures_one_and_two_then_defers() {
+        let error = overloaded(Some(0));
+        let mut retry_budget = Some(2);
+        let actions = (1..=5)
+            .map(|attempt| {
+                let decision = persistent_capacity_decision(
+                    &error,
+                    ServerOverloadPolicy::Persistent,
+                    attempt,
+                    retry_budget,
+                )
+                .expect("persistent capacity decision");
+                retry_budget = decision.retry_budget;
+                decision
+            })
+            .collect::<Vec<_>>();
+
+        assert_eq!(actions[0].next_action, ModelRequestNextAction::Retry);
+        assert_eq!(actions[1].next_action, ModelRequestNextAction::Retry);
+        for decision in &actions[2..] {
+            assert_eq!(decision.next_action, ModelRequestNextAction::Defer);
+            assert_eq!(decision.retry_budget, None);
+        }
+    }
+
+    #[test]
+    fn bounded_capacity_and_non_capacity_stay_with_the_producer() {
+        assert!(
+            persistent_capacity_decision(
+                &overloaded(None),
+                ServerOverloadPolicy::Bounded,
+                1,
+                Some(2),
+            )
+            .is_none()
+        );
+        assert!(
+            persistent_capacity_decision(
+                &CodexErr::Stream("disconnected".to_string()),
+                ServerOverloadPolicy::Persistent,
+                1,
+                Some(2),
+            )
+            .is_none()
+        );
+    }
+
+    #[test]
+    fn provider_advice_and_fallback_backoff_are_capped() {
+        assert_eq!(
+            retry_delay_with(&overloaded(Some(120_000)), || Duration::from_secs(1)),
+            MAX_RECOVERY_DELAY
+        );
+        assert_eq!(
+            retry_delay_with(&overloaded(None), || Duration::from_millis(375)),
+            Duration::from_millis(375)
+        );
+        assert_eq!(
+            retry_delay_with(&overloaded(None), || Duration::from_secs(90)),
+            MAX_RECOVERY_DELAY
+        );
+    }
+
+    #[test]
+    fn generic_503_is_not_capacity() {
+        let generic = CodexErr::UnexpectedStatus(codex_protocol::error::UnexpectedResponseError {
+            status: http::StatusCode::SERVICE_UNAVAILABLE,
+            body: "Selected model is at capacity".to_string(),
+            user_message: None,
+            url: None,
+            cf_ray: None,
+            request_id: None,
+            identity_authorization_error: None,
+            identity_error_code: None,
+        });
+        assert!(!is_capacity_error(&generic));
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn cancellation_before_wait_skips_the_sleeper() {
+        let token = CancellationToken::new();
+        token.cancel();
+        let sleeper_polls = Arc::new(AtomicUsize::new(0));
+        let sleeper_polls_for_future = Arc::clone(&sleeper_polls);
+        let result = wait_for_retry_with(&token, async move {
+            sleeper_polls_for_future.fetch_add(1, Ordering::SeqCst);
+        })
+        .await;
+
+        assert!(
+            matches!(result, Err(error) if matches!(error.details(), CodexErrorDetails::TurnAborted))
+        );
+        assert_eq!(sleeper_polls.load(Ordering::SeqCst), 0);
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn cancellation_during_wait_ends_without_advancing_time() {
+        let token = CancellationToken::new();
+        let waiting_token = token.clone();
+        let started_at = tokio::time::Instant::now();
+        let wait =
+            tokio::spawn(
+                async move { wait_for_retry(Duration::from_secs(60), &waiting_token).await },
+            );
+        tokio::task::yield_now().await;
+        token.cancel();
+
+        let result = wait.await.expect("wait task should join");
+        assert!(
+            matches!(result, Err(error) if matches!(error.details(), CodexErrorDetails::TurnAborted))
+        );
+        assert_eq!(tokio::time::Instant::now(), started_at);
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn cancellation_after_sleeper_prevents_the_next_request() {
+        let token = CancellationToken::new();
+        let sleeper_token = token.clone();
+        let request_count = AtomicUsize::new(0);
+        let result = wait_for_retry_with(&token, async move {
+            sleeper_token.cancel();
+        })
+        .await;
+        if result.is_ok() {
+            request_count.fetch_add(1, Ordering::SeqCst);
+        }
+
+        assert!(
+            matches!(result, Err(error) if matches!(error.details(), CodexErrorDetails::TurnAborted))
+        );
+        assert_eq!(request_count.load(Ordering::SeqCst), 0);
+    }
+}
