+#[test]
+fn bounded_sampling_max_retries_two_retries_failures_one_and_two() {
+    let mut state = super::ResponsesStreamRetryState::default();
+
+    assert_eq!(state.record_failure(), 1);
+    assert_eq!(state.begin_transport_retry(/*max_retries*/ 2), Some(1));
+    assert_eq!(state.record_failure(), 2);
+    assert_eq!(state.begin_transport_retry(/*max_retries*/ 2), Some(2));
+    assert_eq!(state.record_failure(), 3);
+    assert_eq!(state.begin_transport_retry(/*max_retries*/ 2), None);
+}
+
+#[test]
+fn transport_fallback_resets_only_the_transport_counter() {
+    let mut state = super::ResponsesStreamRetryState::default();
+
+    assert_eq!(state.record_failure(), 1);
+    assert_eq!(state.begin_transport_retry(/*max_retries*/ 1), Some(1));
+    state.reset_transport_retries();
+    assert_eq!(state.retries, 0);
+    assert_eq!(state.failure_attempt(), 1);
+
+    assert_eq!(state.record_failure(), 2);
+    assert_eq!(state.begin_transport_retry(/*max_retries*/ 1), Some(1));
+}
