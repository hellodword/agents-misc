+/// Run the legacy remote compact request through the same typed capacity
+/// recovery policy as sampling and Responses compaction v2. This wrapper owns
+/// the retry/defer loop for one model while the caller retains the pinned
+/// primary/alternate relationship.
+async fn run_remote_compact_attempt_with_policy(
+    sess: &Arc<Session>,
+    step_context: &Arc<StepContext>,
+    turn_state: Option<Arc<OnceLock<String>>>,
+    compaction_trace: &codex_rollout_trace::CompactionTraceContext,
+    compaction_metadata: CompactionTurnMetadata,
+    analytics_details: &mut CompactionAnalyticsDetails,
+    cancellation_token: &CancellationToken,
+    failure_attempt: &mut u64,
+) -> CodexResult<RemoteCompactAttempt> {
+    let retry_budget = step_context.turn.provider.info().request_max_retries();
+    loop {
+        if cancellation_token.is_cancelled() {
+            return Err(CodexErr::TurnAborted);
+        }
+        match run_remote_compact_attempt(
+            sess,
+            step_context,
+            turn_state.clone(),
+            compaction_trace,
+            compaction_metadata,
+            analytics_details,
+        )
+        .await
+        {
+            Ok(result) => return Ok(result),
+            Err(error) => {
+                if matches!(
+                    error.details(),
+                    codex_protocol::error::CodexErrorDetails::TurnAborted
+                ) {
+                    return Err(error);
+                }
+                *failure_attempt = (*failure_attempt).saturating_add(1).max(1);
+                if !is_persistent_capacity_error(
+                    &error,
+                    step_context.turn.provider.info().server_overload_policy,
+                ) {
+                    return Err(error);
+                }
+                let decision = persistent_capacity_decision(
+                    &error,
+                    step_context.turn.provider.info().server_overload_policy,
+                    *failure_attempt,
+                    Some(retry_budget),
+                )
+                .expect("persistent capacity guard must produce a decision");
+                run_request_error_hooks(
+                    sess,
+                    &step_context.turn,
+                    ModelRequestFailure::new(
+                        ModelRequestHookContext::remote_compact(),
+                        *failure_attempt,
+                        decision.retry_budget,
+                        decision.next_action,
+                        &error,
+                    ),
+                )
+                .await;
+                wait_for_retry(decision.delay, cancellation_token).await?;
+                if cancellation_token.is_cancelled() {
+                    return Err(CodexErr::TurnAborted);
+                }
+                sess.send_event(
+                    &step_context.turn,
+                    EventMsg::Warning(WarningEvent {
+                        message: format!(
+                            "Model capacity is temporarily unavailable during compaction; waiting to retry ({:?}).",
+                            decision.delay
+                        ),
+                    }),
+                )
+                .await;
+            }
+        }
+    }
+}
+
+async fn run_remote_compact_failure_hooks(
+    sess: &Arc<Session>,
+    turn_context: &Arc<TurnContext>,
+    next_action: codex_hooks::ModelRequestNextAction,
+    err: &CodexErr,
+    attempt: u64,
+) {
+    let failure = ModelRequestFailure::new(
+        ModelRequestHookContext::remote_compact(),
+        attempt,
+        Some(turn_context.provider.info().request_max_retries()),
+        next_action,
+        err,
+    );
+    if next_action == codex_hooks::ModelRequestNextAction::Stop {
+        run_terminal_model_request_failure_hooks(sess, turn_context, failure).await;
+    } else {
+        run_request_error_hooks(sess, turn_context, failure).await;
+    }
+}
