+async fn wait_for_model_request_failure_inputs(home: &Path, count: usize) -> Vec<Value> {
+    let log_path = home.join("model_request_failure_log.jsonl");
+    let result = tokio::time::timeout(std::time::Duration::from_secs(10), async {
+        loop {
+            if log_path.exists() {
+                let inputs = read_hook_inputs(&log_path);
+                if inputs.len() >= count {
+                    return inputs;
+                }
+            }
+            tokio::time::sleep(std::time::Duration::from_millis(10)).await;
+        }
+    })
+    .await;
+    match result {
+        Ok(inputs) => inputs,
+        Err(_) => {
+            let observed = if log_path.exists() {
+                read_hook_inputs(&log_path)
+            } else {
+                Vec::new()
+            };
+            panic!(
+                "model request failure hooks should complete: expected at least {count}, observed {observed:?}"
+            );
+        }
+    }
+}
