+
+    pub(crate) fn record_failure(&mut self) -> u64 {
+        self.failure_attempt = self.failure_attempt.saturating_add(1).max(1);
+        self.failure_attempt
+    }
+
+    fn begin_transport_retry(&mut self, max_retries: u64) -> Option<u64> {
