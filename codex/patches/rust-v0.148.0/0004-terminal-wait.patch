+    let (_, control) = gate
+        .begin_action(TerminalWaitAction::Continue, /*expected*/ None)
+        .expect("decision should accept one control action");
+    assert!(matches!(
+        gate.begin_action(TerminalWaitAction::Interrupt, /*expected*/ None),
+        Err(UnifiedExecError::TerminalWaitDecisionUnavailable { process_id: 41, .. })
+    ));
+    drop(control);
+    assert_eq!(
+        gate.snapshot().map(|snapshot| snapshot.phase),
+        Some(TerminalWaitPhase::DecisionRequired)
+    );
