+use regex_lite::Regex;
+use schemars::JsonSchema;
+use serde::Deserialize;
+use serde::Deserializer;
+use serde::Serialize;
+use serde::de::Error as SerdeError;
+
+#[derive(Serialize, Deserialize, Debug, Clone, Default, PartialEq, Eq, JsonSchema)]
+#[serde(deny_unknown_fields)]
+#[schemars(deny_unknown_fields)]
+pub struct TerminalWaitToml {
+    #[serde(default)]
+    pub commands: Vec<TerminalWaitCommandToml>,
+}
+
+impl TerminalWaitToml {
+    pub fn has_enabled_commands(&self) -> bool {
+        self.commands.iter().any(|command| command.enabled)
+    }
+}
+
+#[derive(Serialize, Debug, Clone, PartialEq, Eq, JsonSchema)]
+#[schemars(deny_unknown_fields)]
+pub struct TerminalWaitCommandToml {
+    pub pattern: String,
+    #[schemars(range(min = 1))]
+    pub poll_interval_ms: u64,
+    pub name: Option<String>,
+    #[serde(default = "default_true")]
+    pub enabled: bool,
+    pub cwd_pattern: Option<String>,
+    #[schemars(range(min = 1))]
+    pub max_output_tokens: Option<usize>,
+}
+
+const fn default_true() -> bool {
+    true
+}
+
+impl<'de> Deserialize<'de> for TerminalWaitCommandToml {
+    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>
+    where
+        D: Deserializer<'de>,
+    {
+        #[derive(Deserialize)]
+        #[serde(deny_unknown_fields)]
+        struct RawTerminalWaitCommandToml {
+            pattern: String,
+            poll_interval_ms: u64,
+            name: Option<String>,
+            #[serde(default = "default_true")]
+            enabled: bool,
+            cwd_pattern: Option<String>,
+            max_output_tokens: Option<usize>,
+        }
+
+        let raw = RawTerminalWaitCommandToml::deserialize(deserializer)?;
+        validate_regex("pattern", &raw.pattern).map_err(D::Error::custom)?;
+        if let Some(cwd_pattern) = raw.cwd_pattern.as_deref() {
+            validate_regex("cwd_pattern", cwd_pattern).map_err(D::Error::custom)?;
+        }
+        if raw.poll_interval_ms == 0 {
+            return Err(D::Error::custom("poll_interval_ms must be greater than 0"));
+        }
+        if raw.max_output_tokens == Some(0) {
+            return Err(D::Error::custom("max_output_tokens must be greater than 0"));
+        }
+
+        Ok(Self {
+            pattern: raw.pattern,
+            poll_interval_ms: raw.poll_interval_ms,
+            name: raw.name,
+            enabled: raw.enabled,
+            cwd_pattern: raw.cwd_pattern,
+            max_output_tokens: raw.max_output_tokens,
+        })
+    }
+}
+
+fn validate_regex(field: &str, pattern: &str) -> Result<(), String> {
+    Regex::new(pattern)
+        .map(|_| ())
+        .map_err(|err| format!("{field} is not a valid regex-lite pattern: {err}"))
+}
+
+#[cfg(test)]
+mod tests {
+    use crate::config_toml::ConfigToml;
+
+    #[test]
+    fn terminal_wait_deserializes_command() {
+        let config: ConfigToml = toml::from_str(
+            r#"
+            [terminal_wait]
+
+            [[terminal_wait.commands]]
+            name = "cargo"
+            pattern = "cargo test"
+            cwd_pattern = "/repo"
+            enabled = false
+            poll_interval_ms = 60000
+            max_output_tokens = 2000
+            "#,
+        )
+        .expect("terminal_wait should parse");
+
+        let terminal_wait = config.terminal_wait.expect("terminal_wait should be set");
+        let command = &terminal_wait.commands[0];
+        assert_eq!(command.name.as_deref(), Some("cargo"));
+        assert_eq!(command.pattern, "cargo test");
+        assert_eq!(command.cwd_pattern.as_deref(), Some("/repo"));
+        assert!(!command.enabled);
+        assert_eq!(command.poll_interval_ms, 60000);
+        assert_eq!(command.max_output_tokens, Some(2000));
+        assert!(!terminal_wait.has_enabled_commands());
+    }
+
+    #[test]
+    fn terminal_wait_defaults_command_to_enabled() {
+        let config: ConfigToml = toml::from_str(
+            r#"
+            [[terminal_wait.commands]]
+            pattern = "cargo test"
+            poll_interval_ms = 1000
+            "#,
+        )
+        .expect("terminal_wait should parse");
+
+        let terminal_wait = config.terminal_wait.expect("terminal_wait should be set");
+        assert!(terminal_wait.commands[0].enabled);
+        assert!(terminal_wait.has_enabled_commands());
+    }
+
+    #[test]
+    fn terminal_wait_rejects_invalid_regex() {
+        let err = toml::from_str::<ConfigToml>(
+            r#"
+            [[terminal_wait.commands]]
+            pattern = "["
+            poll_interval_ms = 1000
+            "#,
+        )
+        .expect_err("invalid regex should fail");
+
+        assert!(
+            err.to_string()
+                .contains("pattern is not a valid regex-lite pattern")
+        );
+    }
+
+    #[test]
+    fn terminal_wait_rejects_missing_or_non_positive_poll_interval() {
+        for (toml, expected) in [
+            (
+                r#"
+                [[terminal_wait.commands]]
+                pattern = "cargo"
+                "#,
+                "missing field `poll_interval_ms`",
+            ),
+            (
+                r#"
+                [[terminal_wait.commands]]
+                pattern = "cargo"
+                poll_interval_ms = 0
+                "#,
+                "poll_interval_ms must be greater than 0",
+            ),
+        ] {
+            let err = toml::from_str::<ConfigToml>(toml).expect_err("config should fail");
+            assert!(
+                err.to_string().contains(expected),
+                "expected {expected:?} in {err}"
+            );
+        }
+    }
+
+    #[test]
+    fn terminal_wait_rejects_removed_fields() {
+        for removed_field in [
+            r#"mode = "long_poll""#,
+            "wait_timeout_ms = 1000",
+            "allow_tty = true",
+        ] {
+            let toml = format!(
+                r#"
+                [[terminal_wait.commands]]
+                pattern = "cargo"
+                poll_interval_ms = 1000
+                {removed_field}
+                "#
+            );
+            let err = toml::from_str::<ConfigToml>(&toml).expect_err("config should fail");
+            assert!(
+                err.to_string().contains("unknown field"),
+                "expected unknown field error in {err}"
+            );
+        }
+    }
+
+    #[test]
+    fn terminal_wait_rejects_zero_output_limit() {
+        let err = toml::from_str::<ConfigToml>(
+            r#"
+            [[terminal_wait.commands]]
+            pattern = "cargo"
+            poll_interval_ms = 1000
+            max_output_tokens = 0
+            "#,
+        )
+        .expect_err("config should fail");
+
+        assert!(
+            err.to_string()
+                .contains("max_output_tokens must be greater than 0")
+        );
+    }
+}
