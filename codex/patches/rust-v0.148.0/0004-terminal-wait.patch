+#[test]
+fn terminal_wait_gate_cancellation_returns_a_stored_process_to_decision() {
+    let gate = Arc::new(TerminalWaitGate::default());
+    let mut reservation = gate
+        .reserve(/*process_id*/ 41, /*poll_interval_ms*/ 2_000)
+        .expect("managed command should reserve the gate");
