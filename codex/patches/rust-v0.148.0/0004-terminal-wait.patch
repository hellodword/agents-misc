+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum TerminalWaitPhase {
+    PendingStart,
+    Waiting,
+    DecisionRequired,
+    Interrupting,
+    Terminating,
+}
+
+impl std::fmt::Display for TerminalWaitPhase {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        let value = match self {
+            Self::PendingStart => "pending_start",
+            Self::Waiting => "waiting",
+            Self::DecisionRequired => "decision_required",
+            Self::Interrupting => "interrupting",
+            Self::Terminating => "terminating",
+        };
+        formatter.write_str(value)
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct TerminalWaitGateSnapshot {
+    process_id: i32,
+    poll_interval_ms: u64,
+    phase: TerminalWaitPhase,
+    generation: u64,
+}
+
+#[derive(Default)]
+struct TerminalWaitGateState {
+    active: Option<TerminalWaitGateSnapshot>,
+    generation: u64,
+}
+
+#[derive(Default)]
+struct TerminalWaitGate {
+    state: StdMutex<TerminalWaitGateState>,
+}
+
+impl TerminalWaitGate {
+    fn lock_state(&self) -> std::sync::MutexGuard<'_, TerminalWaitGateState> {
+        self.state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+    }
+
+    fn snapshot(&self) -> Option<TerminalWaitGateSnapshot> {
+        self.lock_state().active
+    }
+
+    fn ensure_terminal_available(&self) -> Result<(), UnifiedExecError> {
+        match self.snapshot() {
+            Some(active) => Err(UnifiedExecError::TerminalWaitActive {
+                process_id: active.process_id,
+                phase: active.phase.to_string(),
+            }),
+            None => Ok(()),
+        }
+    }
+
+    fn reserve(
+        self: &Arc<Self>,
+        process_id: i32,
+        poll_interval_ms: u64,
+    ) -> Result<TerminalWaitOperationGuard, UnifiedExecError> {
+        let mut state = self.lock_state();
+        if let Some(active) = state.active {
+            return Err(UnifiedExecError::TerminalWaitActive {
+                process_id: active.process_id,
+                phase: active.phase.to_string(),
+            });
+        }
+        state.generation = state.generation.wrapping_add(1).max(1);
+        let generation = state.generation;
+        state.active = Some(TerminalWaitGateSnapshot {
+            process_id,
+            poll_interval_ms,
+            phase: TerminalWaitPhase::PendingStart,
+            generation,
+        });
+        Ok(TerminalWaitOperationGuard {
+            gate: Arc::clone(self),
+            process_id,
+            generation,
+            drop_action: TerminalWaitDropAction::Release,
+            resolved: false,
+        })
+    }
+
+    fn begin_action(
+        self: &Arc<Self>,
+        action: TerminalWaitAction,
+        expected: Option<TerminalWaitGateSnapshot>,
+    ) -> Result<(TerminalWaitGateSnapshot, TerminalWaitOperationGuard), UnifiedExecError> {
+        let mut state = self.lock_state();
+        let Some(mut active) = state.active else {
+            return Err(UnifiedExecError::NoTerminalWaitDecision);
+        };
+        if expected.is_some_and(|expected| {
+            expected.process_id != active.process_id || expected.generation != active.generation
+        }) {
+            return Err(UnifiedExecError::TerminalWaitActive {
+                process_id: active.process_id,
+                phase: active.phase.to_string(),
+            });
+        }
+        if active.phase != TerminalWaitPhase::DecisionRequired {
+            return Err(UnifiedExecError::TerminalWaitDecisionUnavailable {
+                process_id: active.process_id,
+                phase: active.phase.to_string(),
+            });
+        }
+        active.phase = match action {
+            TerminalWaitAction::Continue => TerminalWaitPhase::Waiting,
+            TerminalWaitAction::Interrupt => TerminalWaitPhase::Interrupting,
+            TerminalWaitAction::Terminate => TerminalWaitPhase::Terminating,
+        };
+        state.active = Some(active);
+        Ok((
+            active,
+            TerminalWaitOperationGuard {
+                gate: Arc::clone(self),
+                process_id: active.process_id,
+                generation: active.generation,
+                drop_action: TerminalWaitDropAction::DecisionRequired,
+                resolved: false,
+            },
+        ))
+    }
+
+    fn set_phase(&self, process_id: i32, generation: u64, phase: TerminalWaitPhase) -> bool {
+        let mut state = self.lock_state();
+        if let Some(active) = state.active.as_mut()
+            && active.process_id == process_id
+            && active.generation == generation
+        {
+            active.phase = phase;
+            true
+        } else {
+            false
+        }
+    }
+
+    fn release(&self, process_id: i32, generation: u64) -> bool {
+        let mut state = self.lock_state();
+        if state.active.as_ref().is_some_and(|active| {
+            active.process_id == process_id && active.generation == generation
+        }) {
+            state.active = None;
+            true
+        } else {
+            false
+        }
+    }
+
+    fn clear(&self) {
+        self.lock_state().active = None;
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum TerminalWaitDropAction {
+    Release,
+    DecisionRequired,
+}
+
+struct TerminalWaitOperationGuard {
+    gate: Arc<TerminalWaitGate>,
+    process_id: i32,
+    generation: u64,
+    drop_action: TerminalWaitDropAction,
+    resolved: bool,
+}
+
+impl TerminalWaitOperationGuard {
+    fn generation(&self) -> u64 {
+        self.generation
+    }
+
+    fn mark_process_stored(&mut self) -> bool {
+        let stored =
+            self.gate
+                .set_phase(self.process_id, self.generation, TerminalWaitPhase::Waiting);
+        if stored {
+            self.drop_action = TerminalWaitDropAction::DecisionRequired;
+        }
+        stored
+    }
+
+    fn finish_decision_required(mut self) {
+        self.gate.set_phase(
+            self.process_id,
+            self.generation,
+            TerminalWaitPhase::DecisionRequired,
+        );
+        self.resolved = true;
+    }
+
+    fn finish_released(mut self) {
+        self.gate.release(self.process_id, self.generation);
+        self.resolved = true;
+    }
+}
+
+impl Drop for TerminalWaitOperationGuard {
+    fn drop(&mut self) {
+        if self.resolved {
+            return;
+        }
+        match self.drop_action {
+            TerminalWaitDropAction::Release => {
+                self.gate.release(self.process_id, self.generation);
+            }
+            TerminalWaitDropAction::DecisionRequired => {
+                self.gate.set_phase(
+                    self.process_id,
+                    self.generation,
+                    TerminalWaitPhase::DecisionRequired,
+                );
+            }
+        }
+    }
+}
+
+impl TerminalWaitRules {
+    fn compile(config: Option<TerminalWaitToml>) -> Self {
+        let Some(config) = config else {
+            return Self::default();
+        };
+
+        let commands = config
+            .commands
+            .into_iter()
+            .filter(|command| command.enabled)
+            .map(|command| {
+                Arc::new(TerminalWaitCommandRule {
+                    pattern: Regex::new(&command.pattern)
+                        .expect("terminal_wait pattern should be validated during config load"),
+                    cwd_pattern: command.cwd_pattern.map(|pattern| {
+                        Regex::new(&pattern).expect(
+                            "terminal_wait cwd_pattern should be validated during config load",
+                        )
+                    }),
+                    poll_interval_ms: command.poll_interval_ms,
+                    max_output_tokens: command.max_output_tokens,
+                })
+            })
+            .collect();
+
+        Self { commands }
+    }
+
+    fn matching_rule(
+        &self,
+        command: &str,
+        cwd: &str,
+        tty: bool,
+    ) -> Option<Arc<TerminalWaitCommandRule>> {
+        if tty {
+            return None;
+        }
+        self.commands.iter().find_map(|rule| {
+            if !rule.pattern.is_match(command) {
+                return None;
+            }
+            if let Some(cwd_pattern) = rule.cwd_pattern.as_ref()
+                && !cwd_pattern.is_match(cwd)
+            {
+                return None;
+            }
+            Some(Arc::clone(rule))
+        })
+    }
+}
