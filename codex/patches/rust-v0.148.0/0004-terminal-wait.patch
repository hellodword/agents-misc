+#[test]
+fn managed_terminal_output_reports_decision_and_available_actions() {
+    let output = ExecCommandToolOutput {
+        event_call_id: "call-managed".to_string(),
+        chunk_id: "managed".to_string(),
+        wall_time: std::time::Duration::from_secs(2),
+        raw_output: b"still running".to_vec(),
+        truncation_policy: TruncationPolicy::Tokens(10_000),
+        max_output_tokens: None,
+        process_id: Some(41),
+        exit_code: None,
+        original_token_count: Some(2),
+        output_omitted_bytes: None,
+        hook_command: Some("cargo test".to_string()),
+        terminal_wait: Some(TerminalWaitToolOutput {
+            state: TerminalWaitToolState::DecisionRequired,
+            poll_interval_ms: 2_000,
+        }),
+    };
+    let payload = ToolPayload::Function {
+        arguments: "{}".to_string(),
+    };
+
+    let text = output.response_text();
+    assert!(text.contains("Terminal wait state: decision_required"));
+    assert!(text.contains("Terminal wait poll interval: 2000 ms"));
+    assert!(text.contains("Available terminal wait actions: continue, interrupt, terminate"));
+    assert_eq!(
+        output.code_mode_result(&payload),
+        json!({
+            "chunk_id": "managed",
+            "wall_time_seconds": 2.0,
+            "session_id": 41,
+            "original_token_count": 2,
+            "terminal_wait_state": "decision_required",
+            "poll_interval_ms": 2_000,
+            "available_actions": ["continue", "interrupt", "terminate"],
+            "output": "still running",
+        })
+    );
+}
