+#[test]
+fn terminal_wait_gate_rejects_a_rebound_compatibility_target() {
+    let gate = Arc::new(TerminalWaitGate::default());
+    let mut first_reservation = gate
+        .reserve(/*process_id*/ 41, /*poll_interval_ms*/ 2_000)
+        .expect("first managed command should reserve the gate");
+    assert!(first_reservation.mark_process_stored());
+    first_reservation.finish_decision_required();
+    let first = gate.snapshot().expect("first decision should be active");
+
+    let (_, first_control) = gate
+        .begin_action(TerminalWaitAction::Terminate, Some(first))
+        .expect("first decision should accept terminate");
+    first_control.finish_released();
+
+    let mut rebound_reservation = gate
+        .reserve(/*process_id*/ 41, /*poll_interval_ms*/ 2_000)
+        .expect("rebound command should reserve the released process id");
+    assert!(rebound_reservation.mark_process_stored());
+    rebound_reservation.finish_decision_required();
+    let rebound = gate.snapshot().expect("rebound decision should be active");
+
+    assert_ne!(first.generation, rebound.generation);
+    assert!(matches!(
+        gate.begin_action(TerminalWaitAction::Continue, Some(first)),
+        Err(UnifiedExecError::TerminalWaitActive { process_id: 41, .. })
+    ));
+    assert!(!gate.release(first.process_id, first.generation));
+    assert_eq!(gate.snapshot(), Some(rebound));
