+async fn code_mode_terminal_wait_control_terminates_the_implicit_process() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+
+    let server = responses::start_mock_server().await;
+    let (_test, second_mock) = run_code_mode_turn_with_config(
+        &server,
+        "stop a matching nested exec at its decision point",
+        r#"// @exec: {"yield_time_ms": 20}
+const first = await tools.exec_command({
+  cmd: "sleep 30",
+  yield_time_ms: 1
+});
+const stopped = await tools.terminal_wait_control({ action: "terminate" });
+text(JSON.stringify({
+  firstState: first.terminal_wait_state,
+  firstActions: first.available_actions,
+  stoppedState: stopped.terminal_wait_state,
+  stoppedPollInterval: stopped.poll_interval_ms,
+  stoppedHasActions: "available_actions" in stopped,
+}));
+"#,
+        |config| {
+            config.terminal_wait = Some(TerminalWaitToml {
+                commands: vec![TerminalWaitCommandToml {
+                    pattern: "^sleep ".to_string(),
+                    poll_interval_ms: 50,
+                    name: Some("slow nested exec".to_string()),
+                    enabled: true,
+                    cwd_pattern: None,
+                    max_output_tokens: None,
+                }],
+            });
+        },
+    )
+    .await?;
+
+    let items = custom_tool_output_items(&second_mock.single_request(), "call-1");
+    assert!(
+        text_item(&items, 0).starts_with("Script completed\n"),
+        "terminal wait control should remain inside the active code-mode call: {items:?}"
+    );
+    let result: Value = serde_json::from_str(text_item(&items, 1))?;
+    assert_eq!(
+        result,
+        serde_json::json!({
+            "firstState": "decision_required",
+            "firstActions": ["continue", "interrupt", "terminate"],
+            "stoppedState": "terminated",
+            "stoppedPollInterval": 50,
+            "stoppedHasActions": false,
+        })
+    );
+
+    Ok(())
+}
