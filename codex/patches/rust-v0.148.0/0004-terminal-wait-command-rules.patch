+#[cfg(unix)]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn terminal_wait_actions_consume_a_process_that_exited_after_the_decision()
+-> anyhow::Result<()> {
+    skip_if_sandbox!(Ok(()));
+
+    let manager = terminal_wait_manager(
+        r#"
+        [terminal_wait]
+
+        [[terminal_wait.commands]]
+        pattern = "^sleep "
+        poll_interval_ms = 20
+        "#,
+    );
+    let (session, turn, rx_event) = crate::session::tests::make_session_and_context_with_rx().await;
+
+    for (action, action_name) in [
+        (TerminalWaitAction::Continue, "continue"),
+        (TerminalWaitAction::Interrupt, "interrupt"),
+        (TerminalWaitAction::Terminate, "terminate"),
+    ] {
+        let call_id = format!("call-terminal-wait-{action_name}");
+        let final_output = format!("FINAL_{action_name}");
+        let hook_command = format!("sleep 0.5; printf {final_output}");
+        let process_id = manager.allocate_process_id().await;
+        let context =
+            UnifiedExecContext::new(Arc::clone(&session), Arc::clone(&turn), call_id.clone());
+        let first = manager
+            .exec_command(
+                ExecCommandRequest {
+                    command: vec!["sh".to_string(), "-lc".to_string(), hook_command.clone()],
+                    shell_type: crate::shell::ShellType::Sh,
+                    hook_command: hook_command.clone(),
+                    process_id,
+                    yield_time_ms: 1,
+                    max_output_tokens: None,
+                    #[allow(deprecated)]
+                    cwd: turn.cwd.clone().into(),
+                    #[allow(deprecated)]
+                    sandbox_cwd: turn.cwd.clone().into(),
+                    turn_environment: turn
+                        .environments
+                        .primary()
+                        .cloned()
+                        .expect("primary environment"),
+                    shell_mode: codex_tools::UnifiedExecShellMode::Direct,
+                    network: None,
+                    tty: false,
+                    sandbox_permissions: crate::sandboxing::SandboxPermissions::RequireEscalated,
+                    additional_permissions: None,
+                    additional_permissions_preapproved: true,
+                    justification: None,
+                    prefix_rule: None,
+                },
+                &context,
+            )
+            .await?;
+
+        assert_eq!(first.process_id, Some(process_id));
+        assert_eq!(
+            first.terminal_wait.as_ref().map(|wait| wait.state),
+            Some(TerminalWaitToolState::DecisionRequired)
+        );
+
+        tokio::time::timeout(Duration::from_secs(3), async {
+            loop {
+                let event = rx_event
+                    .recv()
+                    .await
+                    .expect("event channel should stay open");
+                if let codex_protocol::protocol::EventMsg::ItemCompleted(completed) = event.msg
+                    && let codex_protocol::items::TurnItem::CommandExecution(item) = completed.item
+                    && item.id == call_id
+                {
+                    break;
+                }
+            }
+        })
+        .await
+        .expect("natural process exit should emit ItemCompleted");
+
+        assert_eq!(
+            manager
+                .terminal_wait_gate
+                .snapshot()
+                .map(|active| { (active.process_id, active.phase, active.poll_interval_ms,) }),
+            Some((process_id, TerminalWaitPhase::DecisionRequired, 20,)),
+            "natural exit must retain the implicit target until {action_name} consumes it"
+        );
+
+        let truncation_policy = codex_utils_output_truncation::TruncationPolicy::Tokens(10_000);
+        let interaction_event = Some(WriteStdinInteractionEvent {
+            session: &session,
+            turn: &turn,
+        });
+        let completed = if action == TerminalWaitAction::Interrupt {
+            manager
+                .write_stdin(WriteStdinRequest {
+                    process_id,
+                    input: INTERRUPT,
+                    yield_time_ms: 1,
+                    max_output_tokens: None,
+                    truncation_policy,
+                    interaction_event,
+                    code_mode_cell_id: None,
+                    code_mode_tool_call_id: None,
+                })
+                .await?
+        } else {
+            manager
+                .terminal_wait_control(TerminalWaitControlRequest {
+                    action,
+                    truncation_policy,
+                    interaction_event,
+                    code_mode_cell_id: None,
+                    code_mode_tool_call_id: None,
+                })
+                .await?
+        };
+
+        assert_eq!(completed.process_id, None);
+        assert_eq!(completed.exit_code, Some(0));
+        assert_eq!(completed.event_call_id, call_id);
+        assert_eq!(
+            completed.hook_command.as_deref(),
+            Some(hook_command.as_str())
+        );
+        assert_eq!(
+            completed.terminal_wait.as_ref().map(|wait| wait.state),
+            Some(TerminalWaitToolState::Completed)
+        );
+        assert_eq!(
+            completed.truncated_output(crate::unified_exec::DEFAULT_MAX_OUTPUT_TOKENS),
+            final_output
+        );
+        if action == TerminalWaitAction::Interrupt {
+            let interaction = tokio::time::timeout(Duration::from_secs(1), async {
+                loop {
+                    let event = rx_event
+                        .recv()
+                        .await
+                        .expect("event channel should stay open");
+                    if let codex_protocol::protocol::EventMsg::TerminalInteraction(interaction) =
+                        event.msg
+                    {
+                        break interaction;
+                    }
+                }
+            })
+            .await
+            .expect("compatibility interrupt should emit TerminalInteraction");
+            assert_eq!(interaction.call_id, call_id);
+            assert_eq!(interaction.process_id, process_id.to_string());
+            assert_eq!(interaction.stdin, INTERRUPT);
+        }
+        assert_eq!(manager.terminal_wait_gate.snapshot(), None);
+        assert!(
+            !manager
+                .process_store
+                .lock()
+                .await
+                .processes
+                .contains_key(&process_id)
+        );
+    }
+
+    Ok(())
+}
