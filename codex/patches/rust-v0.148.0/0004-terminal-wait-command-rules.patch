+#[tokio::test]
+async fn stale_terminal_start_does_not_release_a_rebound_reservation() {
+    let manager = UnifiedExecProcessManager::default();
+    let first = manager
+        .terminal_wait_gate
+        .reserve(/*process_id*/ 41, /*poll_interval_ms*/ 2_000)
+        .expect("first managed command should reserve the gate");
+    let first_generation = first.generation();
+    manager.terminal_wait_gate.clear();
+    drop(first);
+
+    let rebound = manager
+        .terminal_wait_gate
+        .reserve(/*process_id*/ 41, /*poll_interval_ms*/ 2_000)
+        .expect("rebound managed command should reserve the gate");
+    let rebound_snapshot = manager
+        .terminal_wait_gate
+        .snapshot()
+        .expect("rebound reservation should be active");
+    manager
+        .process_store
+        .lock()
+        .await
+        .reserved_process_ids
+        .insert(41);
+
+    manager
+        .release_process_id_for_start(41, Some(first_generation))
+        .await;
+
+    assert!(
+        manager
+            .process_store
+            .lock()
+            .await
+            .reserved_process_ids
+            .contains(&41)
+    );
+    assert_eq!(
+        manager.terminal_wait_gate.snapshot(),
+        Some(rebound_snapshot)
+    );
+    drop(rebound);
+}
