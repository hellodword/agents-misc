+/// Execute every selected handler directly with a fixed concurrency bound.
+///
+/// Notification events use this path even for handlers configured as async:
+/// the notification itself is already detached from the model flow, and
+/// awaiting the handler here is what makes the per-event concurrency limit
+/// authoritative.
+pub(crate) async fn execute_handlers_bounded<T: 'static>(
+    engine: &ClaudeHooksEngine,
+    handlers: Vec<ConfiguredHandler>,
+    input_json: String,
+    cwd: &Path,
+    turn_id: Option<String>,
+    max_concurrency: usize,
+    group_timeout: Option<Duration>,
+    parse: fn(&ConfiguredHandler, HandlerRunResult, Option<String>) -> ParsedHandler<T>,
+) -> Vec<BoundedHandlerResult<T>> {
+    assert!(max_concurrency > 0, "handler concurrency must be non-zero");
+
+    let configured_handlers = handlers.clone();
+    let mut remaining = handlers.into_iter().enumerate();
+    let mut pending = FuturesUnordered::new();
+    let mut completed = std::iter::repeat_with(|| None)
+        .take(configured_handlers.len())
+        .collect::<Vec<_>>();
+    let mut completion_order = 0;
+    let deadline = group_timeout.map(|duration| tokio::time::Instant::now() + duration);
+    let mut group_timed_out = false;
+
+    loop {
+        while pending.len() < max_concurrency {
+            let Some((configured_order, handler)) = remaining.next() else {
+                break;
+            };
+            let input_json = input_json.clone();
+            let turn_id = turn_id.clone();
+            pending.push(async move {
+                let result = match &handler.kind {
+                    ConfiguredHandlerKind::Command { command, env, .. } => {
+                        run_command(
+                            &engine.command_runtime,
+                            &handler,
+                            command,
+                            env,
+                            &input_json,
+                            cwd,
+                        )
+                        .await
+                    }
+                    ConfiguredHandlerKind::McpTool {
+                        server,
+                        tool,
+                        input,
+                    } => {
+                        let executor = engine.mcp_executor.as_deref()?;
+                        run_mcp_tool(executor, &handler, server, tool, input, &input_json).await
+                    }
+                };
+                Some((configured_order, parse(&handler, result, turn_id)))
+            });
+        }
+
+        let next = match deadline {
+            Some(deadline) => match tokio::time::timeout_at(deadline, pending.next()).await {
+                Ok(result) => result,
+                Err(_) => {
+                    group_timed_out = true;
+                    break;
+                }
+            },
+            None => pending.next().await,
+        };
+        let Some(result) = next else {
+            break;
+        };
+        let Some((configured_order, mut parsed)) = result else {
+            continue;
+        };
+        parsed.completion_order = completion_order;
+        completion_order += 1;
+        completed[configured_order] = Some(parsed);
+    }
+
+    configured_handlers
+        .into_iter()
+        .enumerate()
+        .filter_map(|(configured_order, handler)| {
+            if let Some(parsed) = completed[configured_order].take() {
+                Some(BoundedHandlerResult::Completed(parsed))
+            } else if group_timed_out {
+                Some(BoundedHandlerResult::GroupTimedOut(handler))
+            } else {
+                None
+            }
+        })
+        .collect()
+}
