+fn codex_error_kind(error: &CodexErr) -> String {
+    let kind = match error.details() {
+        CodexErrorDetails::TurnAborted => "TurnAborted",
+        CodexErrorDetails::SessionBudgetExceeded => "SessionBudgetExceeded",
+        CodexErrorDetails::Stream(..) => "Stream",
+        CodexErrorDetails::ContextWindowExceeded => "ContextWindowExceeded",
+        CodexErrorDetails::ThreadNotFound(_) => "ThreadNotFound",
+        CodexErrorDetails::AgentLimitReached { .. } => "AgentLimitReached",
+        CodexErrorDetails::SessionConfiguredNotFirstEvent => "SessionConfiguredNotFirstEvent",
+        CodexErrorDetails::Timeout => "Timeout",
+        CodexErrorDetails::RequestTimeout => "RequestTimeout",
+        CodexErrorDetails::Spawn => "Spawn",
+        CodexErrorDetails::Interrupted => "Interrupted",
+        CodexErrorDetails::UnexpectedStatus(_) => "UnexpectedStatus",
+        CodexErrorDetails::InvalidRequest(_) => "InvalidRequest",
+        CodexErrorDetails::InvalidImageRequest() => "InvalidImageRequest",
+        CodexErrorDetails::UsageLimitReached(_) => "UsageLimitReached",
+        CodexErrorDetails::ServerOverloaded => "ServerOverloaded",
+        CodexErrorDetails::CyberPolicy { .. } => "CyberPolicy",
+        CodexErrorDetails::MisalignmentPolicyViolation { .. } => "MisalignmentPolicyViolation",
+        CodexErrorDetails::ResponseStreamFailed(_) => "ResponseStreamFailed",
+        CodexErrorDetails::ConnectionFailed(_) => "ConnectionFailed",
+        CodexErrorDetails::QuotaExceeded => "QuotaExceeded",
+        CodexErrorDetails::UsageNotIncluded => "UsageNotIncluded",
+        CodexErrorDetails::InternalServerError => "InternalServerError",
+        CodexErrorDetails::RetryLimit(_) => "RetryLimit",
+        CodexErrorDetails::InternalAgentDied => "InternalAgentDied",
+        CodexErrorDetails::Sandbox(_) => "Sandbox",
+        CodexErrorDetails::LandlockSandboxExecutableNotProvided => {
+            "LandlockSandboxExecutableNotProvided"
+        }
+        CodexErrorDetails::UnsupportedOperation(_) => "UnsupportedOperation",
+        CodexErrorDetails::RefreshTokenFailed(_) => "RefreshTokenFailed",
+        CodexErrorDetails::Fatal(_) => "Fatal",
+        CodexErrorDetails::Io(_) => "Io",
+        CodexErrorDetails::Json(_) => "Json",
+        #[cfg(target_os = "linux")]
+        CodexErrorDetails::LandlockRuleset(_) => "LandlockRuleset",
+        #[cfg(target_os = "linux")]
+        CodexErrorDetails::LandlockPathFd(_) => "LandlockPathFd",
+        CodexErrorDetails::TokioJoin(_) => "TokioJoin",
+        CodexErrorDetails::EnvVar(_) => "EnvVar",
+        CodexErrorDetails::ToolCollision(_) => "ToolCollision",
+    };
+    kind.to_string()
+}
