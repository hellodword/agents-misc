+    struct BlockingMcpExecutor {
+        started: Notify,
+        release: Notify,
+        released: AtomicBool,
+        attempts: Mutex<Vec<u64>>,
+    }
+
+    impl BlockingMcpExecutor {
+        fn unblock(&self) {
+            self.released.store(true, Ordering::Release);
+            self.release.notify_waiters();
+        }
+    }
+
+    impl HookMcpExecutor for BlockingMcpExecutor {
+        fn execute(&self, call: HookMcpCall) -> BoxFuture<'_, anyhow::Result<String>> {
+            async move {
+                let attempt = call
+                    .input
+                    .get("attempt")
+                    .and_then(Value::as_u64)
+                    .expect("expanded attempt");
+                self.attempts.lock().expect("lock attempts").push(attempt);
+                self.started.notify_one();
+                while !self.released.load(Ordering::Acquire) {
+                    self.release.notified().await;
+                }
+                Ok(String::new())
+            }
+            .boxed()
+        }
+    }
+
+    fn cwd() -> AbsolutePathBuf {
+        AbsolutePathBuf::current_dir().expect("current dir")
+    }
+
+    fn engine(executor: Arc<dyn HookMcpExecutor>) -> ClaudeHooksEngine {
+        let (result_sender, _result_receiver) = async_channel::unbounded();
+        let mut engine = ClaudeHooksEngine::new(
+            /*enabled*/ true,
+            /*bypass_hook_trust*/ false,
+            /*config_layer_stack*/ None,
+            Vec::new(),
+            Vec::new(),
+            CommandHookRuntime::new(
+                CommandShell {
+                    program: String::new(),
+                    args: Vec::new(),
+                },
+                ThreadId::new(),
+                result_sender,
+            ),
+            Some(executor),
+        );
+        engine.handlers = vec![ConfiguredHandler {
+            event_name: HookEventName::RequestError,
+            matcher: None,
+            timeout_sec: 60,
+            status_message: None,
+            additional_context_limit: Default::default(),
+            source_path: cwd().join("request-error.json"),
+            source: HookSource::User,
+            display_order: 0,
+            kind: ConfiguredHandlerKind::McpTool {
+                server: "test".to_string(),
+                tool: "record".to_string(),
+                input: Map::from_iter([(
+                    "attempt".to_string(),
+                    Value::String("${attempt}".to_string()),
+                )]),
+            },
+        }];
+        engine
+    }
+
+    fn request(attempt: u64) -> RequestErrorRequest {
+        RequestErrorRequest {
+            session_id: ThreadId::new(),
+            turn_id: format!("turn-{attempt}"),
+            transcript_path: None,
+            cwd: cwd(),
+            model: "gpt-test".to_string(),
+            provider: "openai".to_string(),
+            operation: ModelRequestOperation::Sampling,
+            endpoint_path: "/responses".to_string(),
+            attempt,
+            next_action: ModelRequestNextAction::Retry,
+            error: ModelRequestError {
+                category: ModelRequestErrorCategory::Transport,
+                message: "disconnected".to_string(),
+            },
+        }
+    }
+
+    #[tokio::test]
+    async fn request_error_dispatcher_preserves_fifo_order() {
+        let executor = Arc::new(BlockingMcpExecutor {
+            started: Notify::new(),
+            release: Notify::new(),
+            released: AtomicBool::new(false),
+            attempts: Mutex::new(Vec::new()),
+        });
+        let engine = engine(executor.clone());
+        let dispatcher = RequestErrorDispatcher::new();
+        let mut receivers = Vec::new();
+
+        for attempt in 0..4 {
+            match dispatcher.enqueue(engine.clone(), request(attempt)) {
+                RequestErrorDispatch::Queued(receiver) => receivers.push(receiver),
+                RequestErrorDispatch::Rejected(_) => panic!("queue unexpectedly rejected"),
+            }
+        }
+        executor.started.notified().await;
+        executor.unblock();
+        for receiver in receivers {
+            receiver.await.expect("queue worker outcome");
+        }
+
+        assert_eq!(
+            *executor.attempts.lock().expect("lock attempts"),
+            vec![0, 1, 2, 3]
+        );
+    }
+
+    #[tokio::test]
+    async fn request_error_dispatcher_rejects_overflow_without_waiting() {
+        let executor = Arc::new(BlockingMcpExecutor {
+            started: Notify::new(),
+            release: Notify::new(),
+            released: AtomicBool::new(false),
+            attempts: Mutex::new(Vec::new()),
+        });
+        let engine = engine(executor.clone());
+        let dispatcher = RequestErrorDispatcher::new();
+
+        let first = match dispatcher.enqueue(engine.clone(), request(0)) {
+            RequestErrorDispatch::Queued(receiver) => receiver,
+            RequestErrorDispatch::Rejected(_) => panic!("first event rejected"),
+        };
+        executor.started.notified().await;
+
+        let mut queued = Vec::new();
+        for attempt in 1..=REQUEST_ERROR_QUEUE_CAPACITY as u64 {
+            match dispatcher.enqueue(engine.clone(), request(attempt)) {
+                RequestErrorDispatch::Queued(receiver) => queued.push(receiver),
+                RequestErrorDispatch::Rejected(_) => panic!("queue rejected before capacity"),
+            }
+        }
+        let rejected =
+            match dispatcher.enqueue(engine, request(REQUEST_ERROR_QUEUE_CAPACITY as u64 + 1)) {
+                RequestErrorDispatch::Queued(_) => panic!("overflow event was queued"),
+                RequestErrorDispatch::Rejected(outcome) => outcome,
+            };
+        assert_eq!(rejected.hook_events.len(), 1);
+        assert_eq!(rejected.hook_events[0].run.status, HookRunStatus::Failed);
+        assert!(
+            rejected.hook_events[0].run.entries[0]
+                .text
+                .contains("capacity 64")
+        );
+
+        executor.unblock();
+        first.await.expect("first queue outcome");
+        for receiver in queued {
+            receiver.await.expect("queued outcome");
+        }
+        assert_eq!(
+            executor.attempts.lock().expect("lock attempts").len(),
+            REQUEST_ERROR_QUEUE_CAPACITY + 1
+        );
+    }
+}
