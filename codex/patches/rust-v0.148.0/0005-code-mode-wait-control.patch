+#[cfg_attr(windows, ignore = "no exec_command on Windows")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn code_mode_terminal_wait_outlives_outer_timer_yield() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+
+    let server = responses::start_mock_server().await;
+    let (_test, second_mock) = run_code_mode_turn_with_config(
+        &server,
+        "wait for matching nested exec",
+        r#"// @exec: {"yield_time_ms": 50}
+const result = await tools.exec_command({
+  cmd: "sleep 0.1; printf done",
+  yield_time_ms: 1
+});
+text(result.output);
+"#,
+        |config| {
+            config.terminal_wait = Some(TerminalWaitToml {
+                commands: vec![TerminalWaitCommandToml {
+                    pattern: "^sleep ".to_string(),
+                    poll_interval_ms: 200,
+                    name: Some("slow nested exec".to_string()),
+                    enabled: true,
+                    cwd_pattern: None,
+                    max_output_tokens: None,
+                }],
+            });
+        },
+    )
+    .await?;
+
+    let items = custom_tool_output_items(&second_mock.single_request(), "call-1");
+    assert!(
+        text_item(&items, 0).starts_with("Script completed\n"),
+        "matching terminal_wait rule should suppress the outer timer yield: {items:?}"
+    );
+    assert_eq!(text_item(&items, 1), "done");
+
+    Ok(())
+}
